---
// Mes contributions — rang, barème des points et activité récente (C20)
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import PointsDashboard from '@/components/PointsDashboard.tsx'
import PageHero from '@/components/PageHero.astro'
import { getLocale, t } from '@/lib/i18n'

const locale = getLocale(Astro.cookies?.get('bayen_locale')?.value ?? null)
---

<Layout
  title={`${t('points.title', locale)} — Bayen`}
  description="Vos points, votre rang et le détail de vos contributions à la base Bayen."
  path="/compte/points"
  noindex={true}
  mobileTopbar={false}
>
  <PageHero tone="citron" mascot="bravo" back="/compte" kicker={t('nav.community', locale)} title={t('points.title', locale)} subtitle="Chaque contribution rend la base plus fiable pour tout le monde." />
  <main class="screen max-md:pt-5">
    <PointsDashboard client:load />
  </main>
</Layout>

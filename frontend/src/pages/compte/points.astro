---
// Mes contributions — rang, barème des points et activité récente (C20)
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import PointsDashboard from '@/components/PointsDashboard.tsx'
import PageHero from '@/components/PageHero.astro'
import { getLocale, t } from '@/lib/i18n'

const locale = getLocale(Astro.cookies?.get('bayen_locale')?.value ?? null)
---

<Layout
  title={`${t('points.title', locale)} — Bayen`}
  description="Vos points, votre rang et le détail de vos contributions à la base Bayen."
  path="/compte/points"
  noindex={true}
>
  <main class="container mx-auto max-w-screen-lg px-4 py-6 pb-24">
    <div class="mx-auto max-w-lg">
      <PageHero image="/hero/classement.jpg" tone="citron" mascot="bravo" kicker={t('nav.community', locale)} title={t('points.title', locale)} subtitle="Chaque contribution rend la base plus fiable pour tout le monde." class="mb-6" />

      <PointsDashboard client:load />
    </div>
  </main>
</Layout>

---
// Demandes de partenariat — réception dans le compte admin du site.
// Le serveur refuse les comptes non administrateurs : la page peut donc
// être servie telle quelle, elle n'expose rien.
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import PartnerRequestsAdmin from '@/components/PartnerRequestsAdmin.tsx'
import PageHero from '@/components/PageHero.astro'
---

<Layout
  title="Demandes de partenariat — Bayen"
  description="Réception des demandes de partenariat envoyées via bayen.ma/partenaires."
  path="/compte/partenariats"
  noindex={true}
  mobileTopbar={false}
>
  <PageHero
    tone="myrtille"
    back="/compte"
    kicker="Équipe Bayen"
    title="Demandes de partenariat"
    subtitle="Historique des demandes envoyées depuis la page Partenaires. Les nouvelles demandes arrivent désormais dans nBot (boîte Formulaires)."
  />
  <main class="screen max-md:pt-5">
    <PartnerRequestsAdmin client:load />
  </main>
</Layout>

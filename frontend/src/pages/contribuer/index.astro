---
// Page contribuer — ajouter un produit
export const prerender = false
import Layout from '@/layouts/Layout.astro'
import ContributeWizard from '@/components/ContributeWizard.tsx'
import PageHero from '@/components/PageHero.astro'
import { getLocale, t } from '@/lib/i18n'

const localeCookie = Astro.cookies?.get('bayen_locale')?.value ?? null
const locale = getLocale(localeCookie)

// Récupérer le barcode depuis l'URL si présent (?barcode=xxx)
const barcode = Astro.url.searchParams.get('barcode') ?? ''
---

<Layout
  title={`${t('contribute.title', locale)} — Bayen`}
  description={t('contribute.subtitle', locale)}
  path="/contribuer"
>
  <main class="container mx-auto max-w-screen-lg px-4 py-6 pb-24">
    <PageHero image="/hero/contribuer.jpg" kicker={t('nav.contribute', locale)} title={t('contribute.title', locale)} subtitle={t('contribute.subtitle', locale)} class="mb-8">
      <svg slot="icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
    </PageHero>
    <div class="max-w-lg mx-auto">
      <ContributeWizard initialBarcode={barcode} client:load />
    </div>
  </main>
</Layout>

---
// Page contribuer — ajouter un produit
export const prerender = false
import Layout from '@/layouts/Layout.astro'
import ContributeWizard from '@/components/ContributeWizard.tsx'
import PageHero from '@/components/PageHero.astro'
import AsidePhoto from '@/components/AsidePhoto.astro'
import { getLocale, t } from '@/lib/i18n'

const localeCookie = Astro.cookies?.get('bayen_locale')?.value ?? null
const locale = getLocale(localeCookie)

// Récupérer le barcode depuis l'URL si présent (?barcode=xxx)
const barcode = Astro.url.searchParams.get('barcode') ?? ''
---

<Layout
  title={`${t('contribute.title', locale)} — Bayen`}
  description={t('contribute.subtitle', locale)}
  path="/contribuer"
  mobileTopbar={false}
>
  <PageHero tone="citron" mascot="bravo" kicker={t('nav.contribute', locale)} title={t('contribute.title', locale)} subtitle={t('contribute.subtitle', locale)}>
    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
  </PageHero>

  <main class="screen pt-5 md:pt-10">
    <!-- Assistant : une colonne de lecture ; sur ordinateur, la fiche complète qu'il produit, à côté -->
    <section class="section md:grid-cols-[minmax(0,600px)_minmax(0,1fr)] md:items-start md:gap-10">
      <div class="min-w-0"><ContributeWizard initialBarcode={barcode} client:load /></div>
      <AsidePhoto src="/visuels/fiche-tablette.webp" alt={t('visual.fiche', locale)} ratio="5 / 4" />
    </section>
  </main>
</Layout>

---
// Page contribuer — corriger / compléter un produit existant (SSR)
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import ContributeForm from '@/components/ContributeForm.tsx'
import ContributeWizard from '@/components/ContributeWizard.tsx'
import PageHero from '@/components/PageHero.astro'
import { getLocale, t } from '@/lib/i18n'

const { barcode } = Astro.params
const locale = getLocale(Astro.cookies?.get('bayen_locale')?.value ?? null)

const DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL ?? 'https://api.bayen.ma'

// Récupérer le produit existant depuis Directus (s'il existe)
let existingProduct: Record<string, unknown> | null = null

try {
  const res = await fetch(
    `${DIRECTUS_URL}/items/products?filter[barcode][_eq]=${barcode}&filter[status][_eq]=published&limit=1&fields=*`
  )
  if (res.ok) {
    const data = await res.json()
    const products = data.data ?? []
    if (products.length > 0) {
      existingProduct = products[0]
    }
  }
} catch {
  // Silencieux — le formulaire fonctionnera en mode création
}
// Correction d'une fiche alimentaire existante (formulaire) ; sinon assistant de création
const isFix = existingProduct !== null && existingProduct.product_type !== 'cosmetic'
---

<Layout
  title={existingProduct ? `Corriger — ${barcode} — Bayen` : `Ajouter le produit ${barcode} — Bayen`}
  description={existingProduct
    ? `Corriger ou compléter les informations du produit ${barcode} sur Bayen.`
    : `Ajouter le produit ${barcode} à la base Bayen en quelques photos.`}
  path={`/contribuer/${barcode}`}
  noindex={true}
  mobileTopbar={false}
>
  <PageHero
    tone="citron"
    mascot="bravo"
    back={existingProduct ? `/produit/${barcode}` : '/'}
    kicker={t('nav.contribute', locale)}
    title={isFix ? t('contribute.editTitle', locale) : t('contribute.title', locale)}
    subtitle={isFix ? `${t('contribute.editSubtitle', locale)} ${barcode}` : t('contribute.subtitle', locale)}
  >
    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
  </PageHero>

  <main class="screen pt-5 md:pt-10">
    <section class="section w-full md:mx-auto md:max-w-[640px]">
      {existingProduct && existingProduct.product_type === 'cosmetic' ? (
        /* Fiche beauté existante : le wizard sait lire la liste INCI, l'ancien
           formulaire ne connaît que la nutrition */
        <ContributeWizard initialBarcode={barcode} initialUniverse="cosmetic" client:load />
      ) : existingProduct ? (
        <ContributeForm initialBarcode={barcode} existingProduct={existingProduct} client:load />
      ) : (
        /* Produit absent de la base : parcours guidé de création (C19) */
        <ContributeWizard initialBarcode={barcode} client:load />
      )}
    </section>
  </main>
</Layout>

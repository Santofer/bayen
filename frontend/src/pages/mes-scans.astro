---
// Page « Mes scans » — historique local (localStorage), sans compte.
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import ScanHistory from '@/components/ScanHistory.tsx'
import PageHero from '@/components/PageHero.astro'
import { getLocale, t } from '@/lib/i18n'

const locale = getLocale(Astro.cookies?.get('bayen_locale')?.value ?? null)
---

<Layout
  title="Mes scans — Bayen"
  description="Retrouve tous les produits que tu as scannés. Gratuit, sans compte, stocké uniquement sur ton appareil."
  path="/mes-scans"
  noindex={true}
  mobileTopbar={false}
>
  <PageHero tone="citron" mascot="courses" back="/compte" kicker={t('history.badge', locale)} title={t('history.title', locale)} subtitle={t('history.subtitle', locale)} />
  <main class="screen max-md:pt-5">
    <section class="section">
      <ScanHistory client:load />
    </section>
  </main>
</Layout>

---
// Page « Mes scans » — historique local (localStorage), sans compte.
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import ScanHistory from '@/components/ScanHistory.tsx'
import PageHero from '@/components/PageHero.astro'
import { getLocale, t } from '@/lib/i18n'

const locale = getLocale(Astro.cookies?.get('bayen_locale')?.value ?? null)
---

<Layout
  title="Mes scans — Bayen"
  description="Retrouve tous les produits que tu as scannés. Gratuit, sans compte, stocké uniquement sur ton appareil."
  path="/mes-scans"
  noindex={true}
>
  <main class="section-v2 py-6 pb-24 md:pb-12">
    <PageHero image="/hero/scan.jpg" tone="citron" mascot="courses" kicker={t('history.badge', locale)} title={t('history.title', locale)} subtitle={t('history.subtitle', locale)} class="mb-8" />

    <ScanHistory client:load />
  </main>
</Layout>

---
// Page Partenaires — marques, producteurs, distributeurs (SSR léger)
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import PageHero from '@/components/PageHero.astro'
import { getLocale, t } from '@/lib/i18n'

const localeCookie = Astro.cookies?.get('bayen_locale')?.value ?? null
const locale = getLocale(localeCookie)

// Les demandes partent vers nBot (boîte « Formulaires », tri IA des prospects) :
// voir @/lib/nbot-leads. L'ancien endpoint /bayen-api/partner-request et la
// collection partner_requests restent en place pour l'historique.

// Champ de formulaire : contour encre, fond crème (dans la carte)
const field = 'min-h-[52px] w-full rounded-2xl border-2 border-line bg-background px-4 text-[15px] font-medium outline-none focus:border-brand-ink'

const args = [
  {
    title: 'Une audience engagée',
    desc: 'Des milliers de Marocains scannent chaque semaine pour mieux choisir. Vos produits bien notés gagnent en visibilité.',
    path: 'M22 7 13.5 15.5 8.5 10.5 2 17 M16 7h6v6',
    color: 'citron',
  },
  {
    title: 'Vos données, correctes',
    desc: 'Corrigez ou complétez la fiche de vos produits : nutrition, ingrédients, photos officielles.',
    path: 'M20 6 9 17l-5-5',
    color: 'menthe',
  },
  {
    title: 'Valorisez vos efforts',
    desc: 'Reformulation, réduction du sucre, retrait d’additifs : le score déterministe récompense les vrais progrès.',
    path: 'M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z',
    color: 'framboise',
  },
]
---

<Layout
  title="Partenaires — Bayen"
  description="Marques, producteurs et distributeurs : rejoignez Bayen pour valoriser vos produits et améliorer vos données nutritionnelles."
  path="/partenaires"
  mobileTopbar={false}
>
  <PageHero
    tone="myrtille"
    mascot="salut"
    kicker={t('nav.partners', locale)}
    title="Marques & producteurs, rejoignez Bayen"
    subtitle="Bayen est une initiative citoyenne de transparence alimentaire au Maroc. Valorisez vos produits, corrigez vos données et touchez une communauté qui veut mieux manger."
  >
    <a href="#partner-form" class="btn dark-btn">Parlons de votre marque</a>
  </PageHero>

  <main class="screen pt-5 md:pt-10">
    <!-- Arguments : cartes colorées (comme les cartes univers de l'accueil) -->
    <section class="section">
      <div class="grid gap-3 md:grid-cols-3 md:gap-[18px]">
        {args.map((a) => (
          <div class="card grid content-start gap-6 p-[18px] text-encre md:gap-10 md:p-[22px]" style={`background: var(--color-${a.color})`}>
            <span class="u-ico">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={a.path} /></svg>
            </span>
            <span class="grid gap-1.5">
              <b class="disp d-s md:text-xl">{a.title}</b>
              <span class="text-[14px] leading-relaxed">{a.desc}</span>
            </span>
          </div>
        ))}
      </div>
    </section>

    <!-- Formulaire -->
    <section class="section md:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] md:items-start md:gap-x-12">
      <div class="grid content-start gap-4">
        <h2 class="disp d-m md:text-[26px]">Parlons de votre marque</h2>
        <div class="naanaa">
          <img src="/mascotte/naanaa-salut.webp" alt="" width="72" height="72" loading="lazy" />
          <p class="bubble">Remplissez ce formulaire, notre équipe revient vers vous sous 48 h.</p>
        </div>
      </div>

      <form id="partner-form" class="card grid gap-4 p-4 md:p-6">
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="grid gap-1.5" for="pf-company">
            <span class="text-[13.5px] font-bold">Entreprise / marque</span>
            <input id="pf-company" name="societe" required class={field} placeholder="Ex : Jaouda" />
          </label>
          <label class="grid gap-1.5" for="pf-role">
            <span class="text-[13.5px] font-bold">Vous êtes</span>
            <select id="pf-role" name="profil" class={field}>
              <option>Marque / fabricant</option>
              <option>Producteur</option>
              <option>Distributeur</option>
              <option>Autre</option>
            </select>
          </label>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="grid gap-1.5" for="pf-name">
            <span class="text-[13.5px] font-bold">Nom complet</span>
            <input id="pf-name" name="name" required class={field} placeholder="Votre nom" />
          </label>
          <label class="grid gap-1.5" for="pf-email">
            <span class="text-[13.5px] font-bold">Email professionnel</span>
            <input id="pf-email" name="email" type="email" required class={field} placeholder="vous@marque.ma" />
          </label>
        </div>
        <label class="grid gap-1.5" for="pf-msg">
          <span class="text-[13.5px] font-bold">Votre message</span>
          <textarea id="pf-msg" name="message" rows="4" class={`${field} py-3`} placeholder="Parlez-nous de vos produits et de votre besoin…"></textarea>
        </label>
        <!-- Honeypot anti-bots : invisible pour un humain -->
        <div aria-hidden="true" style="position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden">
          <label for="pf-gotcha">Ne pas remplir</label>
          <input id="pf-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit" class="btn primary w-full">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" /></svg>
          Envoyer
        </button>
        <p id="pf-status" class="hidden text-center text-sm"></p>
      </form>
    </section>
  </main>

  <script>
    import { sendLead } from '@/lib/nbot-leads'

    const form = document.getElementById('partner-form') as HTMLFormElement | null
    const status = document.getElementById('pf-status')
    // Anti-bot nBot : un envoi en moins de 3 s après l'affichage est ignoré.
    const startedAt = Date.now()
    form?.addEventListener('submit', async (e) => {
      e.preventDefault()
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')
      const show = (msg: string, ok: boolean) => {
        if (!status) return
        status.textContent = msg
        status.className = 'text-sm text-center ' + (ok ? 'text-brand-ink' : 'text-destructive')
      }
      if (btn) btn.disabled = true
      const error = await sendLead({
        ...Object.fromEntries(new FormData(form).entries()),
        form: 'contact',
        formName: 'Demande de partenariat — marques & producteurs',
        startedAt,
      })
      if (btn) btn.disabled = false
      if (error) {
        show(error, false)
        return
      }
      form.reset()
      show('Merci ! Votre demande a bien été envoyée. Nous revenons vers vous sous 48 h.', true)
    })
  </script>
</Layout>

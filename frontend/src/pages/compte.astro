---
// Page compte utilisateur — protégée par AuthGuard
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import AuthGuard from '@/components/AuthGuard'
import AccountDashboard from '@/components/AccountDashboard'
import PageHero from '@/components/PageHero.astro'
import { getLocale, t } from '@/lib/i18n'

const locale = getLocale(Astro.cookies?.get('bayen_locale')?.value ?? null)
---

<Layout title="Mon compte — Bayen" noindex={true}>
  <main class="container mx-auto max-w-screen-lg px-4 py-6 pb-24">
    <AuthGuard client:load redirectPath="/compte">
      <PageHero image="/hero/journal.jpg" tone="ai" mascot="astuce" kicker={t('nav.account', locale)} title="Mon compte" class="mb-8" />
      <AccountDashboard client:load />
    </AuthGuard>
  </main>
</Layout>

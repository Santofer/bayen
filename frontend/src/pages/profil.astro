---
// Page « Mon profil santé » — préférences locales (localStorage), sans compte.
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import HealthProfileEditor from '@/components/HealthProfileEditor.tsx'
import { getLocale, t } from '@/lib/i18n'

const locale = getLocale(Astro.cookies?.get('bayen_locale')?.value ?? null)
---

<Layout
  title="Mon profil santé — Bayen"
  description="Déclare les allergènes et additifs que tu évites : Bayen t'alerte automatiquement quand un produit scanné en contient. Gratuit, sans compte, 100% privé."
  path="/profil"
>
  <main class="mx-auto px-4 py-6 pb-24 md:pb-12" style="max-width: 760px">
    <header class="mb-6">
      <span
        class="inline-block rounded-full bg-primary px-3 py-1.5 font-extrabold uppercase text-primary-foreground"
        style="font-size: 0.7rem; letter-spacing: 0.06em"
      >
        {t('profile.badge', locale)}
      </span>
      <h1 class="font-display text-foreground mt-3" style="font-size: clamp(1.8rem, 3.4vw, 2.4rem); line-height: 1.08; font-weight: 780;">
        {t('profile.title', locale)}
      </h1>
      <p class="text-muted-foreground mt-2 leading-relaxed">
        {t('profile.subtitle', locale)}
      </p>
    </header>

    <HealthProfileEditor client:load />
  </main>
</Layout>

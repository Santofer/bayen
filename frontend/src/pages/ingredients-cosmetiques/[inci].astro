---
// Fiche ingrédient cosmétique (C23) — l'INCI sert d'identifiant d'URL (motif bandeau Beauté)
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import PageHero from '@/components/PageHero.astro'
import ProductCard from '@/components/ProductCard.tsx'
import { getLocale, t } from '@/lib/i18n'
import type { Product } from '@/lib/types'

const locale = getLocale(Astro.cookies?.get('bayen_locale')?.value ?? null)
const DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL ?? 'https://api.bayen.ma'
const inci = decodeURIComponent(Astro.params.inci ?? '').toUpperCase().trim().slice(0, 200)

interface Ingredient {
  id: number; inci_name: string; name_fr: string | null; synonyms: string[] | null; cas_number: string | null
  functions: string[] | null; risk_level: string; risk_types: string[] | null; risk_status: string | null
  restriction_fr: string | null; source_label: string | null; source_url: string | null; note_fr: string | null
}
let ingredient: Ingredient | null = null
let products: Product[] = []
// Directus injoignable : 503 ; INCI absent du référentiel : 404
let directusDown = false

try {
  const res = await fetch(`${DIRECTUS_URL}/items/cosmetic_ingredients?filter[inci_name][_eq]=${encodeURIComponent(inci)}&limit=1`, { signal: AbortSignal.timeout(5000) })
  if (!res.ok) throw new Error(`cosmetic_ingredients ${res.status}`)
  ingredient = ((await res.json()).data ?? [])[0] ?? null
  if (ingredient) {
    const pr = await fetch(
      `${DIRECTUS_URL}/items/products_cosmetic_ingredients?filter[ingredient_id][_eq]=${ingredient.id}&filter[products_id][status][_eq]=published&fields=rank,products_id.id,products_id.barcode,products_id.name_fr,products_id.brand,products_id.quantity,products_id.image_front,products_id.scan_score,products_id.score_label,products_id.product_type,products_id.cosmetic_risk,products_id.scan_count&limit=60&sort=-products_id.scan_count`,
      { signal: AbortSignal.timeout(5000) }
    )
    if (pr.ok) {
      // Une ligne par produit (un INCI peut apparaître deux fois dans une liste)
      const seen = new Set<string>()
      for (const r of ((await pr.json()).data ?? []) as Array<{ products_id: Product | null }>) {
        const p = r.products_id
        if (p?.barcode && !seen.has(p.barcode)) { seen.add(p.barcode); products.push(p) }
      }
    }
  }
} catch {
  directusDown = true
}

if (directusDown) {
  Astro.response.status = 503
  Astro.response.headers.set('Retry-After', '300')
} else if (!ingredient) {
  Astro.response.status = 404
}

// Aplats Marché Pop (même échelle que InciList), texte encre posé dessus
const LEVEL_FILL: Record<string, string> = {
  banned: 'fill bg-score-mauvais',
  high: 'fill bg-score-mauvais',
  moderate: 'fill bg-score-mediocre',
  low: 'fill bg-citron',
  none: 'fill bg-score-excellent',
  unknown: 'bg-muted text-muted-foreground',
}
const levelKey = (l: string) => (['banned', 'high', 'moderate', 'low', 'none'].includes(l) ? `beauty.risk.${l}` : 'beauty.risk.unknown') as Parameters<typeof t>[0]
const typeKey = (ty: string) => (['cmr', 'allergen', 'irritant', 'environment', 'restricted'].includes(ty) ? `beauty.type.${ty}` as Parameters<typeof t>[0] : null)
const qualified = ingredient?.risk_status === 'suspected' || ingredient?.risk_status === 'confirmed'
const statusLabel = qualified ? t(`beauty.status.${ingredient!.risk_status}` as Parameters<typeof t>[0], locale) : ''
// Règle C23 : « perturbateur endocrinien » seulement qualifié (suspecté / avéré) ET sourcé
const typeLabels = (ingredient?.risk_types ?? []).flatMap((ty) => {
  if (ty === 'endocrine') return qualified && ingredient?.source_url ? [`${t('beauty.type.endocrine', locale)} ${statusLabel}`] : []
  const k = typeKey(ty)
  return k ? [t(k, locale)] : []
})
const risky = ingredient ? !['none', 'unknown'].includes(ingredient.risk_level) : false
const title = ingredient ? `${ingredient.inci_name}${ingredient.name_fr ? ` (${ingredient.name_fr})` : ''} — ${t(levelKey(ingredient.risk_level), locale)} | Bayen` : `Ingrédient ${inci} — Bayen`
const description = ingredient
  ? (ingredient.note_fr ?? `${ingredient.inci_name} : ingrédient cosmétique, niveau de risque ${t(levelKey(ingredient.risk_level), locale).toLowerCase()}${ingredient.restriction_fr ? `. ${ingredient.restriction_fr}` : ''}`).slice(0, 160)
  : `Ingrédient cosmétique ${inci} introuvable dans le référentiel Bayen.`
---

<Layout title={title} description={description} path={`/ingredients-cosmetiques/${encodeURIComponent(inci)}`} noindex={!ingredient || !risky} universe="beauty" mobileTopbar={false}>
  <PageHero
    tone="beauty"
    back="/ingredients-cosmetiques"
    kicker={t('nav.inci', locale)}
    title={ingredient?.inci_name ?? inci}
    subtitle={ingredient ? (ingredient.name_fr ?? undefined) : directusDown ? t('seo.serviceDown', locale) : t('search.noResults', locale)}
    class="[&_h1]:[overflow-wrap:anywhere]"
  >
    {ingredient && (
      <div class="chips">
        <span class:list={['chip', LEVEL_FILL[ingredient.risk_level] ?? LEVEL_FILL.unknown]}>
          {t(levelKey(ingredient.risk_level), locale)}{statusLabel && ` · ${statusLabel}`}
        </span>
        {typeLabels.map((l) => <span class="chip">{l}</span>)}
      </div>
    )}
  </PageHero>

  <main class="screen max-md:pt-5">
    {!ingredient ? (
      <section class="section">
        <div class="naanaa grid-cols-[56px_minmax(0,1fr)]">
          <div class="m size-14"><img src="/mascotte/naanaa-oups.webp" alt="" width="56" height="56" /></div>
          <p class="bubble">{t('search.noResults', locale)}</p>
        </div>
        <a href="/ingredients-cosmetiques" class="btn w-max">{t('beauty.ingredientsTitle', locale)}</a>
      </section>
    ) : (
      <>
        {(ingredient.note_fr || ingredient.restriction_fr || ingredient.functions?.length || ingredient.synonyms?.length || ingredient.cas_number || ingredient.source_label) && (
          <section class="section">
            <div class="card grid gap-4 p-5 md:p-6">
              {ingredient.note_fr && <p class="text-[15px] leading-relaxed">{ingredient.note_fr}</p>}
              <dl class="grid gap-3 text-sm md:grid-cols-2">
                {ingredient.restriction_fr && (
                  <div class="rounded-[14px] bg-muted p-3"><dt class="muted text-xs">{t('beauty.restriction', locale)}</dt><dd class="mt-0.5 font-medium">{ingredient.restriction_fr}</dd></div>
                )}
                {Array.isArray(ingredient.functions) && ingredient.functions.length > 0 && (
                  <div class="rounded-[14px] bg-muted p-3"><dt class="muted text-xs">{t('beauty.functions', locale)}</dt><dd class="mt-0.5 font-medium">{ingredient.functions.join(', ')}</dd></div>
                )}
                {Array.isArray(ingredient.synonyms) && ingredient.synonyms.length > 0 && (
                  <div class="rounded-[14px] bg-muted p-3"><dt class="muted text-xs">{t('beauty.synonyms', locale)}</dt><dd class="mt-0.5 font-medium">{ingredient.synonyms.join(', ')}</dd></div>
                )}
                {ingredient.cas_number && (
                  <div class="rounded-[14px] bg-muted p-3"><dt class="muted text-xs">CAS</dt><dd class="mt-0.5 font-mono text-xs">{ingredient.cas_number}</dd></div>
                )}
                {ingredient.source_label && (
                  <div class="rounded-[14px] bg-muted p-3 md:col-span-2"><dt class="muted text-xs">{t('beauty.source', locale)}</dt>
                    <dd class="mt-0.5 font-medium">
                      {ingredient.source_url ? <a href={ingredient.source_url} rel="noopener nofollow" target="_blank" class="underline underline-offset-2">{ingredient.source_label} ↗</a> : ingredient.source_label}
                    </dd>
                  </div>
                )}
              </dl>
            </div>
          </section>
        )}

        <section class="section">
          <div class="sec-head">
            <h2 class="disp d-m [overflow-wrap:anywhere]">{t('beauty.productsWith', locale)} {ingredient.inci_name}</h2>
            <span class="muted flex-none text-xs">{products.length} {t('search.results', locale)}</span>
          </div>
          {products.length === 0 ? (
            <p class="card p-6 text-center text-sm muted">{t('search.noResults', locale)}</p>
          ) : (
            <div class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4">
              {products.map((product) => <ProductCard product={product} variant="grid" locale={locale} />)}
            </div>
          )}
        </section>

        <section class="section">
          <p class="muted text-xs">{t('beauty.disclaimer', locale)}</p>
          <a href="/ingredients-cosmetiques" class="btn sm w-max">{t('beauty.ingredientsTitle', locale)}</a>
        </section>
      </>
    )}
  </main>
</Layout>

---
// Fiche ingrédient cosmétique (C23) — l'INCI sert d'identifiant d'URL
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import ProductCard from '@/components/ProductCard.tsx'
import { getLocale, t } from '@/lib/i18n'

const locale = getLocale(Astro.cookies?.get('bayen_locale')?.value ?? null)
const DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL ?? 'https://api.bayen.ma'
const inci = decodeURIComponent(Astro.params.inci ?? '').toUpperCase().trim().slice(0, 200)

interface Ingredient {
  id: number; inci_name: string; name_fr: string | null; synonyms: string[] | null; cas_number: string | null
  functions: string[] | null; risk_level: string; risk_types: string[] | null; risk_status: string | null
  restriction_fr: string | null; source_label: string | null; source_url: string | null; note_fr: string | null
}
let ingredient: Ingredient | null = null
let products: Record<string, unknown>[] = []

try {
  const res = await fetch(`${DIRECTUS_URL}/items/cosmetic_ingredients?filter[inci_name][_eq]=${encodeURIComponent(inci)}&limit=1`, { signal: AbortSignal.timeout(5000) })
  if (res.ok) ingredient = ((await res.json()).data ?? [])[0] ?? null
  if (ingredient) {
    const pr = await fetch(
      `${DIRECTUS_URL}/items/products_cosmetic_ingredients?filter[ingredient_id][_eq]=${ingredient.id}&filter[products_id][status][_eq]=published&fields=rank,products_id.id,products_id.barcode,products_id.name_fr,products_id.brand,products_id.quantity,products_id.image_front,products_id.scan_score,products_id.score_label,products_id.product_type,products_id.cosmetic_risk,products_id.scan_count&limit=60&sort=-products_id.scan_count`,
      { signal: AbortSignal.timeout(5000) }
    )
    if (pr.ok) {
      const seen = new Set<string>()
      products = ((await pr.json()).data ?? [])
        .map((r: Record<string, unknown>) => r.products_id as Record<string, unknown> | null)
        .filter((p: Record<string, unknown> | null): p is Record<string, unknown> => Boolean(p && p.barcode) && !seen.has(String(p!.barcode)) && Boolean(seen.add(String(p!.barcode))))
    }
  }
} catch { /* fiche introuvable */ }

const LEVEL_STYLE: Record<string, string> = {
  banned: 'bg-red-100 text-red-800 dark:bg-red-950/40 dark:text-red-200',
  high: 'bg-red-50 text-red-700 dark:bg-red-950/30 dark:text-red-300',
  moderate: 'bg-orange-50 text-orange-700 dark:bg-orange-950/30 dark:text-orange-300',
  low: 'bg-lime-50 text-lime-800 dark:bg-lime-950/30 dark:text-lime-200',
  none: 'bg-muted text-foreground',
  unknown: 'bg-muted text-muted-foreground',
}
const levelKey = (l: string) => (['banned', 'high', 'moderate', 'low', 'none'].includes(l) ? `beauty.risk.${l}` : 'beauty.risk.unknown') as Parameters<typeof t>[0]
const typeKey = (ty: string) => (['endocrine', 'cmr', 'allergen', 'irritant', 'environment', 'restricted'].includes(ty) ? `beauty.type.${ty}` as Parameters<typeof t>[0] : null)
const risky = ingredient ? !['none', 'unknown'].includes(ingredient.risk_level) : false
const title = ingredient ? `${ingredient.inci_name}${ingredient.name_fr ? ` (${ingredient.name_fr})` : ''} — ${t(levelKey(ingredient.risk_level), locale)} | Bayen` : `Ingrédient ${inci} — Bayen`
const description = ingredient
  ? (ingredient.note_fr ?? `${ingredient.inci_name} : ingrédient cosmétique, niveau de risque ${t(levelKey(ingredient.risk_level), locale).toLowerCase()}${ingredient.restriction_fr ? `. ${ingredient.restriction_fr}` : ''}`).slice(0, 160)
  : `Ingrédient cosmétique ${inci} introuvable dans le référentiel Bayen.`
---

<Layout title={title} description={description} path={`/ingredients-cosmetiques/${encodeURIComponent(inci)}`} noindex={!ingredient || !risky}>
  <main class="container mx-auto max-w-screen-lg px-4 py-6 pb-24">
    {!ingredient ? (
      <div class="text-center py-12">
        <p class="text-muted-foreground">{t('search.noResults', locale)}</p>
        <a href="/ingredients-cosmetiques" class="text-primary hover:underline text-sm mt-2 inline-block">← {t('beauty.ingredientsTitle', locale)}</a>
      </div>
    ) : (
      <div class="space-y-6">
        <div class="rounded-3xl border bg-card p-5 sm:p-6 shadow-card">
          <div class="flex flex-wrap items-start gap-3">
            <div class="min-w-0 flex-1">
              <h1 class="font-display text-2xl font-bold break-words">{ingredient.inci_name}</h1>
              {ingredient.name_fr && <p class="text-lg text-muted-foreground">{ingredient.name_fr}</p>}
            </div>
            <span class:list={['flex-shrink-0 rounded-full px-3 py-1 text-sm font-bold', LEVEL_STYLE[ingredient.risk_level] ?? LEVEL_STYLE.unknown]}>
              {t(levelKey(ingredient.risk_level), locale)}
              {ingredient.risk_status && (ingredient.risk_status === 'suspected' || ingredient.risk_status === 'confirmed') && ` · ${t(`beauty.status.${ingredient.risk_status}` as Parameters<typeof t>[0], locale)}`}
            </span>
          </div>
          {Array.isArray(ingredient.risk_types) && ingredient.risk_types.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-1.5">
              {ingredient.risk_types.map((ty) => { const k = typeKey(ty); return <span class="rounded-full border px-2.5 py-0.5 text-xs font-semibold">{k ? t(k, locale) : ty}</span> })}
            </div>
          )}
          {ingredient.note_fr && <p class="mt-4 text-[15px] leading-relaxed">{ingredient.note_fr}</p>}
          <dl class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
            {ingredient.restriction_fr && (
              <div class="rounded-xl bg-muted/50 p-3"><dt class="text-xs text-muted-foreground">{t('beauty.restriction', locale)}</dt><dd class="mt-0.5 font-medium">{ingredient.restriction_fr}</dd></div>
            )}
            {Array.isArray(ingredient.functions) && ingredient.functions.length > 0 && (
              <div class="rounded-xl bg-muted/50 p-3"><dt class="text-xs text-muted-foreground">{t('beauty.functions', locale)}</dt><dd class="mt-0.5 font-medium">{ingredient.functions.join(', ')}</dd></div>
            )}
            {Array.isArray(ingredient.synonyms) && ingredient.synonyms.length > 0 && (
              <div class="rounded-xl bg-muted/50 p-3"><dt class="text-xs text-muted-foreground">{t('beauty.synonyms', locale)}</dt><dd class="mt-0.5 font-medium">{ingredient.synonyms.join(', ')}</dd></div>
            )}
            {ingredient.cas_number && (
              <div class="rounded-xl bg-muted/50 p-3"><dt class="text-xs text-muted-foreground">CAS</dt><dd class="mt-0.5 font-mono text-xs">{ingredient.cas_number}</dd></div>
            )}
            {ingredient.source_label && (
              <div class="rounded-xl bg-muted/50 p-3 sm:col-span-2"><dt class="text-xs text-muted-foreground">{t('beauty.source', locale)}</dt>
                <dd class="mt-0.5 font-medium">
                  {ingredient.source_url ? <a href={ingredient.source_url} rel="noopener nofollow" target="_blank" class="text-primary hover:underline">{ingredient.source_label} ↗</a> : ingredient.source_label}
                </dd>
              </div>
            )}
          </dl>
        </div>

        <div>
          <div class="sec-head-v2">
            <h2>{t('beauty.productsWith', locale)} {ingredient.inci_name}</h2>
            <span class="text-sm text-muted-foreground">{products.length} {t('search.results', locale)}</span>
          </div>
          {products.length === 0 ? (
            <div class="rounded-xl border bg-card p-8 text-center text-sm text-muted-foreground">
              {t('search.noResults', locale)}
            </div>
          ) : (
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
              {products.map((product) => <ProductCard product={product as any} variant="grid" />)}
            </div>
          )}
        </div>

        <p class="text-xs text-muted-foreground">{t('beauty.disclaimer', locale)}</p>
        <div class="text-center">
          <a href="/ingredients-cosmetiques" class="text-sm text-muted-foreground hover:text-primary">← {t('beauty.ingredientsTitle', locale)}</a>
        </div>
      </div>
    )}
  </main>
</Layout>

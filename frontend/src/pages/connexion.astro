---
// Page de connexion / inscription — card centrée maquette v2
export const prerender = false
import Layout from '@/layouts/Layout.astro'
import AuthForm from '@/components/AuthForm'
import { getLocale, t } from '@/lib/i18n'

const locale = getLocale(Astro.cookies?.get('bayen_locale')?.value ?? null)
---

<Layout title="Connexion — Bayen" path="/connexion" noindex={true}>
  <main class="flex flex-col items-center px-4 py-8 sm:py-12 pb-24">
    {/* Naânaa accueille (pose « salut ») au-dessus de la carte */}
    <img src="/mascotte/naanaa-salut.webp" alt="" width="96" height="141" class="naanaa-bob relative z-10 -mb-4" />
    <div class="w-full max-w-[440px] rounded-[28px] border-2 border-line bg-card px-[30px] py-[34px] shadow-[var(--shadow-lift)]">
      <a href="/" class="flex justify-center mb-5" aria-label="Bayen — accueil">
        <img src="/logo-wordmark.svg" alt="Bayen" class="brand-logo on-light" style="height: 38px" />
        <img src="/logo-wordmark-light.svg" alt="Bayen" class="brand-logo on-dark" style="height: 38px" />
      </a>
      <h1 class="text-center text-[1.7rem] font-bold leading-tight">{t('login.welcome', locale)}</h1>
      <p class="text-center text-sm text-muted-foreground mt-1.5 mb-6">
        {t('login.subtitle', locale)}
      </p>

      <AuthForm client:load />
    </div>
  </main>
</Layout>

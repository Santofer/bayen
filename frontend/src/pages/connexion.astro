---
// Connexion / inscription — bandeau du compte (figue) + carte formulaire
export const prerender = false
import Layout from '@/layouts/Layout.astro'
import AuthForm from '@/components/AuthForm'
import PageHero from '@/components/PageHero.astro'
import { getLocale, t } from '@/lib/i18n'

const locale = getLocale(Astro.cookies?.get('bayen_locale')?.value ?? null)
---

<Layout title="Connexion — Bayen" path="/connexion" noindex={true} mobileTopbar={false}>
  <PageHero tone="ai" mascot="salut" back="/compte" kicker={t('nav.account', locale)} title={t('login.welcome', locale)} subtitle={t('login.subtitle', locale)} />
  <main class="screen max-md:pt-5">
    <section class="section">
      <div class="card w-full p-5 md:max-w-[480px] md:p-7">
        <AuthForm client:load />
      </div>
    </section>
  </main>
</Layout>

---
// Page fiche produit (SSR) — query Directus puis fallback Open Food Facts
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import ScoreDisplay, { ratioFill } from '@/components/ScoreDisplay.tsx'
import EstimateWithAI from '@/components/EstimateWithAI.tsx'
import { productTint } from '@/components/ProductCard.tsx'
import ProductActions from '@/components/ProductActions.tsx'
import EnrichFromOff from '@/components/EnrichFromOff.tsx'
import ProfileAlert from '@/components/ProfileAlert.tsx'
import HealthAnalysis, { nutrientLevel, LEVEL_COLOR, type NutrientLevel } from '@/components/HealthAnalysis.tsx'
import IngredientsList from '@/components/IngredientsList.tsx'
import ProductAlternatives from '@/components/ProductAlternatives.tsx'
import ShareButton from '@/components/ShareButton.tsx'
import HalalBadge from '@/components/HalalBadge.tsx'
import halalLogo from '@/assets/halal-logo.svg?raw'
import PriceSection from '@/components/PriceSection.tsx'
import CosmeticScore, { cosmeticFill, type InciIngredient } from '@/components/CosmeticScore.tsx'
import InciList from '@/components/InciList.tsx'
import AddToCartButton from '@/components/AddToCartButton.tsx'
import { RISK_FILL, RISK_LABEL_KEYS } from '@/components/AdditiveTag.tsx'
import { computeScore, computeNutriScore, type RiskLevel, type NutritionData, type AdditiveResult } from '@/lib/scoring'
import { scoreFill, scoreLevel } from '@/lib/score-colors'
import { barcodeSvg, barcodeGroups } from '@/lib/barcode'
import { getLocale, t } from '@/lib/i18n'
import { isIndexableProduct, firstBrand } from '@/lib/indexable'
import { getPriceAggregate, type PriceAggregate } from '@/lib/directus'

const localeCookie = Astro.cookies?.get('bayen_locale')?.value ?? null
const locale = getLocale(localeCookie)

const { barcode } = Astro.params

// Code-barres impossible (lettres, longueur) : vraie 404, sans interroger Directus, OFF ni OBF
if (!/^\d{8,14}$/.test(String(barcode ?? ''))) return Astro.rewrite('/404')

const DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL ?? 'https://api.bayen.ma'
const CDN_URL = import.meta.env.PUBLIC_CDN_URL ?? 'https://api.bayen.ma/assets'
// Code-barres généré localement (EAN-13/EAN-8), plus de service tiers ni de chargement différé
const barcodeBars = barcodeSvg(String(barcode ?? ''))
const barcodeDigits = barcodeGroups(String(barcode ?? ''))
const barcodeKind = String(barcode ?? '').replace(/\D/g, '').length === 8 ? 'EAN-8' : 'EAN-13'

let scanResult: {
  found: boolean
  source?: string
  product?: Record<string, unknown>
  score?: Record<string, unknown>
  message?: string
  contribute_url?: string
} = { found: false }

let fetchError: string | null = null
// Directus injoignable : réponse 503 (jamais un 200 vide ni une 404 qu'un robot retiendrait)
let directusDown = false

// Univers beauté (C23) : ingrédients INCI appariés (jointure) pour la fiche cosmétique
let cosmeticIngredients: InciIngredient[] = []
async function loadCosmeticIngredients(productId: string): Promise<InciIngredient[]> {
  try {
    const res = await fetch(
      `${DIRECTUS_URL}/items/products_cosmetic_ingredients?filter[products_id][_eq]=${productId}&fields=rank,raw_text,ingredient_id.id,ingredient_id.inci_name,ingredient_id.name_fr,ingredient_id.risk_level,ingredient_id.risk_types,ingredient_id.risk_status,ingredient_id.restriction_fr,ingredient_id.note_fr,ingredient_id.source_label,ingredient_id.source_url&sort=rank&limit=-1`,
      { signal: AbortSignal.timeout(4000) }
    )
    if (!res.ok) return []
    const data = await res.json()
    return (data.data ?? [])
      .filter((r: Record<string, unknown>) => r.ingredient_id && typeof r.ingredient_id === 'object')
      .map((r: Record<string, unknown>) => {
        const i = r.ingredient_id as Record<string, unknown>
        return {
          id: i.id as number,
          inci_name: String(i.inci_name),
          name_fr: (i.name_fr as string | null) ?? null,
          risk_level: String(i.risk_level ?? 'unknown'),
          risk_types: Array.isArray(i.risk_types) ? (i.risk_types as string[]) : [],
          risk_status: (i.risk_status as string | null) ?? null,
          restriction_fr: (i.restriction_fr as string | null) ?? null,
          note_fr: (i.note_fr as string | null) ?? null,
          source_label: (i.source_label as string | null) ?? null,
          source_url: (i.source_url as string | null) ?? null,
          rank: Number(r.rank ?? 0),
          raw_text: (r.raw_text as string | null) ?? null,
        }
      })
  } catch {
    return []
  }
}

// Additifs : niveau de risque (score) + nom et fonction (carte « Additifs » de la fiche)
interface AdditiveInfo { id: string; risk_level: RiskLevel; name_fr: string | null; name_ar: string | null; function: string | null; function_ar: string | null }
let additiveInfo = new Map<string, AdditiveInfo>()
async function loadAdditiveRisks(codes: string[]): Promise<Array<{ code: string; risk_level: RiskLevel }>> {
  if (codes.length === 0) return []
  try {
    const addRes = await fetch(
      `${DIRECTUS_URL}/items/additives?filter[id][_in]=${codes.join(',')}&fields=id,risk_level,name_fr,name_ar,function,function_ar&limit=-1`
    )
    if (addRes.ok) {
      const rows: AdditiveInfo[] = (await addRes.json()).data ?? []
      additiveInfo = new Map(rows.map((a) => [a.id, a]))
    }
  } catch { /* repli ci-dessous */ }
  // Additif inconnu de la base (ou API muette) : « limité » par défaut, comme avant
  return codes.map((code) => ({ code, risk_level: additiveInfo.get(code)?.risk_level ?? 'limited' }))
}

// 1. Chercher dans Directus (isolé — un échec ici ne bloque pas le fallback OFF)
try {
  const directusRes = await fetch(
    `${DIRECTUS_URL}/items/products?filter[barcode][_eq]=${barcode}&filter[status][_eq]=published&limit=1&fields=*,category_id.id,category_id.name_fr,category_id.slug`
  )
  //`directus:${directusRes.status} `

  if (directusRes.ok) {
    const directusData = await directusRes.json()
    const products = directusData.data ?? []

    if (products.length > 0) {
      const p = products[0]

      // Toujours calculer le score complet (pour avoir additives_detail)
      let scoreObj: Record<string, unknown>
      if (p.product_type === 'cosmetic') {
        // Univers beauté : le score vient de cosmetic_risk (déterministe, côté API)
        scoreObj = (p.cosmetic_risk as Record<string, unknown> | null)
          ?? { total: null, label: null, unscored: true, incomplete: true }
        cosmeticIngredients = await loadCosmeticIngredients(p.id as string)
      } else {
        const additiveCodes: string[] = Array.isArray(p.additives) ? p.additives : []
        const additiveRisks = await loadAdditiveRisks(additiveCodes)

        const catId = typeof p.category_id === 'object' && p.category_id ? (p.category_id as Record<string, unknown>).id as number : p.category_id as number | null
        const scoreResult = computeScore({
          nutrition: {
            energy_kcal: p.energy_kcal,
            fat_saturated: p.fat_saturated,
            sugars: p.sugars,
            salt: p.salt,
            fiber: p.fiber,
            proteins: p.proteins,
          },
          novaGroup: p.nova_group as 1 | 2 | 3 | 4 | null,
          ingredientsText: p.ingredients_text,
          additives: additiveRisks,
          categoryId: catId,
        })
        scoreObj = scoreResult as unknown as Record<string, unknown>
      }

      // Extraire la catégorie si c'est un objet imbriqué
      const categoryObj = typeof p.category_id === 'object' && p.category_id ? p.category_id as Record<string, unknown> : null
      if (categoryObj) {
        p.category_name = categoryObj.name_fr
        p.category_slug = categoryObj.slug
        p.category_id = categoryObj.id
      }

      // Récupérer les ingrédients structurés (M2M)
      let structuredIngredients: Array<Record<string, unknown>> = []
      try {
        const piRes = await fetch(
          `${DIRECTUS_URL}/items/products_ingredients?filter[products_id][_eq]=${p.id}&fields=ingredients_id.id,ingredients_id.name_fr,ingredients_id.name_ar,ingredients_id.icon,ingredients_id.category,ingredients_id.is_allergen,ingredients_id.allergen_type,percent,rank&sort=rank&limit=-1`
        )
        if (piRes.ok) {
          const piData = await piRes.json()
          structuredIngredients = (piData.data ?? []).map((pi: Record<string, unknown>) => ({
            ...(pi.ingredients_id as Record<string, unknown>),
            percent: pi.percent,
            rank: pi.rank,
          }))
        }
      } catch { /* pas grave, fallback texte */ }

      // Si produit OFF sans image locale, récupérer l'image depuis OFF
      if (!p.image_front && p.data_source === 'off') {
        try {
          const offImgRes = await fetch(
            `https://world.openfoodfacts.org/api/v2/product/${barcode}.json?fields=image_front_url,image_front_small_url`,
            { signal: AbortSignal.timeout(3000) }
          )
          if (offImgRes.ok) {
            const offImgData = await offImgRes.json()
            if (offImgData.status === 1 && offImgData.product?.image_front_url) {
              p.image_front = offImgData.product.image_front_url
            }
          }
        } catch { /* non bloquant */ }
      }

      scanResult = {
        found: true,
        source: 'directus',
        product: { ...p, structured_ingredients: structuredIngredients },
        score: scoreObj,
      }
    }
  } else {
    directusDown = true
  }
} catch {
  directusDown = true
}

// 2. Fallback Open Food Facts si non trouvé dans Directus
try {
  if (!scanResult.found) {
    const offUrl = `https://world.openfoodfacts.org/api/v2/product/${barcode}.json`
    //`fetching-off `
    const offRes = await fetch(offUrl)
    //`off:${offRes.status} `

    if (offRes.ok) {
      const offData = await offRes.json()
      // Cosmétique ou non-aliment rangé sur OFF : pas de vue alimentaire, l'étape 2b
      // (endpoint scan) crée la fiche beauté si le produit ressemble à un cosmétique
      const offTags: string[] = offData.product?.categories_tags ?? []
      const offNonFood = offData.status === 1 && offData.product && (
        (offData.product.product_type && offData.product.product_type !== 'food')
        || offTags.some((t: string) => /non-food|incorrect-product-type|cosmetic|beauty|hygiene|personal-care/i.test(t))
        || /lingette|wipes?|shampo|savon|soap|d[ée]odorant|dentifrice|toothpaste|cr[èe]me (solaire|hydratante|visage|mains|corps)|sunscreen|gel douche|shower|parfum|perfume|mascara|lipstick|micellaire|d[ée]maquillant/i.test(`${offData.product.product_name_fr ?? ''} ${offData.product.product_name ?? ''}`)
      )
      if (offData.status === 1 && offData.product && !offNonFood) {
        const p = offData.product

        // Extraire les codes additifs
        const additiveCodes: string[] = (p.additives_tags || [])
          .map((t: string) => { const m = t.match(/e(\d+[a-z]?)/i); return m ? `E${m[1].toUpperCase()}` : null; })
          .filter(Boolean)

        // Récupérer les risk_level depuis Directus (les additifs sont seedés)
        const additiveRisks = await loadAdditiveRisks(additiveCodes)

        // Données nutritionnelles
        const nutrition = {
          energy_kcal: p.nutriments?.['energy-kcal_100g'] ?? null,
          fat_saturated: p.nutriments?.['saturated-fat_100g'] ?? null,
          sugars: p.nutriments?.sugars_100g ?? null,
          salt: p.nutriments?.salt_100g ?? null,
          fiber: p.nutriments?.fiber_100g ?? null,
          proteins: p.nutriments?.proteins_100g ?? null,
        }

        // Ingrédients : prioriser le français
        const ingredientsFr = p.ingredients_text_fr
          || p.ingredients_text_with_allergens_fr
          || ''
        const ingredientsAny = p.ingredients_text || ''
        const ingredientsText = ingredientsFr || ingredientsAny
        const ingredientsLang = ingredientsFr ? 'fr' : (ingredientsAny ? 'other' : 'none')

        // Calculer le score Bayen
        const novaGroup = p.nova_group ?? null
        const scoreResult = computeScore({
          nutrition,
          novaGroup: novaGroup as 1 | 2 | 3 | 4 | null,
          ingredientsText,
          additives: additiveRisks,
        })

        scanResult = {
          found: true,
          source: 'open_food_facts',
          product: {
            barcode,
            name_fr: p.product_name_fr || p.product_name || 'Inconnu',
            brand: p.brands || 'Inconnu',
            nutriscore_grade: scoreResult.nutriscore_grade,
            nova_group: scoreResult.nova_group,
            energy_kcal: nutrition.energy_kcal,
            fat_total: p.nutriments?.fat_100g ?? null,
            fat_saturated: nutrition.fat_saturated,
            carbs_total: p.nutriments?.carbohydrates_100g ?? null,
            sugars: nutrition.sugars,
            proteins: nutrition.proteins,
            salt: nutrition.salt,
            fiber: nutrition.fiber,
            ingredients_text: ingredientsText,
            ingredients_lang: ingredientsLang,
            image_front: p.image_front_url || null,
            additives: additiveCodes,
            is_organic: !!(p.labels_tags || []).find((l: string) => l.includes('bio') || l.includes('organic')),
            is_halal: !!(p.labels_tags || []).find((l: string) => l.includes('halal')),
            scan_count: 0,
            confidence_score: scoreResult.incomplete ? 0.5 : 0.8,
          },
          score: scoreResult as unknown as Record<string, unknown>,
        }
      }
    }
  }
} catch (e: unknown) {
  //`off-err:${e instanceof Error ? e.message : String(e)} `
  fetchError = t('product.offUnreachable', locale)
}

// 2b. Open Beauty Facts — via /bayen-api/scan (import + score cosmétique déterministe).
//     L'endpoint essaie OFF puis OBF ; ici OFF a déjà échoué, seul OBF peut répondre.
if (!scanResult.found && !fetchError && !directusDown) {
  try {
    const scanRes = await fetch(`${DIRECTUS_URL}/bayen-api/scan`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ barcode, session_id: `auto-${Date.now()}`, track: false }),
      signal: AbortSignal.timeout(12000),
    })
    if (!scanRes.ok) directusDown = true
    if (scanRes.ok) {
      const scanData = await scanRes.json()
      if (scanData.found && scanData.product?.product_type === 'cosmetic') {
        const sp = scanData.product as Record<string, unknown>
        cosmeticIngredients = await loadCosmeticIngredients(sp.id as string)
        scanResult = {
          found: true,
          source: 'directus',
          product: sp,
          score: (sp.cosmetic_risk as Record<string, unknown> | null) ?? { total: null, label: null, unscored: true, incomplete: true },
        }
      }
    }
  } catch { directusDown = true }
}

// 3. Auto-import dans Directus si trouvé sur OFF (fire-and-forget côté serveur)
// L'endpoint /bayen-api/scan gère l'import proprement (pas de problème UUID image_front)
let autoImported = false
if (scanResult.found && scanResult.source === 'open_food_facts') {
  try {
    const scanRes = await fetch(`${DIRECTUS_URL}/bayen-api/scan`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        barcode,
        session_id: `auto-${Date.now()}`,
        // Appel SYSTÈME : importe le produit sans écrire de ligne `scans`.
        // Le scan réel est enregistré côté client (voir <script> en bas de page)
        // avec la session persistante — et sans les bots.
        track: false,
      }),
      signal: AbortSignal.timeout(5000),
    })
    if (scanRes.ok) {
      const scanData = await scanRes.json()
      if (scanData.found && scanData.source === 'open_food_facts') {
        autoImported = true
        // Mettre à jour le produit avec l'ID Directus pour les actions (confirmer, signaler)
        if (scanData.product?.id) {
          scanResult.product = { ...scanResult.product, id: scanData.product.id }
        }
      }
    }
  } catch {
    // Non bloquant — le produit s'affiche quand même depuis OFF
  }
}

const product = scanResult.product as Record<string, unknown> | undefined
const score = scanResult.score as Record<string, unknown> | undefined
const isCosmetic = product?.product_type === 'cosmetic'

// Statut HTTP : 503 si une source n'a pas répondu (le robot repassera), 404 si le code est inconnu partout
const outage = directusDown || fetchError != null
if (outage) {
  Astro.response.status = 503
  Astro.response.headers.set('Retry-After', '300')
} else if (!scanResult.found) {
  Astro.response.status = 404
}
// Porte d'indexation (lib/indexable.ts, même règle que le sitemap) : la fiche reste visible
const noindex = Astro.response.status !== 200 || !product || !isIndexableProduct(product)

// Prix communautaires lus côté serveur (en parallèle des alternatives) : la section ne s'affiche qu'à partir de 3 relevés
const pricesPromise = scanResult.source === 'directus' ? getPriceAggregate(String(barcode)) : Promise.resolve(null)
const dataIssues: Array<{ field: string; message: string }> = Array.isArray(product?.data_issues)
  ? (product!.data_issues as Array<{ field: string; message: string }>)
  : (typeof product?.data_issues === 'string' ? (() => { try { return JSON.parse(product!.data_issues as string) } catch { return [] } })() : [])
// Allégations protéines (règl. CE 1924/2006) : « source » ≥ 12 % de l'énergie, « riche » ≥ 20 %
const _prot = typeof product?.proteins === 'number' ? product.proteins : null
const _kcal = typeof product?.energy_kcal === 'number' && product.energy_kcal > 0 ? product.energy_kcal : null
const proteinShare = _prot != null && _kcal != null ? (_prot * 4) / _kcal : null
const proteinClaim: 'rich' | 'source' | null = !isCosmetic && _prot != null && proteinShare != null && proteinShare <= 1.08
  ? (proteinShare >= 0.2 && _prot >= 10 ? 'rich' : proteinShare >= 0.12 && _prot >= 5 ? 'source' : null)
  : null
const cosmeticRisk = isCosmetic ? (score as unknown as import('@/lib/types').CosmeticRiskSummary | null) : null
const cosmeticCategoryKey = isCosmetic && typeof product?.cosmetic_category === 'string'
  ? (`beauty.cat.${product.cosmetic_category}` as Parameters<typeof t>[0])
  : null

// Alternatives plus saines (même catégorie, meilleur score)
// Entrée d'historique local (C14) — sérialisée vers le script client en bas de page
const historyEntry = {
  barcode: String(barcode ?? ''),
  name_fr: (product?.name_fr as string) ?? String(barcode ?? ''),
  brand: (product?.brand as string) ?? null,
  image_front: (product?.image_front as string) ?? null,
  scan_score: (score?.total as number | null) ?? null,
  score_label: (score?.label as string | null) ?? null,
}

let alternatives: Array<Record<string, unknown>> = []
let isBestInCategory = false

// Alternatives beauté : même catégorie cosmétique, meilleur score
if (isCosmetic && scanResult.source === 'directus' && product?.cosmetic_category && score?.total != null) {
  try {
    const altRes = await fetch(
      `${DIRECTUS_URL}/items/products?filter[product_type][_eq]=cosmetic&filter[cosmetic_category][_eq]=${product.cosmetic_category}&filter[scan_score][_gt]=${score.total}&filter[barcode][_neq]=${barcode}&filter[status][_eq]=published&sort=-scan_score&limit=3&fields=barcode,name_fr,brand,quantity,image_front,scan_score,score_label,cosmetic_risk`,
      { signal: AbortSignal.timeout(3000) }
    )
    if (altRes.ok) {
      alternatives = (await altRes.json()).data ?? []
      if (alternatives.length === 0) isBestInCategory = true
    }
  } catch { /* non critique */ }
}

if (!isCosmetic && scanResult.source === 'directus' && product?.category_id && score?.total != null) {
  try {
    const categoryId = typeof product.category_id === 'object'
      ? (product.category_id as Record<string, unknown>).id
      : product.category_id
    // TOUS les produits mieux notés du rayon (pas les 16 premiers) : le filtre lexical
    // ci-dessous s'applique AVANT la limite à 3, sinon il écartait presque tout
    const altRes = await fetch(
      `${DIRECTUS_URL}/items/products?filter[category_id][_eq]=${categoryId}&filter[product_type][_eq]=food&filter[scan_score][_gt]=${score.total}&filter[barcode][_neq]=${barcode}&filter[status][_eq]=published&sort=-scan_score,barcode&limit=-1&fields=barcode,name_fr,brand,quantity,image_front,scan_score,score_label,nutriscore_grade,sugars,salt,fat_saturated,nova_group,additives`,
      { signal: AbortSignal.timeout(3000) }
    )
    if (altRes.ok) {
      const altData = await altRes.json()
      const candidates: Array<Record<string, unknown>> = altData.data ?? []

      // Les catégories sont larges (« Épices & condiments » contient confitures
      // ET concentré de tomates) : sans garde-fou, on proposait du riz complet
      // comme alternative à une confiture. On exige donc un mot significatif
      // commun entre les noms — et s'il n'y en a aucun, on ne propose RIEN
      // plutôt que du hors-sujet.
      const STOP = new Set(['avec', 'sans', 'pour', 'les', 'des', 'aux', 'extra', 'nature', 'the'])
      const tokens = (n: unknown): Set<string> =>
        new Set(
          String(n ?? '')
            .toLowerCase()
            .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
            .split(/[^a-z]+/)
            .filter((w) => w.length >= 4 && !STOP.has(w))
        )
      const own = tokens(product.name_fr)
      const similar = candidates.filter((c) => {
        const ct = tokens(c.name_fr)
        for (const w of own) if (ct.has(w)) return true
        return false
      })
      alternatives = similar.slice(0, 3)
      // « Meilleur de sa catégorie » : uniquement si la catégorie entière n'a
      // rien au-dessus — pas quand le filtre lexical a tout écarté.
      if (candidates.length === 0) isBestInCategory = true
    }
  } catch { /* non critique */ }
}

// Raisons FACTUELLES (déterministes) pour lesquelles une alternative est
// meilleure que le produit courant — pas d'IA ici : on compare les données
// réelles (sucre, sel, graisses sat., additifs, NOVA) pour ne jamais mentir.
const _n = (v: unknown): number | null => {
  const x = typeof v === 'number' ? v : parseFloat(String(v))
  return isFinite(x) ? x : null
}
const curSugars = _n(product?.sugars)
const curSalt = _n(product?.salt)
const curSat = _n(product?.fat_saturated)
const curNova = _n(product?.nova_group)
const curAddCount = Array.isArray(product?.additives) ? (product!.additives as unknown[]).length : 0

// (une fiche beauté jamais scorée n'a pas de `counts` : ne pas planter la page)
const curFlagged = cosmeticRisk?.counts
  ? (cosmeticRisk.counts.banned ?? 0) + (cosmeticRisk.counts.high ?? 0) + (cosmeticRisk.counts.moderate ?? 0) + (cosmeticRisk.counts.low ?? 0)
  : 0

// En-tête Marché Pop (maquette FichePop) : vignette pleine sur teinte stable + pastille
const scoreTotal = typeof score?.total === 'number' ? score.total : null
const level = scoreLevel(scoreTotal)
// Pastille : aplat du score ; beauté = couleur du niveau de risque qui plafonne (CosmeticScore)
const stickerFill = isCosmetic ? cosmeticFill(cosmeticRisk) : scoreFill(scoreTotal)
const stickerWord = level ? t(`score.${level}`, locale) : t('score.notEvaluated', locale)
const tileTint = isCosmetic ? 'tint-framboise' : productTint(String(barcode ?? ''))
const imgFrontSrc = typeof product?.image_front === 'string' && product.image_front
  ? (product.image_front.startsWith('http') ? product.image_front : `${CDN_URL}/${product.image_front}?width=800&quality=85&format=webp`)
  : null
const brandName = typeof product?.brand === 'string' ? product.brand.split(',')[0].trim() : ''
// Décimale française ; 2 décimales sous 1 g (sel 0,12 g)
const fmtG = (v: number) => {
  const k = v < 1 ? 100 : 10
  return String(Math.round(v * k) / k).replace('.', ',')
}
// Bulle de Naânaa : UN constat factuel et déterministe tiré des données, sinon rien
// (`{n}` reste dans le texte : la valeur est mise en gras au rendu)
const naanaaTip: { text: string; n: string | null } | null = (() => {
  if (isCosmetic || !product) return null
  if (curSugars != null && curSugars >= 22.5) return { text: t('product.tip.sugar', locale), n: fmtG(curSugars) }
  if (curSalt != null && curSalt >= 1.5) return { text: t('product.tip.salt', locale), n: fmtG(curSalt) }
  if (curNova === 4) return { text: t('product.tip.nova4', locale), n: null }
  if (curAddCount >= 3) return { text: t('product.tip.additives', locale), n: String(curAddCount) }
  if (scoreTotal != null && scoreTotal >= 75 && curSugars != null && curSalt != null && curNova != null && curNova <= 3) return { text: t('product.tip.good', locale), n: null }
  return null
})()

// Puces de l'en-tête
const NUTRISCORE_DOT: Record<string, string> = { A: 'bg-nutriscore-a', B: 'bg-nutriscore-b', C: 'bg-nutriscore-c', D: 'bg-nutriscore-d', E: 'bg-nutriscore-e' }
const nsGrade = !isCosmetic && typeof score?.nutriscore_grade === 'string' ? score.nutriscore_grade : null
const novaChip = !isCosmetic && (curNova === 1 || curNova === 2 || curNova === 3 || curNova === 4)
  ? `NOVA ${curNova} · ${t(`nova.${curNova}`, locale).toLowerCase()}`
  : null
const isAiEstimate = product?.data_source === 'ai_estimate'

// « Pourquoi <score> ? » (maquette) : une barre par nutriment, pour 100 g.
//  - longueur = points Nutri-Score du nutriment / son maximum, calculés par l'algorithme
//    lui-même (lib/scoring.ts) : seul, un nutriment « à limiter » reste sous le plafond
//    de 11 points, donc |fsaScore| = ses points (protéines : −points) ; les maximums
//    sont lus de la même façon, avec une valeur démesurée ;
//  - couleur + mot = seuils de l'Analyse santé (nutrientLevel), pour ne jamais
//    contredire la section plus bas ; énergie = barème du détail du score (ratioFill).
// Boissons (catégories 5 et 6, comme computeScore) : barèmes boissons.
const isBeverage = !isCosmetic && [5, 6].includes(Number(product?.category_id))
const nutriPoints = (n: NutritionData): number => Math.abs(computeNutriScore({ ...n, is_beverage: isBeverage })?.fsaScore ?? 0)
const NEG_MAX = nutriPoints({ sugars: 1e6 })
const PROT_MAX = nutriPoints({ proteins: 1e6, salt: 0 })
const LEVEL_WORD: Record<NutrientLevel, string> = { good: t('product.level.low', locale), moderate: t('product.level.moderate', locale), warning: t('product.level.moderate', locale), danger: t('product.level.high', locale) }
interface NutRow { lab: string; val: string; note: string; pct: number; color: string }
const nutRows: NutRow[] = []
if (!isCosmetic && product) {
  const limits = [['sugars', t('product.bar.sugars', locale)], ['fat_saturated', t('product.bar.satFat', locale)], ['salt', t('product.salt', locale)]] as const
  for (const [key, lab] of limits) {
    const v = _n(product[key])
    if (v == null) continue
    const lv = nutrientLevel(key, v)
    nutRows.push({ lab, val: `${fmtG(v)} g`, note: LEVEL_WORD[lv], pct: (nutriPoints({ [key]: v }) / NEG_MAX) * 100, color: LEVEL_COLOR[lv] })
  }
  const prot = _n(product.proteins)
  if (prot != null) {
    // Riche / source : allégations CE 1924/2006 calculées plus haut (ou ≥ 20 g, seuil de l'Analyse santé)
    const rich = proteinClaim === 'rich' || prot >= 20
    const lv: NutrientLevel = rich || proteinClaim === 'source' ? 'good' : 'moderate'
    nutRows.push({ lab: t('product.proteins', locale), val: `${fmtG(prot)} g`, note: rich ? t('product.level.rich', locale) : proteinClaim === 'source' ? t('product.level.source', locale) : t('product.level.low', locale), pct: (nutriPoints({ proteins: prot, salt: 0 }) / PROT_MAX) * 100, color: LEVEL_COLOR[lv] })
  }
  const kcal = _n(product.energy_kcal)
  if (kcal != null) {
    const ratio = nutriPoints({ energy_kcal: kcal }) / NEG_MAX
    nutRows.push({ lab: t('product.energy', locale), val: `${Math.round(kcal)} kcal`, note: `${Math.round(kcal * 4.184)} kJ`, pct: ratio * 100, color: ratioFill(1 - ratio) })
  }
}

// Carte « Additifs » : du plus risqué au plus sûr (détail du score déterministe)
const RISK_ORDER: RiskLevel[] = ['banned_ma', 'avoid', 'limited', 'safe']
const additiveRows = isCosmetic ? [] : [...((score?.additives_detail as AdditiveResult[] | undefined) ?? [])]
  .sort((a, b) => RISK_ORDER.indexOf(a.risk_level) - RISK_ORDER.indexOf(b.risk_level))
  .map((a) => {
    const info = additiveInfo.get(a.code)
    return {
      ...a,
      name: (locale === 'ary' && info?.name_ar) || info?.name_fr || null,
      fn: (locale === 'ary' && info?.function_ar) || info?.function || null,
    }
  })

// Score à compléter avec l'IA : fiche sans score, ou score sur données incomplètes
const showEstimate = !isCosmetic && scanResult.source === 'directus'
  && (score?.total == null || (Boolean(score?.incomplete) && !isAiEstimate))

// Éléments partagés par plusieurs îlots (barre du haut, actions ordinateur et mobile)
const shareProps = {
  productName: String(product?.name_fr ?? barcode),
  brand: brandName,
  score: scoreTotal,
  barcode: String(barcode ?? ''),
}
const cartItem = {
  barcode: String(barcode ?? ''),
  name_fr: String(product?.name_fr ?? barcode),
  brand: (product?.brand as string | null) ?? null,
  image_front: (product?.image_front as string | null) ?? null,
  scan_score: scoreTotal,
  score_label: (score?.label as string | null) ?? null,
}

function altReasons(alt: Record<string, unknown>): string[] {
  const reasons: string[] = []
  if (isCosmetic) {
    const r = alt.cosmetic_risk as import('@/lib/types').CosmeticRiskSummary | null
    if (!r || !r.counts) return reasons
    const n = (r.counts.banned ?? 0) + (r.counts.high ?? 0) + (r.counts.moderate ?? 0) + (r.counts.low ?? 0)
    if (!r.cap_reason) reasons.push(t('product.alt.noRisk', locale))
    else if (n < curFlagged) reasons.push(t(curFlagged - n > 1 ? 'product.alt.fewerFlaggedN' : 'product.alt.fewerFlagged1', locale).replace('{n}', String(curFlagged - n)))
    const curPe = cosmeticRisk?.worst?.some((w) => w.risk_types.includes('endocrine'))
    if (curPe && !(r.worst ?? []).some((w) => w.risk_types.includes('endocrine'))) reasons.push(t('product.alt.noEndocrine', locale))
    return reasons.slice(0, 3)
  }
  const addCount = Array.isArray(alt.additives) ? (alt.additives as unknown[]).length : 0
  if (curAddCount > 0 && addCount < curAddCount) {
    reasons.push(addCount === 0 ? t('product.noAdditive', locale) : t(curAddCount - addCount > 1 ? 'product.alt.fewerAddN' : 'product.alt.fewerAdd1', locale).replace('{n}', String(curAddCount - addCount)))
  }
  const s = _n(alt.sugars)
  if (curSugars != null && s != null && s <= curSugars - 2) reasons.push(t('product.alt.lessSugar', locale).replace('{n}', String(Math.round(curSugars - s))))
  const nova = _n(alt.nova_group)
  if (curNova != null && nova != null && nova < curNova) reasons.push(t('product.alt.lessProcessed', locale).replace('{n}', String(nova)))
  const sat = _n(alt.fat_saturated)
  if (curSat != null && sat != null && sat <= curSat - 1) reasons.push(t('product.alt.lessSatFat', locale).replace('{n}', String(Math.round(curSat - sat))))
  const salt = _n(alt.salt)
  if (curSalt != null && salt != null && salt <= curSalt - 0.2) reasons.push(t('product.alt.lessSalt', locale).replace('{n}', (curSalt - salt).toFixed(1)))
  return reasons.slice(0, 3)
}

// ── SEO : nom affiché, title, meta description, phrase-verdict, JSON-LD ──
// Tout vient des données stockées et du score déterministe : aucun chiffre inventé.

// Apostrophe perdue à l'import (« Flocons d avoine ») : corrigée à l'affichage seulement
const fixApostrophes = (s: string): string => s.replace(/(^|\s)([dl]) (?=[aeiouyhàâäéèêëîïôöûüœAEIOUYHÀÂÉÈÊÎÔÛ])/g, "$1$2'")
const productName = fixApostrophes(String(product?.name_fr ?? barcode))
// Marque saisie tout en minuscules (« javana ») : capitale initiale à l'affichage
const brandLabel = brandName && brandName === brandName.toLocaleLowerCase('fr')
  ? brandName.replace(/(^|[\s-])(\p{L})/gu, (_m, a: string, b: string) => a + b.toLocaleUpperCase('fr'))
  : brandName
// La marque n'est répétée que si le nom ne la contient pas déjà (jamais « Sprite (Sprite) »)
const _fold = (s: string) => ` ${s.toLocaleLowerCase('fr').normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^\p{L}\p{N}]+/gu, ' ').trim()} `
const nameHead = brandLabel && !_fold(productName).includes(_fold(brandLabel)) ? `${productName} ${brandLabel}` : productName

const sep = t('seo.sep', locale)
const colon = locale === 'ary' ? ': ' : ' : '
// Premier candidat qui tient dans la limite, sinon le plus court coupé proprement
const firstFit = (cands: string[], max: number): string =>
  cands.find((c) => c.length <= max) ?? `${cands[cands.length - 1].slice(0, max - 1).trimEnd()}…`

const kcalVal = _n(product?.energy_kcal)
const kcalTxt = kcalVal != null ? t('seo.kcal', locale).replace('{n}', String(Math.round(kcalVal))) : null
const nsTxt = nsGrade ? t('seo.nutriscore', locale).replace('{g}', nsGrade) : null
const novaVal = !isCosmetic ? _n(score?.nova_group) : null
// Pour 100 g : énergie, sucres, sel (valeurs présentes seulement)
const per100 = [
  kcalTxt,
  curSugars != null ? t('seo.desc.sugars', locale).replace('{n}', fmtG(curSugars)) : null,
  curSalt != null ? t('seo.desc.salt', locale).replace('{n}', fmtG(curSalt)) : null,
].filter((x): x is string => x != null)
const scoreWord = stickerWord.toLocaleLowerCase('fr')
const cosmeticScored = isCosmetic && cosmeticRisk != null && typeof cosmeticRisk.total === 'number' && !cosmeticRisk.insufficient

// Title ≤ 65 caractères : on retire d'abord une donnée, puis la marque, jamais de « ?/100 »
const titleTails: string[] = isCosmetic
  ? [t('seo.titleBeauty', locale), '']
  : [
      ...(kcalTxt && nsTxt ? [`${kcalTxt}${sep}${nsTxt}`] : []),
      ...(kcalTxt ? [kcalTxt] : []),
      ...(nsTxt ? [nsTxt] : []),
      ...(!kcalTxt && !nsTxt && scoreTotal != null ? [t('seo.score', locale).replace('{n}', String(scoreTotal))] : []),
      '',
    ]
const pageTitle = product
  ? firstFit([nameHead, productName].flatMap((h) => titleTails.map((tl) => (tl ? `${h}${colon}${tl} | Bayen` : `${h} | Bayen`))), 65)
  : `${t(outage ? 'seo.serviceDown' : 'contrib.unknownTitle', locale)} | Bayen`

// Meta description ≤ 155 caractères, avec les vraies valeurs
const quantity = typeof product?.quantity === 'string' && product.quantity.trim() ? product.quantity.trim() : null
const descHead = quantity ? `${nameHead} (${quantity})` : nameHead
const descCands: string[] = []
if (product && !isCosmetic) {
  const p100 = per100.length > 0 ? t('seo.desc.per100', locale).replace('{list}', per100.join(sep)) : null
  const p100Short = kcalTxt ? t('seo.desc.per100', locale).replace('{list}', kcalTxt) : null
  const tail = t('seo.desc.foodTail', locale)
  if (scoreTotal != null) {
    const sc = t('seo.desc.score', locale).replace('{n}', String(scoreTotal)).replace('{w}', scoreWord)
    const nova = novaVal != null ? `NOVA ${novaVal}` : null
    const join = (parts: Array<string | null>) => `${descHead}${colon}${parts.filter(Boolean).join(sep)}.`
    for (const parts of [[sc, nsTxt, nova, p100], [sc, nsTxt, p100], [sc, p100], [sc, p100Short], [sc]]) {
      descCands.push(`${join(parts)} ${tail}`, join(parts))
    }
  } else {
    const un = t('seo.desc.unscored', locale)
    descCands.push(`${descHead}${colon}${un} ${tail}`, `${descHead}${colon}${un}`)
  }
} else if (product) {
  if (cosmeticScored) {
    const sc = t('seo.desc.beautyScore', locale).replace('{n}', String(scoreTotal)).replace('{w}', scoreWord)
    const m = String(cosmeticRisk!.token_count ?? cosmeticRisk!.matched_count ?? 0)
    const flag = t(curFlagged === 0 ? 'seo.desc.flagged0' : curFlagged === 1 ? 'seo.desc.flagged1' : 'seo.desc.flaggedN', locale)
      .replace('{n}', String(curFlagged)).replace('{m}', m)
    const base = `${descHead}${colon}${sc}${sep}${flag}.`
    descCands.push(`${base} ${t('seo.desc.beautyTail', locale)}`, base, `${descHead}${colon}${sc}.`)
  } else {
    descCands.push(`${descHead}${colon}${t(cosmeticRisk?.insufficient ? 'seo.desc.inciInsufficient' : 'seo.desc.inciMissing', locale)}`)
  }
}
const pageDescription = product
  ? firstFit(descCands, 155)
  : `${barcode} ${t('contrib.unknownDesc', locale)}`.slice(0, 155)

// Phrase-verdict (haut de fiche) : composantes du score, ce qui pèse le plus, valeurs pour 100 g
const verdict: string[] = []
if (product && !isCosmetic && scoreTotal != null) {
  const nsp = _n(score?.nutriscore_points) ?? 0
  const np = _n(score?.nova_points) ?? 0
  const ap = _n(score?.additives_points) ?? 0
  verdict.push(t('verdict.food', locale)
    .replace('{total}', String(scoreTotal))
    .replace('{ns}', nsTxt ?? t('verdict.nsMissing', locale))
    .replace('{nsp}', String(nsp))
    .replace('{nova}', String(novaVal ?? '–'))
    .replace('{np}', String(np))
    .replace('{ap}', String(ap)))
  const losses = ([['ns', 50 - nsp], ['nova', 30 - np], ['add', 20 - ap]] as const).slice().sort((a, b) => b[1] - a[1])
  verdict.push(losses[0][1] > 0
    ? t('verdict.biggest', locale).replace('{what}', t(`verdict.what.${losses[0][0]}`, locale)).replace('{n}', String(losses[0][1]))
    : t('verdict.full', locale))
  if (per100.length > 0) verdict.push(t('verdict.per100', locale).replace('{list}', per100.join(sep)))
  if (score?.incomplete) verdict.push(t('verdict.incomplete', locale))
} else if (cosmeticScored && cosmeticRisk) {
  const cap = cosmeticRisk.cap_reason
  const total = String(scoreTotal)
  if (cap) {
    const lvl = ['banned', 'high', 'moderate', 'low'].includes(cap.risk_level) ? cap.risk_level : 'unknown'
    verdict.push(t('verdict.beauty.capped', locale).replace('{n}', total).replace('{inci}', cap.inci_name)
      .replace('{level}', t(`beauty.risk.${lvl}` as Parameters<typeof t>[0], locale).toLocaleLowerCase('fr')))
    const others = (cosmeticRisk.worst ?? [])
      .filter((w) => w.inci_name !== cap.inci_name && ['banned', 'high', 'moderate', 'low'].includes(w.risk_level))
      .slice(0, 3).map((w) => w.inci_name)
    if (others.length > 0) verdict.push(t('verdict.beauty.watch', locale).replace('{list}', others.join(sep)))
  } else {
    verdict.push(t('verdict.beauty.clean', locale).replace('{n}', total).replace('{m}', String(cosmeticRisk.matched_count ?? 0)))
  }
  if (cosmeticRisk.token_count > 0) {
    verdict.push(`${t('beauty.insufficientCount', locale).replace('{a}', String(cosmeticRisk.matched_count ?? 0)).replace('{b}', String(cosmeticRisk.token_count))}.`)
  }
}
// Valeur + unité isolées (<bdi>) dans le rendu : « 378 kcal » garde son ordre en darija
// (pas un chiffre collé à une lettre ou un tiret : « PEG-40 » reste entier)
const VERDICT_NUM = /((?<![\p{L}\d,-])−?\d[\d,]*(?:\/\d+| kcal| g\b| pts)?)/u

// JSON-LD : BreadcrumbList (vrai rayon) + WebPage + Product. Pas de Review, d'AggregateRating
// ni d'Offer (Bayen ne vend rien, le score n'est pas un avis) ; aucune valeur de remplissage.
const SITE_URL = 'https://bayen.ma'
const pageUrl = `${SITE_URL}/produit/${barcode}`
const imgFront = product?.image_front as string | undefined
const productImageUrl = imgFront ? (imgFront.startsWith('http') ? imgFront : `${CDN_URL}/${imgFront}`) : undefined
const prop = (name: string, value: unknown, unitText?: string) => {
  const v = _n(value)
  return v == null ? [] : [{ '@type': 'PropertyValue', name, value: v, ...(unitText ? { unitText } : {}) }]
}
const crumbParent = !isCosmetic && product?.category_slug
  ? { name: String(product.category_name ?? product.category_slug), item: `${SITE_URL}/categories/${product.category_slug}` }
  : isCosmetic ? { name: 'Beauté', item: `${SITE_URL}/beaute` } : null
const crumbs = [{ name: 'Accueil', item: `${SITE_URL}/` }, ...(crumbParent ? [crumbParent] : []), { name: productName, item: pageUrl }]
const digits = String(barcode)
const jsonLd = product
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'BreadcrumbList',
          '@id': `${pageUrl}#breadcrumb`,
          itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.item })),
        },
        {
          '@type': 'WebPage',
          '@id': `${pageUrl}#webpage`,
          url: pageUrl,
          name: pageTitle,
          inLanguage: locale === 'ary' ? 'ar-MA' : 'fr-MA',
          isPartOf: { '@id': `${SITE_URL}/#website` },
          breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
          mainEntity: { '@id': `${pageUrl}#product` },
        },
        {
          '@type': 'Product',
          '@id': `${pageUrl}#product`,
          name: productName,
          brand: brandLabel ? { '@type': 'Brand', name: brandLabel, url: `${SITE_URL}/marque/${encodeURIComponent(brandName)}` } : undefined,
          image: productImageUrl,
          description: pageDescription,
          sku: digits,
          ...([8, 12, 13, 14].includes(digits.length) ? { [`gtin${digits.length}`]: digits } : {}),
          category: isCosmetic
            ? (cosmeticCategoryKey ? t(cosmeticCategoryKey, 'fr') : 'Cosmétique')
            : (product.category_name as string | undefined),
          url: pageUrl,
          mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
          additionalProperty: [
            ...(scoreTotal != null
              ? [{ '@type': 'PropertyValue', name: isCosmetic ? 'Score beauté Bayen' : 'Score Bayen', value: scoreTotal, unitText: '/100', minValue: 0, maxValue: 100 }]
              : []),
            ...(nsGrade ? [{ '@type': 'PropertyValue', name: 'Nutri-Score', value: nsGrade }] : []),
            ...(novaVal != null && scoreTotal != null ? [{ '@type': 'PropertyValue', name: 'Groupe NOVA', value: novaVal }] : []),
            ...(isCosmetic ? [] : [
              ...prop('Énergie (pour 100 g)', product.energy_kcal, 'kcal'),
              ...prop('Lipides (pour 100 g)', product.fat_total, 'g'),
              ...prop('dont acides gras saturés (pour 100 g)', product.fat_saturated, 'g'),
              ...prop('Glucides (pour 100 g)', product.carbs_total, 'g'),
              ...prop('dont sucres (pour 100 g)', product.sugars, 'g'),
              ...prop('Fibres (pour 100 g)', product.fiber, 'g'),
              ...prop('Protéines (pour 100 g)', product.proteins, 'g'),
              ...prop('Sel (pour 100 g)', product.salt, 'g'),
            ]),
            ...(Array.isArray(product.additives) && product.additives.length > 0
              ? [{ '@type': 'PropertyValue', name: 'Additifs détectés', value: (product.additives as string[]).join(', ') }]
              : []),
          ],
        },
      ],
    }
  : undefined

// Fiche en base : carte d'aperçu « Marché Pop » (photo + score, générée par l'API) ;
// produit lu seulement chez OFF : sa photo brute, comme avant
const ogImage = scanResult.source === 'directus'
  ? `${DIRECTUS_URL}/bayen-api/og/${barcode}.jpg`
  : imgFront ? (imgFront.startsWith('http') ? imgFront : `${CDN_URL}/${imgFront}`) : undefined

// Section « Où l'acheter moins cher » : seulement à partir de 3 relevés (sinon pas de H2 vide)
const prices: PriceAggregate | null = await pricesPromise
const PRICE_MIN_REPORTS = 3
const showPrices = (prices?.count ?? 0) >= PRICE_MIN_REPORTS
---

<Layout title={pageTitle} description={pageDescription} path={`/produit/${barcode}`} ogType="product" ogImage={ogImage} jsonLd={jsonLd} noindex={noindex} universe={isCosmetic ? 'beauty' : undefined} mobileTopbar={false}>
  {/* Barre du haut mobile (maquette FichePop) : retour | partager + à mes courses */}
  <header class="topbar md:hidden">
    <a class="icon-btn" href="/recherche" data-back aria-label={t('nav.back', locale)}>
      <svg class="rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
    </a>
    <div class="flex gap-2">
      {!fetchError && scanResult.found && product && (
        <>
          <ShareButton variant="icon" {...shareProps} client:load />
          <AddToCartButton look="icon" item={cartItem} client:load />
        </>
      )}
      <button type="button" class="icon-btn " data-open-menu aria-label={t('nav.menu', locale)}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg></button>
    </div>
  </header>

  <main class="screen gap-[22px] md:gap-12">

    {/* Erreur réseau (503) : Directus, Open Food Facts ou Open Beauty Facts n'a pas répondu */}
    {outage && !scanResult.found && (
      <section class="section justify-items-center py-6 text-center">
        <img src="/mascotte/naanaa-oups.webp" alt="" width="120" height="177" class="naanaa-bob" />
        <h1 class="disp d-m">{directusDown ? t('seo.serviceDown', locale) : fetchError}</h1>
        <p class="muted text-sm">{t('common.networkError', locale)}</p>
        <a href="/scan" class="btn primary">{t('nav.scan', locale)}</a>
      </section>
    )}

    {/* Produit non trouvé (404 + noindex) : on garde l'invitation à l'ajouter */}
    {!outage && !scanResult.found && (
      <section class="section mx-auto w-full max-w-sm justify-items-center py-6 text-center">
        {/* Naânaa « oups » : on dit ce qui manque, pas « erreur » */}
        <img src="/mascotte/naanaa-oups.webp" alt="" width="120" height="177" class="naanaa-bob" />

        <h1 class="disp d-l">{t('contrib.unknownTitle', locale)}</h1>
        <p class="muted text-[15px] leading-relaxed">
          <span class="font-bold text-foreground">{barcode}</span> {t('contrib.unknownDesc', locale)}
        </p>

        <span class="chip fill h-9 bg-citron px-4 text-[13px]">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
          </svg>
          {t('product.addPoints', locale)}
        </span>

        <div class="mt-2 grid w-full gap-3">
          <a href={`/contribuer/${barcode}`} class="btn primary min-h-[58px] text-[17px]">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 5v14M5 12h14" />
            </svg>
            {t('contrib.addThis', locale)}
          </a>
          <a href="/scan" class="btn min-h-[54px]">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" />
            </svg>
            {t('contrib.rescan', locale)}
          </a>
        </div>

        <p class="muted text-[13px]">{t('contrib.quickPromise', locale)}</p>
      </section>
    )}

    {/* Produit trouvé */}
    {scanResult.found && product && score && (
      <>
        {/* Barre collante : nom + score restent visibles pendant la lecture des détails */}
        <div id="product-sticky" class="product-sticky" aria-hidden="true">
          {product.image_front && (
            <img src={(product.image_front as string).startsWith('http') ? (product.image_front as string) : `${CDN_URL}/${product.image_front}?width=96&height=96&fit=cover&quality=75&format=webp`} alt="" width="36" height="36" />
          )}
          <span class="min-w-0 flex-1 truncate text-sm font-bold">{productName}</span>
          {scoreTotal != null && (
            <span class="sticky-score" style={`background: ${stickerFill}`}>{scoreTotal}</span>
          )}
        </div>

        {/* En-tête — maquette FichePop. Ordinateur : vignette | infos */}
        <div id="product-head" class="grid gap-4 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:items-start md:gap-12">
          {/* Vignette : la photo REMPLIT le cadre ; la teinte ne se voit que sans photo */}
          <div class="section md:sticky md:top-6 md:pb-8">
            <div class="relative">
              <div class:list={['tile h-[260px] rounded-[28px] shadow-[5px_5px_0_var(--color-hard)] md:h-auto md:aspect-square', tileTint]}>
                <svg class="ph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
                  <circle cx="9" cy="9" r="2" />
                  <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
                </svg>
                {imgFrontSrc && <img src={imgFrontSrc} alt={productName} fetchpriority="high" />}
              </div>
              {/* Pastille halal sur la photo (jamais retirée automatiquement : même condition que la puce) */}
              {product.is_halal && (
                <span class="halal-sticker" role="img" aria-label={t('halal.badge', locale)}>
                  {/* Le logo porte déjà « HALAL » : pas de libellé en plus */}
                  <span set:html={halalLogo} aria-hidden="true" class="grid place-items-center" />
                </span>
              )}
              {/* Pastille (chiffre + mot) — le détail reste dans ScoreDisplay / CosmeticScore (hideBadge) */}
              <span
                class:list={['score-sticker lg absolute end-2 -bottom-[26px]', !level && 'none', String(scoreTotal ?? '').length > 2 && 'w3']}
                style={level ? `--c: ${stickerFill}` : undefined}
                role="img"
                aria-label={level ? t('product.scoreAria', locale).replace('{n}', String(scoreTotal)).replace('{w}', stickerWord) : stickerWord}
              >
                <span aria-hidden="true"><b>{scoreTotal ?? '?'}</b><i>{stickerWord}</i></span>
              </span>
            </div>
          </div>

          <div class="flex min-w-0 flex-col gap-[22px] md:gap-8">
            <section class="section gap-4">
              <div class="grid gap-1.5 pe-[110px] md:pe-0">
                <h1 class="disp d-l md:text-[44px]">{productName}</h1>
                <p class="muted">
                  {brandName && <><a href={`/marque/${encodeURIComponent(brandName)}`} class="hover:text-brand-ink hover:underline">{brandLabel}</a> · </>}
                  {product.quantity && <>{product.quantity} · </>}
                  <span class="num">{barcode}</span>
                </p>
              </div>

              <div class="chips">
                {/* Halal sourcé + confirmation communautaire (C17) : jamais retiré automatiquement */}
                <HalalBadge
                  client:visible
                  barcode={String(barcode)}
                  isHalal={Boolean(product.is_halal)}
                  source={(product.halal_source as 'off' | 'packaging_user' | 'vision' | null) ?? null}
                  confirmations={Number(product.halal_confirmations ?? 0)}
                />
                {novaChip && <span class="chip">{novaChip}</span>}
                {!isCosmetic && curAddCount > 0 && (
                  <a href="#additifs" class="chip">{curAddCount} {t(curAddCount > 1 ? 'card.additives' : 'card.additive', locale)}</a>
                )}
                {nsGrade && NUTRISCORE_DOT[nsGrade] && (
                  <span class="chip"><span class:list={['size-2.5 rounded-full', NUTRISCORE_DOT[nsGrade]]}></span>Nutri-Score {nsGrade}</span>
                )}
                {isAiEstimate && <span class="chip fill bg-ai">{t('score.aiEstimate', locale)}</span>}
                {!isCosmetic && !isAiEstimate && scoreTotal != null && score.incomplete && (
                  <span class="chip fill bg-citron">{t('score.incomplete', locale)}</span>
                )}
                {product.category_id && (
                  <a href={`/categories/${product.category_slug ?? product.category_id}`} class="chip hover:bg-muted">{product.category_name ?? t('search.category', locale)}</a>
                )}
                {isCosmetic && <span class="chip fill bg-beauty">{t('beauty.badge', locale)}</span>}
                {cosmeticCategoryKey && (
                  <a href={`/beaute?cat=${product.cosmetic_category}`} class="chip hover:bg-muted">{t(cosmeticCategoryKey, locale)}</a>
                )}
                {isCosmetic && product.period_after_opening && (
                  <span class="chip">{t('beauty.pao', locale)} : {String(product.period_after_opening)}</span>
                )}
                {product.is_organic && <span class="chip fill bg-score-excellent">{t('product.bio', locale)}</span>}
                {proteinClaim && (
                  <a href="/proteines" class="chip fill bg-protein" title={`${Math.round((proteinShare ?? 0) * 100)} % ${t('protein.share', locale)}`}>
                    {proteinClaim === 'rich' ? t('protein.rich', locale) : t('protein.source', locale)} · {_prot} g
                  </a>
                )}
                {dataIssues.length > 0 && (
                  <a href={`/contribuer/${barcode}`} class="chip fill bg-citron" title={dataIssues.map((i) => i.message).join(' · ')}>
                    {t('product.dataIssues', locale)}
                  </a>
                )}
                {scanResult.source === 'open_food_facts' && <span class="chip">Open Food Facts</span>}
                {isCosmetic && product.data_source === 'obf' && <span class="chip">Open Beauty Facts</span>}
              </div>

              {/* Verdict déterministe : composantes du score et valeurs pour 100 g (aucune IA) */}
              {verdict.length > 0 && (
                <p class="text-[15px] leading-relaxed">
                  {verdict.join(' ').split(VERDICT_NUM).map((part, i) => (i % 2 ? <bdi>{part}</bdi> : part))}
                </p>
              )}

              {/* Bulle de Naânaa : un constat factuel tiré des chiffres */}
              {naanaaTip && (
                <div class="naanaa grid-cols-[56px_minmax(0,1fr)]">
                  <div class="m size-14"><img src="/mascotte/naanaa-astuce.webp" alt="" width="56" height="56" loading="lazy" /></div>
                  <p class="bubble">
                    {naanaaTip.n
                      ? <>{naanaaTip.text.split('{n}')[0]}<b>{naanaaTip.n}</b>{naanaaTip.text.split('{n}')[1]}</>
                      : naanaaTip.text}
                  </p>
                </div>
              )}
            </section>

            {/* Alerte profil santé (C13) — rien si profil vide ou produit compatible */}
            {!isCosmetic && <ProfileAlert
              additives={Array.isArray(product.additives) ? product.additives as string[] : []}
              structured_ingredients={product.structured_ingredients as any[] ?? []}
              traces={Array.isArray(product.traces) ? product.traces as string[] : []}
              ingredients_text={product.ingredients_text as string ?? ''}
              client:load
            />}

            {/* « Pourquoi <score> ? » — barres de nutriments pour 100 g */}
            {!isCosmetic && scoreTotal != null && nutRows.length > 0 && (
              <section class="section">
                <div class="card grid gap-3.5 p-4 md:p-6">
                  <div class="sec-head"><h2 class="disp d-m">{t('product.why', locale).replace('{n}', String(scoreTotal))}</h2><span class="eyebrow">{t('product.per100g', locale)}</span></div>
                  {nutRows.map((r) => (
                    <div class="nut">
                      <span class="lab">{r.lab}</span>
                      <span class="val"><bdi><b>{r.val}</b></bdi> · {r.note}</span>
                      <span class="bar"><i style={`width: ${Math.max(r.pct, 4)}%; background: ${r.color}`}></i></span>
                    </div>
                  ))}
                  <a href="#detail-score" class="justify-self-start text-[13px] font-bold underline underline-offset-[3px]">{t('product.scoreDetail', locale)}</a>
                </div>
              </section>
            )}

            {/* Beauté : le score plafonné par le pire ingrédient INCI tient lieu de « Pourquoi » */}
            {isCosmetic && (
              <section class="section">
                <div class="card grid gap-4 p-4 md:p-6">
                  {scoreTotal != null && Boolean(product.inci_text) && (
                    <div class="sec-head"><h2 class="disp d-m">{t('product.why', locale).replace('{n}', String(scoreTotal))}</h2><span class="eyebrow">{t('product.inciListLower', locale)}</span></div>
                  )}
                  <CosmeticScore
                    risk={cosmeticRisk}
                    ingredients={cosmeticIngredients}
                    hasInciText={Boolean(product.inci_text)}
                    barcode={barcode as string}
                    hideBadge
                    client:load
                  />
                </div>
              </section>
            )}

            {/* Fiche sans score : on le dit tout de suite, et on propose de la compléter */}
            {!isCosmetic && scoreTotal == null && (
              <section class="section">
                <div class="card grid gap-5 p-4 md:p-6">
                  <ScoreDisplay
                    score={score as any}
                    confidenceScore={product.confidence_score as number | null | undefined}
                    dataSource={product.data_source as string | null | undefined}
                    hideBadge
                    client:load
                  />
                  {showEstimate && (
                    <div class="border-t pt-5">
                      <EstimateWithAI barcode={barcode as string} client:visible />
                    </div>
                  )}
                </div>
              </section>
            )}

            {/* Actions — ordinateur (sur mobile : en bas de page) */}
            <div class="section hidden md:flex md:flex-wrap md:items-center md:gap-3">
              <a class="btn" href="/comparer">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16M17 4v16M3 8h8M13 16h8" /></svg>
                {t('nav.compare', locale)}
              </a>
              <AddToCartButton look="bar" item={cartItem} client:load />
              <ShareButton variant="icon" {...shareProps} client:load />
            </div>
          </div>
        </div>

        {/* Additifs | Où l'acheter moins cher (pas de conteneur vide : il ajouterait un écart) */}
        {(additiveRows.length > 0 || scanResult.source === 'directus') && (
        <div class:list={['grid gap-[22px] md:items-start md:gap-8', additiveRows.length > 0 && showPrices && 'md:grid-cols-2']}>
          {additiveRows.length > 0 && (
            <section id="additifs" class="section scroll-mt-24">
              <div class="card grid gap-3 p-4 md:p-6">
                <h2 class="disp d-m">{t('additives.title', locale)}</h2>
                <div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-2.5">
                  {additiveRows.map((a) => (
                    <>
                      <div class="min-w-0">
                        <a href={`/additifs/${a.code}`} class="font-bold hover:underline">{a.code}</a>{a.name && <> · {a.name}</>}
                        {a.fn && <p class="muted text-[12.5px] first-letter:uppercase">{a.fn}</p>}
                      </div>
                      <span class="chip fill" style={`background: ${RISK_FILL[a.risk_level]}`}>{t(RISK_LABEL_KEYS[a.risk_level], locale)}</span>
                    </>
                  ))}
                </div>
              </div>
            </section>
          )}

          {/* Prix communautaires (C22) : médiane par enseigne — uniquement pour un
              produit de notre base (un produit encore servi depuis OFF n'a pas d'id).
              Moins de 3 relevés : ni titre ni liste, seulement le bouton pour en partager un */}
          {scanResult.source === 'directus' && (
            <PriceSection client:visible barcode={String(barcode)} initial={prices} minReports={PRICE_MIN_REPORTS} />
          )}
        </div>
        )}

        {/* Mieux, dans le même rayon */}
        {scanResult.source === 'directus' && (product?.category_id || isCosmetic) && score?.total != null && (
          <ProductAlternatives
            alternatives={alternatives.map((a: Record<string, unknown>) => ({
              barcode: a.barcode as string,
              name_fr: a.name_fr as string,
              brand: a.brand as string,
              image_front: a.image_front as string | null,
              scan_score: a.scan_score as number | null,
              score_label: a.score_label as string | null,
              nutriscore_grade: (a.nutriscore_grade as string | null) ?? null,
              reasons: altReasons(a),
            }))}
            isBestInCategory={isBestInCategory}
            client:load
          />
        )}

        {/* Une info manque ? (+20 pts = barème add_image de bayen-api/points.ts) */}
        <section class="section">
          <a href={`/contribuer/${barcode}`} class="card flex items-center gap-3 bg-muted px-4 py-3.5">
            <svg class="size-[22px] flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z" /><circle cx="12" cy="14" r="4" /></svg>
            <span class="flex-1 text-sm"><b>{t('product.missingInfo', locale)}</b> {t('product.missingInfoCta', locale)}</span>
            <span class="chip fill bg-menthe">{t('product.pts20', locale)}</span>
          </a>
        </section>

        {/* Le reste de la fiche — ordinateur : deux colonnes indépendantes (pas de rangées, donc pas de trous) ;
            mobile : la colonne de gauche puis celle de droite */}
        <div class="grid gap-[22px] md:grid-cols-2 md:items-start md:gap-8">
          <div class="grid min-w-0 content-start gap-[22px] md:gap-12">
  {/* Détail du score (Nutri-Score, NOVA, additifs) */}
            {!isCosmetic && scoreTotal != null && (
              <section id="detail-score" class="section scroll-mt-24">
                <div class="sec-head"><h2 class="disp d-m">{t('product.scoreDetail', locale)}</h2></div>
                <div class="card grid gap-5 p-4 md:p-6">
                  <ScoreDisplay
                    score={score as any}
                    confidenceScore={product.confidence_score as number | null | undefined}
                    dataSource={product.data_source as string | null | undefined}
                    hideBadge
                    hideAdditives={additiveRows.length > 0}
                    client:load
                  />
                  {/* Score calculé sur des données incomplètes → la compléter */}
                  {showEstimate && (
                    <div class="border-t pt-5">
                      <EstimateWithAI barcode={barcode as string} client:visible />
                    </div>
                  )}
                </div>
              </section>
            )}
  {/* Analyse santé — commentaires explicatifs par nutriment */}
            {!isCosmetic && <HealthAnalysis
              nutrition={{
                energy_kcal: product.energy_kcal as number | null,
                fat_total: product.fat_total as number | null,
                fat_saturated: product.fat_saturated as number | null,
                sugars: product.sugars as number | null,
                salt: product.salt as number | null,
                fiber: product.fiber as number | null,
                proteins: product.proteins as number | null,
              }}
              novaGroup={product.nova_group as number | null}
              nutriscoreGrade={score.nutriscore_grade as string | null}
              additives={Array.isArray(product.additives) ? product.additives as string[] : []}
              ingredients={product.ingredients_text as string ?? ''}
              client:load
            />}
  {/* Liste INCI (beauté) */}
            {isCosmetic && product.inci_text && (
              <InciList ingredients={cosmeticIngredients} inciText={product.inci_text as string} client:load />
            )}
  {/* Enrichir depuis OFF (produits Directus incomplets) */}
            {!isCosmetic && scanResult.source === 'directus' && product.id && (
              <EnrichFromOff
                productId={product.id as string}
                barcode={barcode as string}
                existing={{
                  hasImage: !!(product.image_front),
                  hasNutrition: product.energy_kcal != null || product.fat_total != null,
                  hasIngredients: !!(product.ingredients_text),
                  hasScore: product.scan_score != null,
                  hasAdditives: Array.isArray(product.additives) && (product.additives as unknown[]).length > 0,
                }}
                client:load
              />
            )}
  {/* Info source Open Food Facts */}
            {scanResult.source === 'open_food_facts' && (
              <section class="section">
                <div class:list={['rounded-[20px] border-2 border-line p-4 text-foreground', autoImported ? 'tint-menthe' : 'tint-citron']}>
                  {autoImported ? (
                    <p class="flex items-center gap-2 text-sm">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
                      {t('product.offImported', locale)}
                    </p>
                  ) : (
                    <p class="text-sm">
                      {t('product.offPending', locale)}
                    </p>
                  )}
                </div>
              </section>
            )}
          </div>
          <div class="grid min-w-0 content-start gap-[22px] md:gap-12">
  {/* Ingrédients (structurés si disponibles, sinon fallback texte) */}
            {!isCosmetic && (product.structured_ingredients || product.ingredients_text) && (
              <IngredientsList
                ingredients={product.structured_ingredients as any[] ?? []}
                traces={Array.isArray(product.traces) ? product.traces as string[] : []}
                ingredientsText={product.ingredients_text as string ?? ''}
                locale={locale}
                client:load
              />
            )}
  {/* Valeurs nutritionnelles complètes */}
            {(product.energy_kcal != null || product.proteins != null) && (
              <section class="section">
                <div class="sec-head"><h2 class="disp d-m">{t('product.nutrition', locale)}</h2></div>
                <div class="card grid px-4 py-2 sm:grid-cols-2 sm:gap-x-8 md:px-6">
                  {[
                    { label: t('product.energy', locale), value: product.energy_kcal, unit: 'kcal' },
                    { label: t('product.fat', locale), value: product.fat_total, unit: 'g' },
                    { label: t('product.saturatedFat', locale), value: product.fat_saturated, unit: 'g' },
                    { label: t('product.carbs', locale), value: product.carbs_total, unit: 'g' },
                    { label: t('product.sugars', locale), value: product.sugars, unit: 'g' },
                    { label: t('product.fiber', locale), value: product.fiber, unit: 'g' },
                    { label: t('product.proteins', locale), value: product.proteins, unit: 'g' },
                    { label: t('product.salt', locale), value: product.salt, unit: 'g' },
                  ].map((item) => (
                    <div class="flex items-baseline justify-between gap-3 border-b border-line/15 py-2 text-sm">
                      <span>{item.label}</span>
                      <span class="num font-semibold">{item.value != null ? `${item.value} ${item.unit}` : '—'}</span>
                    </div>
                  ))}
                </div>
              </section>
            )}
  {/* Photos de l'étiquette (lisibles en entier : ce sont des documents) */}
            {(product.image_nutrition || product.image_ingredients) && (
              <section class="section">
                <div class="sec-head"><h2 class="disp d-m">{t('product.labelPhotos', locale)}</h2></div>
                <div class="grid grid-cols-2 gap-3">
                  {product.image_nutrition && (
                    <figure class="card grid content-start gap-2 p-3">
                      <img
                        src={`${CDN_URL}/${product.image_nutrition}?width=800&quality=85&format=webp`}
                        alt={t('contrib.photoNutrition', locale)}
                        class="max-h-64 w-full rounded-xl object-contain"
                        loading="lazy"
                      />
                      <figcaption class="muted text-xs font-semibold">{t('contrib.photoNutrition', locale)}</figcaption>
                    </figure>
                  )}
                  {product.image_ingredients && (
                    <figure class="card grid content-start gap-2 p-3">
                      <img
                        src={`${CDN_URL}/${product.image_ingredients}?width=800&quality=85&format=webp`}
                        alt={t('contribute.photoIngredients', locale)}
                        class="max-h-64 w-full rounded-xl object-contain"
                        loading="lazy"
                      />
                      <figcaption class="muted text-xs font-semibold">{isCosmetic ? t('inci.title', locale) : t('contribute.photoIngredients', locale)}</figcaption>
                    </figure>
                  )}
                </div>
              </section>
            )}
  {/* Code-barres : ticket imprimé (blanc et encre dans les deux thèmes) + corriger / scanner */}
            <section class="section">
              <div class="sec-head"><h2 class="disp d-m">{t('product.barcodeTitle', locale)}</h2></div>
              <div class="card grid items-center gap-4 p-4 sm:grid-cols-[auto_minmax(0,1fr)] md:p-5">
                <span class="barcode-ticket-wrap"><span class="barcode-ticket" role="img" aria-label={`${t('product.barcodeTitle', locale)} ${barcode}`}>
                  {barcodeBars ? (
                    <>
                      <span class="kind">{barcodeKind}</span>
                      <span class="bars"><Fragment set:html={barcodeBars} /><i class="laser" /></span>
                    </>
                  ) : <span class="kind">{t('product.code', locale)}</span>}
                  <span class="digits num">{barcodeDigits.map((g) => <span>{g}</span>)}</span>
                </span></span>
                <div class="grid gap-2.5 sm:justify-self-end">
                  <a href={`/contribuer/${barcode}`} class="btn sm w-full">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 20h9" />
                      <path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838.838-2.872a2 2 0 0 1 .506-.855z" />
                    </svg>
                    {t('product.fix', locale)}
                  </a>
                  <a href="/scan" class="btn sm w-full">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3" /><path d="M8 9v6M11 9v6M14 9v6M17 9v6" />
                    </svg>
                    {t('product.scanAnother', locale)}
                  </a>
                </div>
              </div>
            </section>
  {/* Confirmer / Signaler (contributeurs+) — rien n'est rendu sans les droits */}
            {product.id && (
              <ProductActions
                productId={product.id as string}
                barcode={barcode as string}
                confidenceScore={(product.confidence_score as number) ?? 0}
                client:load
              />
            )}
          </div>
        </div>

        {/* Barre d'actions mobile (maquette) : en bas de page, pas fixe — la barre
            d'onglets du Layout occupe déjà le bas de l'écran */}
        <div class="grid grid-cols-[1fr_1.4fr] gap-2.5 border-t-2 border-line px-3.5 pt-3 pb-4 md:hidden">
          <a class="btn" href="/comparer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16M17 4v16M3 8h8M13 16h8" /></svg>
            {t('nav.compare', locale)}
          </a>
          <AddToCartButton look="bar" item={cartItem} client:load />
        </div>
      </>
    )}

  </main>

  <script>
    // Retour : page précédente si on vient du site, sinon la recherche
    document.querySelector('[data-back]')?.addEventListener('click', (e) => {
      if (document.referrer.startsWith(location.origin) && history.length > 1) {
        e.preventDefault()
        history.back()
      }
    })

    // Barre collante : visible dès que l'en-tête produit sort de l'écran
    const head = document.getElementById('product-head')
    const bar = document.getElementById('product-sticky')
    if (head && bar) {
      new IntersectionObserver(([e]) => bar.classList.toggle('on', !e.isIntersecting && e.boundingClientRect.top < 0), { threshold: 0 }).observe(head)
    }
  </script>

  {/* Côté client, si le produit existe (les bots n'exécutent pas de JS) :
      1. historique local « Mes scans » (C14) — à CHAQUE visite ;
      2. enregistrement du scan (C12) — 1× par produit et par session.
      Fire-and-forget : n'impacte jamais l'affichage. */}
  {scanResult.found && (
    <script is:inline define:vars={{ trackBarcode: barcode, historyEntry }}>
      (function () {
        try {
          if (!/^\d{8}$|^\d{13}$/.test(String(trackBarcode))) return;

          // ── 1. Historique local (C14) : rafraîchi à chaque visite ──
          try {
            var H_KEY = 'bayen_scan_history';
            var list = [];
            try { list = JSON.parse(localStorage.getItem(H_KEY) || '[]') || []; } catch (e) {}
            if (!Array.isArray(list)) list = [];
            list = list.filter(function (e) { return e && e.barcode !== historyEntry.barcode; });
            historyEntry.at = Date.now();
            list.unshift(historyEntry);
            localStorage.setItem(H_KEY, JSON.stringify(list.slice(0, 100)));
            window.dispatchEvent(new CustomEvent('bayen-history-change'));
          } catch (e) {}

          // ── 2. Mesure d'usage (C12) : 1× par produit et par session ──
          var sid = localStorage.getItem('bayen_session_id');
          if (!sid) return; // le Layout le pose au premier paint
          var seenKey = 'bayen_scanned_' + trackBarcode;
          if (sessionStorage.getItem(seenKey)) return;
          sessionStorage.setItem(seenKey, '1');
          var dev = window.matchMedia('(max-width: 768px)').matches ? 'mobile' : 'desktop';
          fetch('/api/directus/bayen-api/scan', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ barcode: String(trackBarcode), session_id: sid, device_type: dev }),
            keepalive: true,
          }).catch(function () {});
        } catch (e) {}
      })();
    </script>
  )}
</Layout>

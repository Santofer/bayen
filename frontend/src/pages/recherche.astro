---
// Page recherche produits (maquette « Recherche ») : la barre du haut
// (retour, titre, filtres) est dessinée par SearchPage
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import SearchPage from '@/components/SearchPage'
import { getLocale, t } from '@/lib/i18n'

const locale = getLocale(Astro.cookies?.get('bayen_locale')?.value ?? null)
---

<Layout
  title={t('seo.search.title', locale)}
  description={t('seo.search.desc', locale)}
  path="/recherche"
  mobileTopbar={false}
>
  <main class="screen gap-4 md:gap-8">
    <SearchPage client:load showTopbar />
  </main>
</Layout>

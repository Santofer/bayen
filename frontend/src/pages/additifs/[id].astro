---
// Page fiche additif (SSR)
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import PageHero from '@/components/PageHero.astro'
import ProductCard from '@/components/ProductCard.tsx'
import { RISK_FILL } from '@/components/AdditiveTag.tsx'
import type { Product, RiskLevel } from '@/lib/types'
import type { TranslationKey } from '@/lib/translations'
import { getLocale, t } from '@/lib/i18n'
import { additiveDescription, additiveSources } from '@/lib/additive-text'

const locale = getLocale(Astro.cookies?.get('bayen_locale')?.value ?? null)
const id = Astro.params.id ?? ''
const SITE_URL = 'https://bayen.ma'
const DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL ?? 'https://api.bayen.ma'

let additive: Record<string, unknown> | null = null
let products: Product[] = []
let productsCount = 0
let fetchError: string | null = null

try {
  const [res, prodRes] = await Promise.all([
    fetch(`${DIRECTUS_URL}/items/additives/${encodeURIComponent(id)}`, { signal: AbortSignal.timeout(5000) }),
    // Produits contenant cet additif — endpoint SQL custom (le champ JSON
    // additives ne supporte pas _contains via l'API items)
    fetch(`${DIRECTUS_URL}/bayen-api/search-products?has_additive=${encodeURIComponent(id)}&limit=24&sort=-scan_count`, {
      signal: AbortSignal.timeout(5000),
    }),
  ])
  if (res.ok) {
    const data = await res.json()
    additive = data.data ?? null
  } else if (res.status >= 500) {
    fetchError = t('additivesPage.serverError', locale)
  }
  // 403 / 404 : Directus répond 403 en public pour un identifiant inexistant → additif introuvable
  if (prodRes.ok) {
    const pd = await prodRes.json()
    products = pd.data ?? []
    productsCount = pd.count ?? products.length
  }
} catch {
  fetchError = t('additivesPage.serverError', locale)
}

const RISK_LABEL_KEYS: Record<RiskLevel, TranslationKey> = {
  safe: 'additive.risk.safe',
  limited: 'additive.risk.limited',
  avoid: 'additive.risk.avoid',
  banned_ma: 'additive.risk.banned',
}

// Carte « niveau de risque » teintée (classes .tint-* : gèrent le mode sombre)
const RISK_BG: Record<RiskLevel, string> = {
  safe: 'tint-menthe',
  limited: 'tint-citron',
  avoid: 'tint-tomate',
  banned_ma: 'tint-tomate',
}

const RISK_DESC_KEYS: Record<RiskLevel, TranslationKey> = {
  safe: 'additive.riskDesc.safe',
  limited: 'additive.riskDesc.limited',
  avoid: 'additive.riskDesc.avoid',
  banned_ma: 'additive.riskDesc.banned',
}

const RISK_IMPACT_KEYS: Record<RiskLevel, TranslationKey> = {
  safe: 'additive.impactNone',
  limited: 'additive.impactLimited',
  avoid: 'additive.impactAvoid',
  banned_ma: 'additive.impactBanned',
}

const riskLevel: RiskLevel = (additive?.risk_level as RiskLevel | undefined) ?? 'limited'
const ar = locale === 'ary'
const displayName = additive ? String((ar && additive.name_ar) || additive.name_fr) : ''
const fn = additive?.function ? String((ar && additive.function_ar) || additive.function) : ''
const displayFunction = fn ? fn.charAt(0).toUpperCase() + fn.slice(1) : undefined
const description = additiveDescription(String((ar && additive?.description_ar) || additive?.description_fr || ''))
const sources = additive ? additiveSources(id, additive.sources) : []

// Additif inexistant : vrai 404 (503 si l'API ne répond pas, pour que Google repasse plus tard)
if (!additive) Astro.response.status = fetchError ? 503 : 404

// Title et description construits à partir des données : rien n'est promis qui ne soit pas sur la page
const nameForSeo = additive ? displayName : ''
const fullTitle = t('seo.additive.title', locale).replace('{id}', id).replace('{name}', nameForSeo)
const pageTitle = !additive
  ? t('seo.additive.notFound', locale).replace('{id}', id)
  : productsCount > 0 && fullTitle.length <= 65
    ? fullTitle
    : t('seo.additive.titleShort', locale).replace('{id}', id).replace('{name}', nameForSeo)
// Description : la version la plus complète qui tient en 155 caractères (on retire d'abord la phrase finale, puis la fonction)
const risk = t(`seo.additive.risk.${riskLevel}`, locale)
const inProducts = productsCount > 0 ? ` ${t('seo.additive.products', locale).replace('{n}', String(productsCount))}` : ''
const tail = ` ${t('seo.additive.tail', locale)}`
const lead = (withFn: boolean): string =>
  t(withFn && fn ? 'seo.additive.lead' : 'seo.additive.leadNoFn', locale).replace('{id}', id).replace('{name}', nameForSeo).replace('{fn}', fn).replace('{risk}', risk)
const descCandidates = [lead(true) + inProducts + tail, lead(true) + inProducts, lead(false) + inProducts]
const pageDescription = additive
  ? descCandidates.find((d) => d.length <= 155) ?? descCandidates[descCandidates.length - 1]
  : t('additive.notFoundDesc', locale)

// JSON-LD : WebPage + DefinedTerm (membre du DefinedTermSet de /additifs) + BreadcrumbList, uniquement ce qui est affiché
const pageUrl = `${SITE_URL}/additifs/${encodeURIComponent(id)}`
const jsonLd = additive
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        '@id': `${pageUrl}#webpage`,
        url: pageUrl,
        name: pageTitle,
        description: pageDescription,
        inLanguage: ar ? 'ar-MA' : 'fr-MA',
        isPartOf: { '@id': `${SITE_URL}/#website` },
        breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
        about: { '@id': `${pageUrl}#term` },
        ...(sources.length > 0 && {
          citation: sources.map((s) => (s.url ? { '@type': 'CreativeWork', name: s.label, url: s.url } : s.label)),
        }),
      },
      {
        '@context': 'https://schema.org',
        '@type': 'DefinedTerm',
        '@id': `${pageUrl}#term`,
        termCode: id,
        name: displayName,
        ...(description && { description }),
        inDefinedTermSet: { '@type': 'DefinedTermSet', '@id': `${SITE_URL}/additifs#set`, name: t('additives.pageTitle', locale), url: `${SITE_URL}/additifs` },
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        '@id': `${pageUrl}#breadcrumb`,
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
          { '@type': 'ListItem', position: 2, name: 'Additifs', item: `${SITE_URL}/additifs` },
          { '@type': 'ListItem', position: 3, name: `${id} · ${displayName}`, item: pageUrl },
        ],
      },
    ]
  : undefined
---

<Layout
  title={pageTitle}
  description={pageDescription}
  path={`/additifs/${encodeURIComponent(id)}`}
  jsonLd={jsonLd}
  noindex={!additive}
  mobileTopbar={false}
>
  <PageHero
    tone="tomate"
    mascot="loupe"
    back="/additifs"
    kicker={t('nav.additives', locale)}
    title={additive ? `${id} · ${displayName}` : String(id)}
    subtitle={displayFunction}
  >
    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 2v7.5a2 2 0 0 1-.2.9L4.7 20.5a1 1 0 0 0 .9 1.5h12.8a1 1 0 0 0 .9-1.5l-5.1-10.1a2 2 0 0 1-.2-.9V2M8.5 2h7"/></svg>
    {additive && (
      <span class="chip fill border-encre! text-[13px]" style={`background: ${RISK_FILL[riskLevel]}`}>{t(RISK_LABEL_KEYS[riskLevel], locale)}</span>
    )}
  </PageHero>

  <main class="screen pt-5 md:pt-10">
    {fetchError && (
      <section class="section">
        <div class="naanaa" role="alert">
          <img src="/mascotte/naanaa-oups.webp" alt="" width="72" height="72" />
          <p class="bubble font-semibold">{fetchError}</p>
        </div>
      </section>
    )}

    {!fetchError && !additive && (
      <section class="section">
        <div class="naanaa">
          <img src="/mascotte/naanaa-oups.webp" alt="" width="72" height="72" />
          <p class="bubble"><b>{t('additive.notFound', locale)} ({id})</b><br />{t('additive.notFoundDesc', locale)}</p>
        </div>
        <a href="/additifs" class="btn w-max">{t('additive.back', locale)}</a>
      </section>
    )}

    {additive && (
      <>
        <!-- Points clés : niveau de risque + effet sur le score -->
        <section class="section md:grid-cols-2 md:gap-[18px]">
          <div class:list={['card grid content-start gap-2 p-4 md:p-5', RISK_BG[riskLevel]]}>
            <h2 class="disp d-m">{t(RISK_LABEL_KEYS[riskLevel], locale)}</h2>
            <p class="max-w-[68ch] text-[14.5px]">{t(RISK_DESC_KEYS[riskLevel], locale)}</p>
          </div>
          <div class="card grid content-start gap-2 p-4 md:p-5">
            <h2 class="disp d-m">{t('additive.scoreImpact', locale)}</h2>
            <p class="muted max-w-[68ch] text-[14.5px]">{t(RISK_IMPACT_KEYS[riskLevel], locale)}</p>
          </div>
        </section>

        {(description || sources.length > 0) && (
          <section class="section md:grid-cols-2 md:gap-[18px]">
            {description && (
              <div class="card grid content-start gap-2 p-4 md:p-5">
                <h2 class="disp d-m">{t('additive.description', locale)}</h2>
                <p class="muted max-w-[68ch] text-[14.5px] leading-relaxed">{description}</p>
              </div>
            )}
            {sources.length > 0 && (
              <div class="card grid content-start gap-3 p-4 md:p-5">
                <h2 class="disp d-m">{t('additive.sources', locale)}</h2>
                <ul class="grid gap-1.5">
                  {sources.map((source) => (
                    <li class="flex items-start gap-2 text-[13px]">
                      <svg class="mt-0.5 size-3.5 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" /></svg>
                      {source.url
                        ? <a href={source.url} target="_blank" rel="noopener noreferrer" class="min-w-0 break-words font-semibold text-brand-ink underline underline-offset-2">{source.label}</a>
                        : <span class="min-w-0 break-words">{source.label}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        )}

        <!-- Produits contenant cet additif (C8c) -->
        {products.length > 0 && (
          <section class="section">
            <div class="sec-head">
              <h2 class="disp d-m md:text-[26px]">{t('additive.productsWith', locale)} {id}</h2>
              <span class="muted text-[13px]">{productsCount} {t('search.results', locale)}</span>
            </div>
            <div class="grid gap-3 md:grid-cols-2 md:gap-[18px] lg:grid-cols-3">
              {products.map((product) => (
                <ProductCard product={product} locale={locale} />
              ))}
            </div>
          </section>
        )}
      </>
    )}
  </main>
</Layout>

---
// Page liste des additifs alimentaires (SSR — fetch API à chaque requête).
// Cartes « code · nom · description · puce de risque » (maquette FichePop),
// recherche et filtres en puces filtrés côté navigateur (script léger, sans île React).
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import { RISK_FILL, RISK_LABEL_KEYS } from '@/components/AdditiveTag.tsx'
import PageHero from '@/components/PageHero.astro'
import type { Additive, RiskLevel } from '@/lib/types'
import { getLocale, t } from '@/lib/i18n'

const localeCookie = Astro.cookies?.get('bayen_locale')?.value ?? null
const locale = getLocale(localeCookie)

const DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL ?? 'https://api.bayen.ma'

/** Additif avec ses traductions darija éventuelles */
type AdditiveAr = Additive & { name_ar?: string | null; function_ar?: string | null; description_ar?: string | null }
let additives: AdditiveAr[] = []

try {
  const res = await fetch(
    `${DIRECTUS_URL}/items/additives?sort=id&limit=-1&fields=id,name_fr,name_ar,function,function_ar,risk_level,description_fr,description_ar`,
    { signal: AbortSignal.timeout(5000) }
  )
  if (res.ok) {
    const data = await res.json()
    additives = data.data ?? []
  }
} catch {
  // Page s'affiche quand même sans données
}
// Trier par risque décroissant puis par code
const RISK_ORDER: RiskLevel[] = ['banned_ma', 'avoid', 'limited', 'safe']
const sortedAdditives = [...additives].sort((a, b) => {
  const rA = RISK_ORDER.indexOf(a.risk_level)
  const rB = RISK_ORDER.indexOf(b.risk_level)
  if (rA !== rB) return rA - rB
  return a.id.localeCompare(b.id)
})
const countBy = (r: RiskLevel) => additives.filter((a) => a.risk_level === r).length
const ar = locale === 'ary'
---

<Layout
  title="Additifs alimentaires E-xxx — Liste complète et risques Maroc | Bayen"
  description="Base de données complète des additifs alimentaires (E100 à E1000+) avec niveaux de risque pour le consommateur marocain. EFSA, CIRC, ONSSA."
  path="/additifs"
  mobileTopbar={false}
>
  <PageHero tone="tomate" mascot="loupe" kicker={t('nav.additives', locale)} title={t('additives.pageTitle', locale)} subtitle={t('additives.pageDesc', locale)}>
    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 2v7.5a2 2 0 0 1-.2.9L4.7 20.5a1 1 0 0 0 .9 1.5h12.8a1 1 0 0 0 .9-1.5l-5.1-10.1a2 2 0 0 1-.2-.9V2M8.5 2h7"/></svg>
  </PageHero>

  <main class="screen pt-5 md:pt-10">
    {additives.length > 0 ? (
      <>
        <!-- Recherche + filtres de risque (puces) -->
        <section class="section md:grid-cols-[minmax(0,1fr)_auto] md:items-center md:gap-x-8">
          <label for="add-q" class="card flex h-[50px] items-center gap-2.5 rounded-full px-4 shadow-[3px_3px_0_var(--color-hard)] md:max-w-[560px]">
            <svg class="size-5 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            <input id="add-q" type="search" placeholder={t('additives.search', locale)} aria-label={t('additives.search', locale)} class="w-0 min-w-0 flex-1 border-0 bg-transparent text-[14.5px] font-medium outline-none" />
          </label>
          <div class="chips" role="group" aria-label={t('additivesPage.filterAria', locale)}>
            <button type="button" class="chip h-9 px-3.5 text-[13px] aria-pressed:border-foreground aria-pressed:bg-foreground aria-pressed:text-background" data-risk-filter="all" aria-pressed="true">
              {t('additives.all', locale)} <span class="num opacity-70">{additives.length}</span>
            </button>
            {RISK_ORDER.map((r) => (
              <button type="button" class="chip h-9 px-3.5 text-[13px] aria-pressed:border-foreground aria-pressed:bg-foreground aria-pressed:text-background" data-risk-filter={r} aria-pressed="false">
                <span class="size-2.5 rounded-full border border-encre" style={`background: ${RISK_FILL[r]}`} />
                {t(RISK_LABEL_KEYS[r], locale)} <span class="num opacity-70">{countBy(r)}</span>
              </button>
            ))}
          </div>
        </section>

        <!-- Astuce : ce que chaque niveau retire au score (barème de scoring.ts) -->
        <section class="section">
          <div class="naanaa md:max-w-[760px]">
            <img src="/mascotte/naanaa-astuce.webp" alt="" width="72" height="72" loading="lazy" />
            <p class="bubble"><b>{t('home.tipTitle', locale)}</b><br />{t('additivesPage.tip', locale)} <a href="/methodologie" class="font-bold underline underline-offset-2">{t('additivesPage.seeMethod', locale)}</a></p>
          </div>
        </section>

        <section class="section">
          <div class="sec-head">
            <h2 class="disp d-m md:text-[26px]">{t('nav.additives', locale)}</h2>
            <span class="muted text-[13px]"><span id="add-count" class="num">{additives.length}</span> {t('additives.found', locale)}</span>
          </div>
          <div class="grid gap-3 md:grid-cols-2 md:gap-[18px] lg:grid-cols-3" id="add-list">
            {sortedAdditives.map((a) => (
              <a
                href={`/additifs/${a.id}`}
                class="card grid grid-cols-[minmax(0,1fr)_auto] items-center gap-3 p-4"
                data-additive
                data-risk={a.risk_level}
                data-search={[a.id, a.name_fr, a.function, a.name_ar ?? '', a.function_ar ?? ''].join(' ').toLowerCase()}
              >
                <div class="min-w-0">
                  <p><b>{a.id}</b> · {(ar && a.name_ar) || a.name_fr}</p>
                  <p class="muted mt-0.5 text-[12.5px] first-letter:uppercase">{(ar && a.function_ar) || a.function}</p>
                  {(a.description_fr || a.description_ar) && (
                    <p class="muted mt-1 line-clamp-2 text-[12.5px]">{(ar && a.description_ar) || a.description_fr}</p>
                  )}
                </div>
                <span class="chip fill" style={`background: ${RISK_FILL[a.risk_level]}`}>{t(RISK_LABEL_KEYS[a.risk_level], locale)}</span>
              </a>
            ))}
          </div>
          <div id="add-empty" class="naanaa" hidden>
            <img src="/mascotte/naanaa-loupe.webp" alt="" width="72" height="72" loading="lazy" />
            <p class="bubble">{t('additives.noResult', locale)}</p>
          </div>
        </section>
      </>
    ) : (
      <section class="section">
        <div class="naanaa">
          <img src="/mascotte/naanaa-oups.webp" alt="" width="72" height="72" />
          <p class="bubble">{t('additives.loadError', locale)}</p>
        </div>
      </section>
    )}
  </main>
</Layout>

<script>
  // Filtre côté navigateur : recherche texte + puce de risque (sans JS, tout reste listé)
  const input = document.getElementById('add-q') as HTMLInputElement | null
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-risk-filter]')
  const cards = document.querySelectorAll<HTMLElement>('[data-additive]')
  const count = document.getElementById('add-count')
  const empty = document.getElementById('add-empty')
  let risk = 'all'

  function apply(): void {
    const q = (input?.value ?? '').trim().toLowerCase()
    let n = 0
    cards.forEach((c) => {
      const ok = (risk === 'all' || c.dataset.risk === risk) && (!q || (c.dataset.search ?? '').includes(q))
      c.hidden = !ok
      if (ok) n++
    })
    if (count) count.textContent = String(n)
    if (empty) empty.hidden = n > 0
  }

  input?.addEventListener('input', apply)
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      risk = chip.dataset.riskFilter ?? 'all'
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)))
      apply()
    })
  })
</script>

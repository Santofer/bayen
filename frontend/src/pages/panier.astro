---
// Ma liste de courses — 100 % locale (localStorage)
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import Cart from '@/components/Cart.tsx'
import PageHero from '@/components/PageHero.astro'
import { getLocale, t } from '@/lib/i18n'

const localeCookie = Astro.cookies?.get('bayen_locale')?.value ?? null
const locale = getLocale(localeCookie)
---

<Layout
  title={`${t('cart.pageTitle', locale)} — Bayen`}
  description="Ta liste de courses Bayen : ajoute des produits, vois leur score, imprime-la ou envoie-la sur WhatsApp."
  path="/panier"
  noindex={true}
  mobileTopbar={false}
>
  <PageHero tone="primary" mascot="courses" back="/compte" kicker={t('nav.cart', locale)} title={t('cart.pageTitle', locale)} subtitle={t('cart.pageSubtitle', locale)} class="print:hidden">
    <svg slot="icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 11 4-7M19 11l-4-7M2 11h20M3.5 11l1.6 7.4a2 2 0 0 0 2 1.6h9.8a2 2 0 0 0 2-1.6l1.7-7.4"/></svg>
  </PageHero>
  <main class="screen max-md:pt-5">
    <Cart client:load />
  </main>
</Layout>

---
export const prerender = false
import Layout from '@/layouts/Layout.astro'
import PageHero from '@/components/PageHero.astro'
import OffImporter from '@/components/OffImporter'
import AuthGuard from '@/components/AuthGuard'
---

<Layout title="Importer depuis Open Food Facts — Bayen" path="/importer" noindex={true} mobileTopbar={false}>
  <PageHero
    tone="primary"
    mascot="courses"
    kicker="Open Food Facts"
    title="Importer un produit"
    subtitle="Saisissez un code-barres pour importer automatiquement le produit depuis Open Food Facts."
  />

  <main class="screen pt-5 md:pt-10">
    <section class="section">
      <AuthGuard client:load redirectPath="/importer">
        <OffImporter client:load />
      </AuthGuard>
    </section>
  </main>
</Layout>

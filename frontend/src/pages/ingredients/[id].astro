---
export const prerender = false
import Layout from '@/layouts/Layout.astro'
import PageHero from '@/components/PageHero.astro'
import ProductCard from '@/components/ProductCard.tsx'
import type { Product } from '@/lib/types'
import type { TranslationKey } from '@/lib/translations'
import { getLocale, t } from '@/lib/i18n'

const locale = getLocale(Astro.cookies?.get('bayen_locale')?.value ?? null)
const { id } = Astro.params
const DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL ?? 'https://api.bayen.ma'

interface Ingredient {
  id: number
  name_fr: string
  name_ar: string | null
  category: string
  is_allergen: boolean
  allergen_type: string | null
  icon: string
}

let ingredient: Ingredient | null = null
let products: Product[] = []
// Directus injoignable : 503 ; identifiant inconnu (Directus répond 403/404) : 404
let directusDown = false

// Identifiant non numérique : vraie 404 sans appel à Directus
if (!/^\d{1,9}$/.test(String(id ?? ''))) return Astro.rewrite('/404')

try {
  // Récupérer l'ingrédient
  const ingRes = await fetch(
    `${DIRECTUS_URL}/items/ingredients/${id}`,
    { signal: AbortSignal.timeout(5000) }
  )
  if (ingRes.ok) {
    const ingData = await ingRes.json()
    ingredient = ingData.data
  } else if (ingRes.status >= 500) {
    directusDown = true
  }

  // Récupérer les produits via la table de jonction
  if (ingredient) {
    const piRes = await fetch(
      `${DIRECTUS_URL}/items/products_ingredients?filter[ingredients_id][_eq]=${id}&fields=products_id.id,products_id.barcode,products_id.name_fr,products_id.brand,products_id.quantity,products_id.image_front,products_id.scan_score,products_id.score_label,products_id.nutriscore_grade,products_id.nova_group,products_id.additives,products_id.scan_count,products_id.status,percent,rank&limit=100&sort=rank`,
      { signal: AbortSignal.timeout(5000) }
    )
    if (piRes.ok) {
      const piData = await piRes.json()
      products = (piData.data ?? [])
        .filter((pi: Record<string, unknown>) => pi.products_id && (pi.products_id as Record<string, unknown>).status === 'published')
        .map((pi: Record<string, unknown>) => ({
          ...(pi.products_id as Product),
          _percent: pi.percent,
        }))
    }
  }
} catch {
  directusDown = true
}

if (directusDown) {
  Astro.response.status = 503
  Astro.response.headers.set('Retry-After', '300')
} else if (!ingredient) {
  Astro.response.status = 404
}

const name = ingredient
  ? (locale === 'ary' && ingredient.name_ar ? ingredient.name_ar : ingredient.name_fr)
  : `Ingrédient #${id}`

const categoryLabels: Record<string, string> = {
  cereale: t('ingPage.cat.cereale', locale),
  sucre: t('ingPage.cat.sucre', locale),
  graisse: t('ingPage.cat.graisse', locale),
  laitier: t('ingPage.cat.laitier', locale),
  proteine: t('ingPage.cat.proteine', locale),
  fruit_legume: t('ingPage.cat.fruit_legume', locale),
  sel: t('ingPage.cat.sel', locale),
  eau: t('ingPage.cat.eau', locale),
  arome: t('ingPage.cat.arome', locale),
  additif: t('ingPage.cat.additif', locale),
  autre: t('ingPage.cat.autre', locale),
}

// Précision affichée pour quelques allergènes majeurs
const ALLERGEN_NOTE: Record<string, TranslationKey> = {
  gluten: 'ingPage.allergen.gluten',
  lait: 'ingPage.allergen.lait',
  arachide: 'ingPage.allergen.arachide',
  soja: 'ingPage.allergen.soja',
}
const allergenNote = ingredient?.allergen_type ? ALLERGEN_NOTE[ingredient.allergen_type] : undefined

---

<Layout
  title={`${name} — Ingrédient alimentaire | Bayen`}
  description={`Tout savoir sur l'ingrédient ${name} : présence dans les produits marocains, allergènes, alternatives.`}
  path={`/ingredients/${id ?? ''}`}
  noindex={!ingredient}
  mobileTopbar={false}
>
  <PageHero
    tone="citron"
    mascot="loupe"
    back="/ingredients"
    kicker={t('nav.ingredients', locale)}
    title={ingredient ? ingredient.name_fr : directusDown ? t('seo.serviceDown', locale) : t('ingPage.notFound', locale)}
  >
    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 2v7.5a2 2 0 0 1-.2.9L4.7 20.5a1 1 0 0 0 .9 1.5h12.8a1 1 0 0 0 .9-1.5l-5.1-10.1a2 2 0 0 1-.2-.9V2M8.5 2h7"/></svg>
    {ingredient && (
      <div class="grid gap-2.5">
        {ingredient.name_ar && <p class="text-lg font-semibold" dir="rtl" lang="ar">{ingredient.name_ar}</p>}
        <div class="chips">
          <span class="chip">{categoryLabels[ingredient.category] ?? ingredient.category}</span>
          {ingredient.is_allergen && (
            <span class="chip fill border-encre! bg-tomate!">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
              {t('ingPage.allergen', locale)}{ingredient.allergen_type ? ` (${ingredient.allergen_type})` : ''}
            </span>
          )}
        </div>
      </div>
    )}
  </PageHero>

  <main class="screen pt-5 md:pt-10">
    {!ingredient ? (
      <section class="section">
        <div class="naanaa">
          <img src="/mascotte/naanaa-oups.webp" alt="" width="72" height="72" />
          <p class="bubble">{t('ingPage.notFound', locale)}.</p>
        </div>
        <a href="/ingredients" class="btn w-max">{t('ingPage.backToBase', locale)}</a>
      </section>
    ) : (
      <>
        {/* Point clé : allergène majeur */}
        {ingredient.is_allergen && (
          <section class="section">
            <div class="card grid grid-cols-[auto_minmax(0,1fr)] items-start gap-3 bg-tomate p-4 text-encre md:p-5">
              <svg class="mt-0.5 size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
              <p class="max-w-[68ch] text-[14.5px]">
                <strong>{t('ingPage.majorAllergen', locale)}</strong> — {t('ingPage.majorAllergenDesc', locale)}
                {allergenNote && ` ${t(allergenNote, locale)}`}
              </p>
            </div>
          </section>
        )}

        {/* Produits contenant cet ingrédient */}
        <section class="section">
          <div class="sec-head">
            <h2 class="disp d-m md:text-[26px]">{t('additive.productsWith', locale)} {name}</h2>
            <span class="muted text-[13px]">{products.length} {t('search.results', locale)}</span>
          </div>

          {products.length === 0 ? (
            <div class="naanaa">
              <img src="/mascotte/naanaa-scan.webp" alt="" width="72" height="72" loading="lazy" />
              <p class="bubble">
                {t('ingPage.noProducts', locale)}<br />
                <a href="/importer" class="font-bold underline underline-offset-2">{t('ingPage.importLink', locale)}</a>
              </p>
            </div>
          ) : (
            <div class="grid gap-3 md:grid-cols-2 md:gap-[18px] lg:grid-cols-3">
              {products.map((product) => (
                <ProductCard product={product} locale={locale} />
              ))}
            </div>
          )}
        </section>
      </>
    )}
  </main>
</Layout>

---
// Base d'ingrédients — hero, recherche et filtres (SSR, paramètres d'URL)
export const prerender = false
import Layout from '@/layouts/Layout.astro'
import PageHero from '@/components/PageHero.astro'
import { getLocale, t } from '@/lib/i18n'

const locale = getLocale(Astro.cookies?.get('bayen_locale')?.value ?? null)
const DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL ?? 'https://api.bayen.ma'

interface Ingredient {
  id: number
  name_fr: string
  name_ar: string | null
  category: string
  is_allergen: boolean
  allergen_type: string | null
  icon: string
}

const CATEGORIES: Record<string, string> = {
  cereale: t('ingPage.cats.cereale', locale),
  sucre: t('ingPage.cats.sucre', locale),
  graisse: t('ingPage.cats.graisse', locale),
  laitier: t('ingPage.cats.laitier', locale),
  proteine: t('ingPage.cats.proteine', locale),
  fruit_legume: t('ingPage.cats.fruit_legume', locale),
  sel: t('ingPage.cats.sel', locale),
  eau: t('ingPage.cats.eau', locale),
  arome: t('ingPage.cats.arome', locale),
  additif: t('ingPage.cats.additif', locale),
  autre: t('ingPage.cats.autre', locale),
}

const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 60)
const cat = Astro.url.searchParams.get('cat') ?? ''
const activeCat = cat in CATEGORIES ? cat : ''
const onlyAllergens = Astro.url.searchParams.get('allergenes') === '1'

let all: Ingredient[] = []
try {
  const res = await fetch(
    `${DIRECTUS_URL}/items/ingredients?sort=category,name_fr&limit=-1&fields=id,name_fr,name_ar,category,is_allergen,allergen_type,icon`,
    { signal: AbortSignal.timeout(5000) }
  )
  if (res.ok) all = (await res.json()).data ?? []
} catch { /* page servie vide */ }

const fold = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase()
const needle = fold(q)
const filtered = all.filter((i) =>
  (!activeCat || (CATEGORIES[i.category] ? i.category : 'autre') === activeCat)
  && (!onlyAllergens || i.is_allergen)
  && (!needle || fold(i.name_fr).includes(needle) || (i.name_ar ?? '').includes(q))
)
const allergenCount = all.filter((i) => i.is_allergen).length
const countBy = (key: string) => all.filter((i) => (CATEGORIES[i.category] ? i.category : 'autre') === key).length

// Regroupement par catégorie (ordre de CATEGORIES)
const groups = Object.entries(CATEGORIES)
  .map(([key, label]) => ({ key, label, items: filtered.filter((i) => (CATEGORIES[i.category] ? i.category : 'autre') === key) }))
  .filter((g) => g.items.length > 0)

const link = (params: Record<string, string>) => {
  const sp = new URLSearchParams()
  const merged = { q, cat: activeCat, allergenes: onlyAllergens ? '1' : '', ...params }
  for (const [k, v] of Object.entries(merged)) if (v) sp.set(k, v)
  const qs = sp.toString()
  return `/ingredients${qs ? `?${qs}` : ''}`
}
const hasFilter = Boolean(q || activeCat || onlyAllergens)
const name = (i: Ingredient) => (locale === 'ary' && i.name_ar ? i.name_ar : i.name_fr)
---

<Layout
  title="Base d'ingrédients alimentaires — Bayen Maroc"
  description="Tous les ingrédients alimentaires identifiés dans les produits du marché marocain : recherche, familles, allergènes, et les produits qui les contiennent."
  path="/ingredients"
  mobileTopbar={false}
>
  <PageHero tone="citron" mascot="loupe" kicker={t('nav.ingredients', locale)} title={t('ingPage.heroTitle', locale)} subtitle={t('ingPage.heroDesc', locale).replace('{n}', String(all.length)).replace('{a}', String(allergenCount))}>
    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 2v7.5a2 2 0 0 1-.2.9L4.7 20.5a1 1 0 0 0 .9 1.5h12.8a1 1 0 0 0 .9-1.5l-5.1-10.1a2 2 0 0 1-.2-.9V2M8.5 2h7"/></svg>
    <!-- Recherche (maquette Accueil : champ pilule + bouton) -->
    <form method="get" action="/ingredients" class="flex w-full max-w-xl gap-2">
      {activeCat && <input type="hidden" name="cat" value={activeCat} />}
      {onlyAllergens && <input type="hidden" name="allergenes" value="1" />}
      <label class="card flex h-[50px] min-w-0 flex-1 items-center gap-2.5 rounded-full px-4 shadow-[3px_3px_0_var(--color-hard)]">
        <svg class="size-5 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input type="search" name="q" value={q} placeholder={t('ingPage.searchPh', locale)} aria-label={t('ingPage.searchAria', locale)} class="w-0 min-w-0 flex-1 border-0 bg-transparent text-[14.5px] font-medium outline-none" />
      </label>
      <button type="submit" class="btn dark-btn min-h-[50px]">{t('nav.searchShort', locale)}</button>
    </form>
  </PageHero>

  <main class="screen pt-5 md:pt-10">
    <!-- Filtres : familles + allergènes (puces) -->
    <section class="section">
      <div class="chips">
        <a href={link({ cat: '' })} class:list={['chip h-9 px-3.5 text-[13px]', !activeCat && 'fill bg-citron']}>{t('blog.allCategories', locale)} <span class="num opacity-70">{all.length}</span></a>
        {Object.entries(CATEGORIES).filter(([k]) => countBy(k) > 0).map(([key, label]) => (
          <a href={link({ cat: key })} class:list={['chip h-9 px-3.5 text-[13px]', activeCat === key && 'fill bg-citron']}>
            {label} <span class="num opacity-70">{countBy(key)}</span>
          </a>
        ))}
        <a href={link({ allergenes: onlyAllergens ? '' : '1' })} aria-pressed={onlyAllergens ? 'true' : 'false'} class:list={['chip h-9 px-3.5 text-[13px]', onlyAllergens && 'fill bg-tomate']}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3ZM12 9v4M12 17h.01"/></svg>
          {t('ingPage.allergensOnly', locale)} <span class="num opacity-70">{allergenCount}</span>
        </a>
      </div>
      <div class="flex items-baseline justify-between gap-3">
        <p class="muted text-[13px]">
          {hasFilter ? `${filtered.length} ${t(filtered.length > 1 ? 'ingPage.ingredients' : 'ingPage.ingredient', locale)}` : `${all.length} ${t('ingPage.ingredients', locale)}`}{q && <> {t('ingPage.for', locale)} « <strong class="text-foreground">{q}</strong> »</>}
        </p>
        {hasFilter && <a href="/ingredients" class="text-[13px] font-bold underline underline-offset-[3px]">{t('ingPage.reset', locale)}</a>}
      </div>
    </section>

    {groups.length === 0 ? (
      <section class="section">
        <div class="naanaa">
          <img src="/mascotte/naanaa-loupe.webp" alt="" width="72" height="72" loading="lazy" />
          <p class="bubble"><b>{t('ingPage.emptyTitle', locale)}</b><br />{t('ingPage.emptyDesc', locale)}</p>
        </div>
      </section>
    ) : (
      groups.map((g) => (
        <section class="section">
          <div class="sec-head">
            <h2 class="disp d-m md:text-[26px]">{g.label}</h2>
            <span class="muted num text-[13px]">{g.items.length}</span>
          </div>
          <div class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-[18px] lg:grid-cols-4">
            {g.items.map((i) => (
              <a href={`/ingredients/${i.id}`} class="card flex min-w-0 items-center gap-3 p-2.5">
                <span class:list={['tile size-11 flex-none rounded-xl', i.is_allergen ? 'tint-tomate' : 'tint-citron']}>
                  {i.is_allergen
                    ? <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3ZM12 9v4M12 17h.01"/></svg>
                    : <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10ZM2 21c0-3 1.9-5.5 5-6.5"/></svg>}
                </span>
                <span class="min-w-0">
                  <span class="block truncate text-[14px] font-bold">{name(i)}</span>
                  <span class="muted block truncate text-[11.5px]">{i.is_allergen ? `${t('ingPage.allergen', locale)}${i.allergen_type ? ` · ${i.allergen_type}` : ''}` : g.label}</span>
                </span>
              </a>
            ))}
          </div>
        </section>
      ))
    )}
  </main>
</Layout>

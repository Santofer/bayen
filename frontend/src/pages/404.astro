---
// Page 404 — Naânaa « oups » et deux sorties (langage Marché Pop)
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import { getLocale, t } from '@/lib/i18n'

const locale = getLocale(Astro.cookies?.get('bayen_locale')?.value ?? null)
---

<Layout title="Page introuvable — Bayen" path={Astro.url.pathname} noindex={true}>
  <main class="screen pt-5 md:pt-10">
    <section class="section justify-items-center text-center md:grid-cols-[auto_minmax(0,460px)] md:justify-center md:gap-12 md:text-start">
      <img src="/mascotte/naanaa-oups.webp" alt="" width="150" height="221" class="naanaa-bob h-auto w-[150px] md:w-[200px]" />
      <div class="grid justify-items-center gap-3 md:justify-items-start">
        <span class="chip fill bg-citron">404</span>
        <h1 class="disp d-l md:text-[40px]">{t('error404.title', locale)}</h1>
        <p class="muted max-w-[40ch] text-[15px]">{t('error404.desc', locale)}</p>
        <div class="mt-3 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
          <a href="/scan" class="btn primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3" /><path d="M8 9v6M11 9v6M14 9v6M17 9v6" /></svg>
            {t('home.scanBtn', locale)}
          </a>
          <a href="/" class="btn">{t('nav.home', locale)}</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

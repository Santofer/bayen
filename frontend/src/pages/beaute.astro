---
// Univers beauté (C23) — page d'entrée : recherche cosmétiques + méthode
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import SearchPage from '@/components/SearchPage'
import PageHero from '@/components/PageHero.astro'
import { getLocale, t } from '@/lib/i18n'

const locale = getLocale(Astro.cookies?.get('bayen_locale')?.value ?? null)
const CATS = ['visage', 'corps', 'cheveux', 'hygiene', 'dents', 'maquillage', 'parfum', 'solaire', 'bebe', 'homme', 'eclaircissant', 'ongles'] as const
const cat = Astro.url.searchParams.get('cat') ?? ''
const initialCat = (CATS as readonly string[]).includes(cat) ? cat : ''
// Libellés calculés ici : un cast générique dans le JSX Astro fait trébucher le parseur
const catLabels: Record<string, string> = Object.fromEntries(
  CATS.map((c) => [c, t(`beauty.cat.${c}` as Parameters<typeof t>[0], locale)])
)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Cosmétiques et hygiène au Maroc — score beauté Bayen',
  description: t('beauty.hubDesc', locale),
  url: 'https://bayen.ma/beaute',
}
---

<Layout
  title="Cosmétiques et hygiène au Maroc — score beauté | Bayen"
  description="Crèmes, shampooings, savons, dentifrices, maquillage vendus au Maroc : Bayen lit la liste INCI et repère perturbateurs endocriniens, allergènes et substances interdites."
  path="/beaute"
  jsonLd={jsonLd}
  universe="beauty"
>
  <main>
    <section class="mx-auto max-w-5xl px-4 pt-8 pb-2">
      <PageHero image="/hero/beaute.jpg" tone="beauty" mascot="loupe" size="lg" kicker={t('nav.beauty', locale)} title={t('beauty.hubTitle', locale)} subtitle={t('beauty.hubDesc', locale)}>
        <svg slot="icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
        {/* Catégories : pastilles crème sur l'aplat framboise, l'active passe à l'encre */}
        <div class="mt-2 flex flex-wrap gap-2">
          {CATS.map((c) => (
            <a
              href={`/beaute?cat=${c}`}
              class:list={['rounded-full border-[1.5px] border-encre px-3.5 py-1.5 text-sm font-semibold transition-colors', initialCat === c ? 'bg-encre text-creme' : 'bg-creme text-encre hover:bg-citron']}
            >
              {catLabels[c]}
            </a>
          ))}
        </div>
      </PageHero>
    </section>

    <SearchPage client:load initialUniverse="cosmetic" initialCosmeticCategory={initialCat} />

    <section class="mx-auto max-w-5xl px-4 pb-16">
      <div class="rounded-3xl border bg-card p-6 sm:p-8">
        <h2 class="font-display text-xl font-bold">{t('beauty.howTitle', locale)}</h2>
        <ol class="mt-4 space-y-3 text-[15px] leading-relaxed text-foreground/90">
          <li class="flex gap-3"><span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-beauty border-2 border-encre text-sm font-bold text-encre">1</span><span>{t('beauty.how1', locale)}</span></li>
          <li class="flex gap-3"><span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-beauty border-2 border-encre text-sm font-bold text-encre">2</span><span>{t('beauty.how2', locale)}</span></li>
          <li class="flex gap-3"><span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-beauty border-2 border-encre text-sm font-bold text-encre">3</span><span>{t('beauty.how3', locale)}</span></li>
        </ol>
        <p class="mt-4 text-xs text-muted-foreground">{t('beauty.disclaimer', locale)}</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/ingredients-cosmetiques" class="btn-pop ghost">
            {t('beauty.ingredientsTitle', locale)} →
          </a>
          <a href="/contribuer" class="btn-pop">
            {t('nav.contribute', locale)}
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

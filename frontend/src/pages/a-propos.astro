---
// Page "À propos" — fonde la crédibilité E-E-A-T (Experience, Expertise,
// Authoritativeness, Trustworthiness) requise par Google sur les sujets YMYL
// (Your Money Your Life — la santé/nutrition en fait partie).
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import PageHero from '@/components/PageHero.astro'
import { getLocale, t } from '@/lib/i18n'

const localeCookie = Astro.cookies?.get('bayen_locale')?.value ?? null
const locale = getLocale(localeCookie)

const SITE_URL = 'https://bayen.ma'
const DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL ?? 'https://api.bayen.ma'

// Date réelle de la dernière fiche produit modifiée (crons nocturnes, contributions) ; rien si l'API ne répond pas
const lastData = await fetch(`${DIRECTUS_URL}/items/products?sort=-date_updated&limit=1&fields=date_updated&filter[status][_eq]=published&filter[date_updated][_nnull]=true`, { signal: AbortSignal.timeout(3000) })
  .then((r) => (r.ok ? r.json() : null))
  .then((j: { data?: Array<{ date_updated: string | null }> } | null) => j?.data?.[0]?.date_updated ?? null)
  .catch(() => null)
const lastDataLabel = lastData
  ? t('about.dataUpdated', locale).replace('{date}', new Date(lastData).toLocaleDateString(locale === 'ary' ? 'ar-MA' : 'fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }))
  : null

// Section éditoriale : titre à gauche, texte (≤ 68ch) à droite sur ordinateur
const ED = 'section md:grid-cols-[minmax(0,1fr)_minmax(0,2.2fr)] md:items-start md:gap-x-12'
const LINK = 'font-semibold text-brand-ink underline underline-offset-2'

// Engagements : cartes teintées (gèrent le mode sombre)
const ENGAGEMENTS = [
  { t: t('about.c1Title', locale), d: t('about.c1Desc', locale), tint: 'tint-menthe' },
  { t: t('about.c2Title', locale), d: t('about.c2Desc', locale), tint: 'tint-citron' },
  { t: t('about.c3Title', locale), d: t('about.c3Desc', locale), tint: 'tint-framboise' },
  { t: t('about.c4Title', locale), d: t('about.c4Desc', locale), tint: 'tint-myrtille' },
  { t: t('about.c5Title', locale), d: t('about.c5Desc', locale), tint: 'tint-figue' },
  { t: t('about.c6Title', locale), d: t('about.c6Desc', locale), tint: 'tint-creme' },
]

// JSON-LD AboutPage + BreadcrumbList
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    url: `${SITE_URL}/a-propos`,
    name: 'À propos de Bayen',
    description: "Qui est derrière Bayen, comment on travaille, et pourquoi on rend la nutrition transparente au Maroc.",
    inLanguage: locale === 'ary' ? 'ar-MA' : 'fr-MA',
    isPartOf: { '@id': `${SITE_URL}/#website` },
    about: { '@id': `${SITE_URL}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'À propos', item: `${SITE_URL}/a-propos` },
    ],
  },
]
---

<Layout
  title={t('seo.about.title', locale)}
  description={t('seo.about.desc', locale)}
  path="/a-propos"
  jsonLd={jsonLd}
  mobileTopbar={false}
>
  <PageHero
    tone="framboise"
    mascot="salut"
    kicker={t('about.kicker', locale)}
    title={t('about.heroTitle', locale)}
    subtitle={t('about.heroDesc', locale)}
  />

  <main class="screen pt-5 md:pt-10">
    <section class={ED}>
      <h2 class="disp d-m md:text-[26px]">{t('about.whyTitle', locale)}</h2>
      <div class="grid max-w-[68ch] gap-3 text-[15px] leading-relaxed">
        <p>{t('about.whyP1', locale)}</p>
        <p>
          {t('about.whyP2a', locale)}<strong>{t('about.whyP2b', locale)}</strong>{t('about.whyP2c', locale)}
        </p>
      </div>
    </section>

    <section class={ED}>
      <h2 class="disp d-m md:text-[26px]">{t('about.whoTitle', locale)}</h2>
      <div class="grid max-w-[68ch] gap-3 text-[15px] leading-relaxed">
        <p>
          {t('about.whoP1a', locale)}<a href="https://n0.ma" class={LINK}>N0</a>{t('about.whoP1b', locale)}<a href="https://netspace.ma" class={LINK}>Netspace</a>{t('about.whoP1c', locale)}
        </p>
        <p>
          {t('about.whoP2a', locale)}<strong>{t('about.whoP2b', locale)}</strong>{t('about.whoP2c', locale)}<a href="https://github.com/Santofer/bayen" target="_blank" rel="noopener noreferrer" class={LINK}>github.com/Santofer/bayen</a>{t('about.whoP2d', locale)}
        </p>
      </div>
    </section>

    <section class={ED}>
      <h2 class="disp d-m md:text-[26px]">{t('about.sourcesTitle', locale)}</h2>
      <div class="grid max-w-[68ch] grid-cols-[minmax(0,1fr)] gap-3">
        <p class="text-[15px] leading-relaxed">{t('about.sourcesIntro', locale)}</p>
        <ul class="card overflow-hidden text-[14px] leading-relaxed">
          <li class="border-b-[1.5px] border-line px-4 py-3"><a href="https://world.openfoodfacts.org" target="_blank" rel="noopener noreferrer" class={LINK}>Open Food Facts</a>{t('about.srcOff', locale)}</li>
          <li class="border-b-[1.5px] border-line px-4 py-3">{t('about.srcCommunity', locale)}</li>
          <li class="border-b-[1.5px] border-line px-4 py-3">{t('about.srcNutriA', locale)}<strong>{t('about.srcNutriB', locale)}</strong>{t('about.srcNutriC', locale)}</li>
          <li class="border-b-[1.5px] border-line px-4 py-3">{t('about.srcNovaA', locale)}<strong>{t('about.srcNovaB', locale)}</strong>{t('about.srcNovaC', locale)}</li>
          <li class="px-4 py-3">{t('about.srcAddA', locale)}<strong>{t('about.srcAddB', locale)}</strong>{t('about.srcAddC', locale)}<strong>CIRC</strong>{t('about.srcAddD', locale)}</li>
        </ul>
        <!-- justify-self-start (pas w-max) : le bouton passe à la ligne au lieu d'élargir la grille sur mobile -->
        <a href="/methodologie" class="btn justify-self-start text-center">{t('about.readMethod', locale)}</a>
      </div>
    </section>

    <section class="section">
      <div class="sec-head"><h2 class="disp d-m md:text-[26px]">{t('about.commitTitle', locale)}</h2></div>
      <div class="grid gap-3 sm:grid-cols-2 md:grid-cols-3 md:gap-[18px]">
        {ENGAGEMENTS.map((e) => (
          <div class:list={['card grid content-start gap-3 p-4', e.tint]}>
            <span class="grid size-9 place-items-center rounded-full border-2 border-encre bg-menthe text-encre" aria-hidden="true">
              <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10" /></svg>
            </span>
            <p class="text-[14px] leading-relaxed"><b class="disp d-s block">{e.t}</b>{e.d}</p>
          </div>
        ))}
      </div>
    </section>

    <section class={ED}>
      <h2 class="disp d-m md:text-[26px]">{t('about.limitsTitle', locale)}</h2>
      <div class="grid max-w-[68ch] gap-3">
        <div class="naanaa">
          <img src="/mascotte/naanaa-astuce.webp" alt="" width="72" height="72" loading="lazy" />
          <p class="bubble">{t('about.limitsA', locale)}<em>{t('about.limitsB', locale)}</em>{t('about.limitsC', locale)}</p>
        </div>
        <ul class="card overflow-hidden text-[14px] leading-relaxed">
          <li class="border-b-[1.5px] border-line px-4 py-3"><strong>{t('about.l1Title', locale)}</strong>{t('about.l1Desc', locale)}</li>
          <li class="border-b-[1.5px] border-line px-4 py-3"><strong>{t('about.l2Title', locale)}</strong>{t('about.l2Desc', locale)}</li>
          <li class="border-b-[1.5px] border-line px-4 py-3"><strong>{t('about.l3Title', locale)}</strong>{t('about.l3Desc', locale)}</li>
          <li class="px-4 py-3"><strong>{t('about.l4Title', locale)}</strong>{t('about.l4Desc', locale)}</li>
        </ul>
      </div>
    </section>

    <section class={ED}>
      <h2 class="disp d-m md:text-[26px]">{t('about.contactTitle', locale)}</h2>
      <div class="grid max-w-[68ch] gap-3">
        <p class="text-[15px] leading-relaxed">{t('about.contactIntro', locale)}</p>
        <div class="grid gap-3 sm:grid-cols-3">
          <a href="/contribuer" class="card grid content-start gap-1 p-4 text-[13.5px]"><b class="disp d-s">{t('about.addTitle', locale)}</b>{t('about.addDesc', locale)}</a>
          <a href="https://github.com/Santofer/bayen/issues" target="_blank" rel="noopener noreferrer" class="card grid content-start gap-1 p-4 text-[13.5px]"><b class="disp d-s">{t('about.bugTitle', locale)}</b>{t('about.bugDesc', locale)}</a>
          <a href="mailto:contact@n0.ma" class="card grid content-start gap-1 p-4 text-[13.5px]"><b class="disp d-s">{t('about.writeTitle', locale)}</b>contact@n0.ma{t('about.writeDesc', locale)}</a>
        </div>
      </div>
    </section>

    <p class="section muted text-center text-xs">
      {lastDataLabel && <>{lastDataLabel} · </>}{t('about.updated', locale)}
    </p>
  </main>
</Layout>

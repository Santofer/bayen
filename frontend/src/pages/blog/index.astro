---
// Page listing du blog — SSR (données fraîches à chaque requête)
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import BlogCard from '@/components/BlogCard.tsx'
import PageHero from '@/components/PageHero.astro'
import { withLocalCover } from '@/lib/blog-covers'
import type { TranslationKey } from '@/lib/translations'
import { getLocale, t } from '@/lib/i18n'
import type { Article, ArticleCategory } from '@/lib/types'

const localeCookie = Astro.cookies?.get('bayen_locale')?.value ?? null
const locale = getLocale(localeCookie)

const DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL ?? 'https://api.bayen.ma'

// Filtre catégorie optionnel via query param
const requestedCategory = Astro.url.searchParams.get('cat')
const VALID_CATEGORIES: ArticleCategory[] = ['bien-etre', 'habitudes', 'guides', 'actualites']
const selectedCategory: ArticleCategory | null = VALID_CATEGORIES.includes(requestedCategory as ArticleCategory)
  ? (requestedCategory as ArticleCategory)
  : null

// Fetch articles publiés
let articles: Article[] = []
try {
  const filterJson = selectedCategory
    ? `{"_and":[{"status":{"_eq":"published"}},{"category":{"_eq":"${selectedCategory}"}}]}`
    : `{"status":{"_eq":"published"}}`
  const url = `${DIRECTUS_URL}/items/articles?filter=${encodeURIComponent(filterJson)}&sort=-date_published&limit=60&fields=id,slug,title_fr,title_ar,excerpt_fr,excerpt_ar,cover_image,category,reading_time_min,date_published,date_created`
  const res = await fetch(url, { signal: AbortSignal.timeout(5000) })
  if (res.ok) {
    const data = await res.json()
    articles = ((data.data ?? []) as Article[]).map((a) => withLocalCover(a, Astro.url))
  }
} catch {
  // Page s'affiche quand même
}

// Article vedette (maquette v2) : le plus récent, en cover pleine largeur.
// Uniquement sur la vue non filtrée pour garder les listes par catégorie denses.
const CDN_URL = import.meta.env.PUBLIC_CDN_URL ?? 'https://api.bayen.ma/assets'
const FALLBACK_COVER: Record<ArticleCategory, string> = {
  'bien-etre': '/blog/fallback-bien-etre.jpg',
  habitudes: '/blog/fallback-habitudes.jpg',
  guides: '/blog/fallback-guides.jpg',
  actualites: '/blog/fallback-actualites.jpg',
}
const featured = !selectedCategory && articles.length > 0 ? articles[0] : null
const gridArticles = featured ? articles.slice(1) : articles
// Couverture : visuel local Marché Pop (déjà posé par withLocalCover), sinon image Directus, sinon secours
const featuredCover = featured
  ? (featured.cover_image
      ? (featured.cover_image.startsWith('http') ? featured.cover_image : `${CDN_URL}/${featured.cover_image}`)
      : FALLBACK_COVER[featured.category])
  : null
const featuredTitle = featured ? ((locale === 'ary' && featured.title_ar) || featured.title_fr) : null

// Catégories en aplats Marché Pop (texte encre posé dessus)
const CATEGORIES: Array<{ value: ArticleCategory | null; labelKey: TranslationKey; color: string }> = [
  { value: null,          labelKey: 'blog.allCategories',       color: 'var(--color-figue)' },
  { value: 'bien-etre',   labelKey: 'blog.category.bien-etre',  color: 'var(--color-framboise)' },
  { value: 'habitudes',   labelKey: 'blog.category.habitudes',  color: 'var(--color-menthe)' },
  { value: 'guides',      labelKey: 'blog.category.guides',     color: 'var(--color-citron)' },
  { value: 'actualites',  labelKey: 'blog.category.actualites', color: 'var(--color-myrtille)' },
]
const featuredColor = featured ? CATEGORIES.find((c) => c.value === featured.category)?.color ?? 'var(--color-citron)' : null

// JSON-LD : Blog + BreadcrumbList + ItemList (les 10 articles les plus récents)
const SITE_URL = 'https://bayen.ma'
const blogJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': `${SITE_URL}/blog#blog`,
    url: `${SITE_URL}/blog`,
    name: 'Le blog Bayen',
    description: "Bien-être, habitudes de consommation et réflexe Bayen au Maroc.",
    inLanguage: ['fr-MA', 'ar-MA'],
    publisher: { '@id': `${SITE_URL}/#organization` },
    blogPost: articles.slice(0, 10).map((a) => ({
      '@type': 'BlogPosting',
      headline: a.title_fr,
      url: `${SITE_URL}/blog/${a.slug}`,
      datePublished: a.date_published ?? a.date_created,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog` },
    ],
  },
]
---

<Layout
  title={`${t('blog.title', locale)} — Bayen`}
  description={t('blog.description', locale)}
  path="/blog"
  jsonLd={blogJsonLd}
>
  <main class="section-v2 py-6 pb-24 md:pb-12">
    {/* En-tête éditorial : aplat citron (maquette Blog) */}
    <PageHero image="/hero/journal.jpg" tone="citron" kicker={t('blog.kicker', locale)} title={`${t('blog.heroTitle1', locale)} ${t('blog.heroTitle2', locale)}`} subtitle={t('blog.description', locale)} class="mb-7">
      <svg slot="icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
    </PageHero>

    {/* Filtres par catégorie — pills cliquables */}
    <nav class="flex flex-wrap gap-2 mb-8" aria-label="Filtres catégories">
      {CATEGORIES.map((cat) => {
        const isActive = cat.value === selectedCategory
        const href = cat.value ? `/blog?cat=${cat.value}` : '/blog'
        return (
          <a
            href={href}
            class:list={[
              'px-3 py-1.5 rounded-full text-xs font-semibold border-[1.5px] transition-colors',
              isActive
                ? 'border-encre text-encre shadow-[2px_2px_0_var(--color-hard)]'
                : 'bg-card border-line text-foreground hover:bg-muted',
            ]}
            style={isActive ? `background-color: ${cat.color}` : undefined}
          >
            {t(cat.labelKey, locale)}
          </a>
        )
      })}
    </nav>

    {/* Article vedette pleine largeur (maquette v2) */}
    {featured && featuredCover && (
      <a href={`/blog/${featured.slug}`} class="card-lift mb-8 grid overflow-hidden rounded-3xl border-2 border-line bg-card shadow-[var(--shadow-card)] md:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)]">
        {/* Couverture 16:9 à contour encre */}
        <img src={featuredCover} alt={featuredTitle ?? ''} loading="eager" class="aspect-video w-full object-cover border-b-2 border-line md:border-b-0 md:border-e-2" />
        <div class="flex flex-col justify-center gap-3 p-5 sm:p-7">
          <span class="self-start rounded-full border-[1.5px] border-encre px-3 py-1 text-[0.68rem] font-extrabold uppercase tracking-[0.06em] text-encre" style={`background-color: ${featuredColor}`}>
            {t(`blog.category.${featured.category}`, locale)}
          </span>
          <h2 class="leading-tight">{featuredTitle}</h2>
          {featured.reading_time_min && (
            <p class="text-sm text-muted-foreground">{featured.reading_time_min} {t('blog.readingTimeMin', locale)}</p>
          )}
        </div>
      </a>
    )}

    {/* Grille des articles */}
    {gridArticles.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {gridArticles.map((article) => (
          <BlogCard article={article} locale={locale} />
        ))}
      </div>
    ) : !featured ? (
      <div class="rounded-xl border bg-card p-12 text-center text-muted-foreground">
        <img src="/mascotte/naanaa-nuit.webp" alt="" width="88" height="130" class="mx-auto mb-3" loading="lazy" />
        <p>{t('blog.empty', locale)}</p>
      </div>
    ) : null}
  </main>
</Layout>

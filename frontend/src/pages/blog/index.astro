---
// Page listing du blog — SSR (données fraîches à chaque requête)
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import BlogCard from '@/components/BlogCard.tsx'
import { withLocalCover } from '@/lib/blog-covers'
import type { TranslationKey } from '@/lib/translations'
import { getLocale, t } from '@/lib/i18n'
import type { Article, ArticleCategory } from '@/lib/types'

const localeCookie = Astro.cookies?.get('bayen_locale')?.value ?? null
const locale = getLocale(localeCookie)

const DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL ?? 'https://api.bayen.ma'

// Filtre catégorie optionnel via query param
const requestedCategory = Astro.url.searchParams.get('cat')
const VALID_CATEGORIES: ArticleCategory[] = ['bien-etre', 'habitudes', 'guides', 'actualites']
const selectedCategory: ArticleCategory | null = VALID_CATEGORIES.includes(requestedCategory as ArticleCategory)
  ? (requestedCategory as ArticleCategory)
  : null

// Fetch articles publiés
let articles: Article[] = []
try {
  const filterJson = selectedCategory
    ? `{"_and":[{"status":{"_eq":"published"}},{"category":{"_eq":"${selectedCategory}"}}]}`
    : `{"status":{"_eq":"published"}}`
  const url = `${DIRECTUS_URL}/items/articles?filter=${encodeURIComponent(filterJson)}&sort=-date_published&limit=60&fields=id,slug,title_fr,title_ar,excerpt_fr,excerpt_ar,cover_image,category,reading_time_min,date_published,date_created`
  const res = await fetch(url, { signal: AbortSignal.timeout(5000) })
  if (res.ok) {
    const data = await res.json()
    articles = ((data.data ?? []) as Article[]).map((a) => withLocalCover(a, Astro.url))
  }
} catch {
  // Page s'affiche quand même
}

// Article mis en avant (maquette Blog) : le plus récent, uniquement sur la vue
// non filtrée pour garder les listes par catégorie denses.
const featured = !selectedCategory && articles.length > 0 ? articles[0] : null
const listArticles = featured ? articles.slice(1) : articles

// Puces de catégories (maquette : « Tout » actif en menthe)
const CATEGORIES: Array<{ value: ArticleCategory | null; labelKey: TranslationKey }> = [
  { value: null, labelKey: 'blog.allShort' },
  { value: 'bien-etre', labelKey: 'blog.category.bien-etre' },
  { value: 'habitudes', labelKey: 'blog.category.habitudes' },
  { value: 'guides', labelKey: 'blog.category.guides' },
  { value: 'actualites', labelKey: 'blog.category.actualites' },
]
const heading = t('blog.listHeading', locale)

// JSON-LD : Blog + BreadcrumbList + ItemList (les 10 articles les plus récents)
const SITE_URL = 'https://bayen.ma'
const blogJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': `${SITE_URL}/blog#blog`,
    url: `${SITE_URL}/blog`,
    name: t('blog.title', 'fr'),
    description: t('blog.description', 'fr'),
    inLanguage: 'fr-MA',
    publisher: { '@id': `${SITE_URL}/#organization` },
    blogPost: articles.slice(0, 10).map((a) => ({
      '@type': 'BlogPosting',
      headline: a.title_fr,
      url: `${SITE_URL}/blog/${a.slug}`,
      datePublished: a.date_published ?? a.date_created,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Journal', item: `${SITE_URL}/blog` },
    ],
  },
]
---

<Layout
  title={t('blog.title', locale)}
  description={t('blog.description', locale)}
  path="/blog"
  jsonLd={blogJsonLd}
>
  {/* Barre du haut mobile (maquette) : logo + puce « Le journal » */}
  <span slot="topbar-end" class="chip">{t('nav.journalBlog', locale)}</span>

  <main class="screen gap-5 max-md:pt-5 md:gap-12">
    <section class="section gap-2.5 md:gap-4">
      <h1 class="disp d-xl md:max-w-[20ch] md:text-[clamp(40px,4.4vw,60px)]">{heading}</h1>
      <p class="muted max-w-[68ch] text-[15px] leading-relaxed md:text-base">{t('blog.intro', locale)}</p>
      <nav class="chips" aria-label={t('blog.filterAria', locale)}>
        {CATEGORIES.map((cat) => {
          const isActive = cat.value === selectedCategory
          return (
            <a
              href={cat.value ? `/blog?cat=${cat.value}` : '/blog'}
              class:list={['chip', isActive && 'fill bg-menthe']}
              aria-current={isActive ? 'page' : undefined}
            >
              {t(cat.labelKey, locale)}
            </a>
          )
        })}
      </nav>
    </section>

    {featured && (
      <section class="section">
        <BlogCard article={featured} locale={locale} variant="featured" />
      </section>
    )}

    {listArticles.length > 0 ? (
      <section class="section gap-3.5 md:grid-cols-3 md:gap-6">
        {listArticles.map((article) => (
          <BlogCard article={article} locale={locale} />
        ))}
      </section>
    ) : !featured ? (
      <section class="section">
        <div class="card grid justify-items-center gap-3 p-10 text-center">
          <img src="/mascotte/naanaa-nuit.webp" alt="" width="88" height="130" loading="lazy" />
          <p class="muted">{t('blog.empty', locale)}</p>
        </div>
      </section>
    ) : null}
  </main>
</Layout>

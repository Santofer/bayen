---
// Page détail article du blog — SSR
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import BlogCard, { BLOG_CATEGORY_FILL, blogCategoryLabel, formatBlogDate } from '@/components/BlogCard.tsx'
import { getLocale, t } from '@/lib/i18n'
import type { Article, ArticleCategory } from '@/lib/types'
import { marked } from 'marked'
import { localCover, withLocalCover } from '@/lib/blog-covers'

const locale = getLocale(Astro.cookies?.get('bayen_locale')?.value ?? null)
const { slug } = Astro.params
const DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL ?? 'https://api.bayen.ma'
const CDN_URL = import.meta.env.PUBLIC_CDN_URL ?? 'https://api.bayen.ma/assets'

// Fetch article par slug
let article: Article | null = null
try {
  const res = await fetch(
    `${DIRECTUS_URL}/items/articles?filter[slug][_eq]=${encodeURIComponent(slug ?? '')}&filter[status][_eq]=published&limit=1`,
    { signal: AbortSignal.timeout(5000) }
  )
  if (res.ok) {
    const data = await res.json()
    article = ((data.data ?? [])[0] as Article) ?? null
  }
} catch {
  // Page 404 s'affichera ci-dessous
}

// Articles similaires (même catégorie, hors article courant)
let relatedArticles: Article[] = []
if (article) {
  try {
    const url = `${DIRECTUS_URL}/items/articles?filter[status][_eq]=published&filter[category][_eq]=${article.category}&filter[id][_neq]=${article.id}&sort=-date_published&limit=3&fields=id,slug,title_fr,title_ar,excerpt_fr,excerpt_ar,cover_image,category,reading_time_min,date_published`
    const res = await fetch(url, { signal: AbortSignal.timeout(3000) })
    if (res.ok) {
      const data = await res.json()
      relatedArticles = ((data.data ?? []) as Article[]).map((a) => withLocalCover(a, Astro.url))
    }
  } catch {
    // non bloquant
  }
}

// Données d'affichage
const title = article
  ? (locale === 'ary' && article.title_ar) || article.title_fr
  : null
const excerpt = article
  ? (locale === 'ary' && article.excerpt_ar) || article.excerpt_fr
  : null
const contentRaw = article
  ? (locale === 'ary' && article.content_ar) || article.content_fr
  : ''

// Markdown → HTML (marked 18 safe par défaut, on ne fait pas confiance à l'input
// mais le contenu vient de l'admin Directus authentifié donc c'est OK)
let contentHtml = ''
if (contentRaw) {
  const result = marked.parse(contentRaw, { async: false, breaks: true, gfm: true })
  contentHtml = typeof result === 'string' ? result : ''
}

// Cover : visuel local Marché Pop (/blog/covers/<slug>.webp), sinon image Directus,
// sinon visuel de secours par catégorie (cohérent BlogCard). Absolue pour og:image.
const localCoverPath = article ? localCover(article.slug) : null
const coverUrl = localCoverPath
  ? new URL(localCoverPath, Astro.url).href
  : article?.cover_image
    ? article.cover_image.startsWith('http')
      ? article.cover_image
      : `${CDN_URL}/${article.cover_image}`
    : article
      ? `/blog/fallback-${article.category}.jpg`
      : null

const dateStr = article ? formatBlogDate(article.date_published ?? article.date_created, locale) : ''
const dateUpdatedStr = article?.date_updated && article.date_updated !== article.date_published
  ? formatBlogDate(article.date_updated, locale)
  : ''

const pageTitle = article ? `${title} — Bayen` : `${t('blog.notFound', locale)} — Bayen`
const metaDescription = excerpt ?? t('blog.description', locale)
const ogImage = coverUrl ?? undefined

// JSON-LD : BlogPosting + BreadcrumbList
const SITE_URL = 'https://bayen.ma'
const articleContentFr: string = (article?.content_fr as string | undefined) ?? ''
const wordCount = articleContentFr ? articleContentFr.split(/\s+/).filter(Boolean).length : undefined

const jsonLd = article
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description: excerpt,
        image: coverUrl ? [coverUrl] : [`${SITE_URL}/og-default.png`],
        datePublished: article.date_published ?? article.date_created,
        dateModified: article.date_updated ?? article.date_published ?? article.date_created,
        wordCount,
        timeRequired: article.reading_time_min ? `PT${article.reading_time_min}M` : undefined,
        articleSection: blogCategoryLabel(article.category as ArticleCategory, 'fr'),
        inLanguage: locale === 'ary' ? 'ar-MA' : 'fr-MA',
        author: {
          '@type': 'Person',
          name: 'Amine Benboubker',
          url: 'https://aminebenboubker.com',
          image: `${SITE_URL}/avatar-amine.webp`,
          sameAs: ['https://aminebenboubker.com', 'https://www.n0.ma'],
          affiliation: { '@type': 'Organization', name: 'Bayen' },
        },
        publisher: {
          '@type': 'Organization',
          name: 'Bayen',
          logo: { '@type': 'ImageObject', url: `${SITE_URL}/icons/icon-512.png` },
        },
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': `${SITE_URL}/blog/${article.slug}`,
        },
        url: `${SITE_URL}/blog/${article.slug}`,
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE_URL },
          { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog` },
          { '@type': 'ListItem', position: 3, name: title, item: `${SITE_URL}/blog/${article.slug}` },
        ],
      },
    ]
  : undefined
---

<Layout
  title={pageTitle}
  description={metaDescription}
  path={`/blog/${slug ?? ''}`}
  ogImage={ogImage}
  ogType="article"
  jsonLd={jsonLd}
  noindex={!article}
  mobileTopbar={false}
>
  <main class="screen gap-5 md:gap-10">
    {/* Barre du haut mobile : retour au journal + puce */}
    <header class="topbar md:hidden">
      <a class="icon-btn" href="/blog" aria-label={t('nav.back', locale)}>
        <svg class="rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
      </a>
      <span class="chip">{t('nav.journalBlog', locale)}</span>
    </header>
    <div class="section hidden md:grid">
      <a href="/blog" class="w-max text-sm font-semibold underline underline-offset-4">{t('blog.back', locale)}</a>
    </div>

    {!article ? (
      <section class="section">
        <div class="card grid justify-items-center gap-3 p-8 text-center md:p-12">
          <img src="/mascotte/naanaa-oups.webp" alt="" width="100" height="148" class="naanaa-bob" />
          <h1 class="disp d-l">{t('blog.notFound', locale)}</h1>
          <p class="muted max-w-md text-sm">{t('blog.notFoundDesc', locale)}</p>
          <a href="/blog" class="btn primary">{t('blog.back', locale)}</a>
        </div>
      </section>
    ) : (
      <article class="grid gap-5 md:gap-10">
        {/* En-tête : couverture pleine largeur arrondie, puce, titre, méta */}
        <header class="section gap-4">
          {coverUrl && (
            <img src={coverUrl} alt={title ?? ''} loading="eager" class="aspect-video w-full rounded-[20px] border-2 border-line object-cover shadow-[4px_4px_0_var(--color-hard)] md:aspect-[21/9]" />
          )}
          <div class="mx-auto grid w-full max-w-[68ch] gap-2.5">
            <span class:list={['chip fill w-max', BLOG_CATEGORY_FILL[article.category]]}>
              {t(`blog.category.${article.category}`, locale)}
            </span>
            <h1 class="disp d-l md:text-[clamp(36px,3.6vw,52px)]">{title}</h1>
            <p class="muted text-[12.5px] md:text-sm">
              Par Amine Benboubker
              {article.reading_time_min && <> · {article.reading_time_min} {t('blog.readingTimeMin', locale)}</>}
              {dateStr && <> · {dateStr}</>}
            </p>
          </div>
        </header>

        {/* Corps lisible (68 caractères max) */}
        <div class="section">
          <div class="mx-auto w-full max-w-[68ch]">
            {excerpt && (
              <p class="mb-6 text-[1.15rem] font-medium leading-relaxed">{excerpt}</p>
            )}

            <div class="bayen-prose" set:html={contentHtml} />

            {dateUpdatedStr && (
              <p class="muted mt-8 text-xs italic">Mis à jour le {dateUpdatedStr}</p>
            )}

            {/* Bloc auteur — photo + liens (signal E-E-A-T pour Google sur les
                 sujets YMYL santé/nutrition) */}
            <div class="card mt-10 flex items-start gap-4 p-5 sm:gap-5 sm:p-6">
              <img
                src="/avatar-amine.webp"
                alt="Amine Benboubker"
                width="64"
                height="64"
                class="size-16 flex-shrink-0 rounded-full border-2 border-line object-cover"
                loading="eager"
              />
              <div class="min-w-0 flex-1">
                <p class="disp d-s">Amine Benboubker</p>
                <p class="muted mt-1 text-xs">
                  Fondateur de Bayen · Casablanca ·{' '}
                  <a href="https://aminebenboubker.com" target="_blank" rel="noopener" class="font-semibold text-brand-ink hover:underline">aminebenboubker.com</a>
                  {' '}· Studio <a href="https://www.n0.ma" target="_blank" rel="noopener" class="text-brand-ink hover:underline">N0.ma</a>
                </p>
                <p class="muted mt-2 text-sm leading-relaxed">
                  Articles écrits avec rigueur, en citant systématiquement les sources scientifiques (OMS, EFSA, CIRC, ANSES). Algorithme de scoring public et open source.{' '}
                  <a href="/methodologie" class="text-brand-ink hover:underline">Notre méthodologie</a> · <a href="/a-propos" class="text-brand-ink hover:underline">À propos de Bayen</a>
                </p>
              </div>
            </div>

            <a href="/blog" class="btn sm mt-8">{t('blog.back', locale)}</a>
          </div>
        </div>

        {/* Articles liés en cartes */}
        {relatedArticles.length > 0 && (
          <section class="section">
            <div class="sec-head">
              <h2 class="disp d-m">{t('blog.related', locale)}</h2>
              <a href={`/blog?cat=${article.category}`}>{t('history.seeAll', locale)}</a>
            </div>
            <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3 md:gap-6">
              {relatedArticles.map((related) => (
                <BlogCard article={related} locale={locale} variant="compact" />
              ))}
            </div>
          </section>
        )}
      </article>
    )}
  </main>
</Layout>

<style is:global>
  /* Styles typographiques pour le contenu markdown rendu */
  .bayen-prose {
    color: var(--color-foreground);
    line-height: 1.7;
    font-size: 1rem;
  }
  .bayen-prose > * + * { margin-top: 1em; }
  .bayen-prose h2 {
    font-family: var(--font-display);
    letter-spacing: -0.02em;
    font-size: 1.45rem;
    font-weight: 800;
    margin-top: 2em;
    margin-bottom: 0.5em;
    color: var(--color-foreground);
    line-height: 1.3;
  }
  .bayen-prose h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.75em;
    margin-bottom: 0.5em;
    color: var(--color-foreground);
    line-height: 1.3;
  }
  .bayen-prose h4 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }
  .bayen-prose p { color: var(--color-foreground); }
  .bayen-prose a {
    color: var(--color-brand-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
  }
  .bayen-prose a:hover { text-decoration-thickness: 2px; }
  .bayen-prose strong { font-weight: 700; color: var(--color-foreground); }
  .bayen-prose em { font-style: italic; }
  .bayen-prose ul, .bayen-prose ol {
    padding-inline-start: 1.5rem;
  }
  .bayen-prose ul { list-style-type: disc; }
  .bayen-prose ol { list-style-type: decimal; }
  .bayen-prose li { margin-top: 0.25em; }
  .bayen-prose blockquote {
    border-inline-start: 4px solid var(--color-citron);
    background: var(--color-card);
    border-radius: 0 16px 16px 0;
    padding: 18px 22px;
    margin: 24px 0;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--color-foreground);
    font-style: normal;
  }
  .bayen-prose code {
    background-color: var(--color-muted);
    padding: 0.15em 0.35em;
    border-radius: 0.25rem;
    font-size: 0.9em;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .bayen-prose pre {
    background-color: var(--color-muted);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
  }
  .bayen-prose pre code {
    background: none;
    padding: 0;
  }
  .bayen-prose img {
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
    margin: 1em 0;
  }
  .bayen-prose hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2em 0;
  }
</style>

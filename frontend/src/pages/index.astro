---
// Page d'accueil Bayen (SSR — données dynamiques)
// Structure : maquettes « Main » (mobile) et « Desktop » (≥ 768 px), design/maquettes/
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import ProductCard, { ScoreSticker } from '@/components/ProductCard.tsx'
import { getLocale, readingTime, t } from '@/lib/i18n'
import type { Article, ArticleCategory, Product } from '@/lib/types'
import { localCover } from '@/lib/blog-covers'

// Locale depuis le cookie SSR
const localeCookie = Astro.cookies?.get('bayen_locale')?.value ?? null
const locale = getLocale(localeCookie)

const DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL ?? 'https://api.bayen.ma'
const CDN_URL = import.meta.env.PUBLIC_CDN_URL ?? 'https://api.bayen.ma/assets'

let topProducts: Product[] = []
let articles: Article[] = []

try {
  // Appels en parallèle pour réduire le TTFB
  const [productsRes, articlesRes] = await Promise.all([
    fetch(
      // Les mieux notés : univers alimentaire uniquement (les univers ne se mélangent
      // jamais), avec photo (rapatriée dans Directus par le backfill) et score calculé
      `${DIRECTUS_URL}/items/products?filter[status][_eq]=published&filter[product_type][_eq]=food&filter[image_front][_nnull]=true&filter[scan_score][_nnull]=true&sort=-scan_score,-scan_count&limit=4&fields=id,barcode,name_fr,brand,quantity,image_front,scan_score,nutriscore_grade,nova_group,additives,product_type`,
      { signal: AbortSignal.timeout(5000) }
    ),
    fetch(
      `${DIRECTUS_URL}/items/articles?filter[status][_eq]=published&sort=-date_published&limit=3&fields=id,slug,title_fr,title_ar,cover_image,category,reading_time_min`,
      { signal: AbortSignal.timeout(4000) }
    ),
  ])
  if (productsRes.ok) topProducts = (await productsRes.json()).data ?? []
  if (articlesRes.ok) articles = (await articlesRes.json()).data ?? []
} catch {
  // Pas de données — la page s'affiche quand même (sections masquées)
}

// Pastille du héros : score RÉEL du meilleur produit, sinon pas de pastille
const best = topProducts[0]

// Suggestions de recherche (maquette Desktop) — les produits beauté ouvrent l'univers beauté
const SUGGESTIONS = [
  // La requête reste en français (noms de la base) ; seul le libellé suit la langue
  { label: t('home.sugg.sardines', locale), href: '/recherche?q=Sardines' },
  { label: t('home.sugg.argan', locale), href: `/recherche?univers=beaute&q=${encodeURIComponent("Huile d'argan")}` },
  { label: t('home.sugg.yaourt', locale), href: '/recherche?q=Yaourt' },
  { label: t('home.sugg.sunscreen', locale), href: `/recherche?univers=beaute&q=${encodeURIComponent('Crème solaire')}` },
]

// Quatre univers (maquettes Main / Desktop) : aplat de l'univers, texte encre
const UNIVERSES = [
  { href: '/recherche', bg: 'bg-menthe', title: t('nav.food', locale), desc: t('home.uni.foodDesc', locale), icon: '<path d="M5 19c0-8.5 5.5-14 14-14 0 9-5.5 14-14 14z"/><path d="M5 19l8-8"/>' },
  { href: '/beaute', bg: 'bg-beauty', title: t('nav.beauty', locale), desc: t('home.uni.beautyDesc', locale), icon: '<path d="M12 3c4 5 6.5 8 6.5 11.5a6.5 6.5 0 0 1-13 0C5.5 11 8 8 12 3z"/>' },
  { href: '/proteines', bg: 'bg-protein', title: t('nav.protein', locale), desc: t('home.uni.proteinDesc', locale), icon: '<path d="M6 7v10M3 9v6M18 7v10M21 9v6M6 12h12"/>' },
  { href: '/analyser-repas', bg: 'bg-ai', title: t('nav.meal', locale), desc: t('home.uni.mealDesc', locale), icon: '<path d="M4 8h3l2-3h6l2 3h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"/><circle cx="12" cy="14" r="4"/>' },
]

// Aplat de la puce de catégorie (mêmes teintes que BlogCard)
const CAT_FILL: Record<ArticleCategory, string> = {
  'bien-etre': 'bg-menthe',
  habitudes: 'bg-citron',
  guides: 'bg-myrtille',
  actualites: 'bg-framboise',
}

// Couverture : visuel local Marché Pop, sinon image Directus (réduite), sinon secours par catégorie
function coverOf(a: Article): string {
  const local = localCover(a.slug)
  if (local) return local
  if (!a.cover_image) return `/blog/fallback-${a.category}.jpg`
  return a.cover_image.startsWith('http') ? a.cover_image : `${CDN_URL}/${a.cover_image}?width=640&quality=80&format=webp`
}

const SEARCH_ICON = '<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>'
const SCAN_ICON = '<path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3"/><path d="M8 9v6M11 9v6M14 9v6M17 9v6"/>'
---

<Layout
  title={t('seo.home.title', locale)}
  description={t('seo.home.desc', locale)}
  path="/"
>
  <main class="screen max-md:pt-[26px] md:gap-16">

    <!-- Héros : colonne unique sur mobile (texte, vignette, actions) ; texte | vignette dès lg -->
    <section class="section gap-4 md:gap-[22px] lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-x-12">
      <div class="grid gap-4 md:gap-[22px] lg:self-end">
        <p class="eyebrow hidden md:block">{t('home.eyebrow', locale)}</p>
        <h1 class="disp d-xl md:text-[clamp(40px,5vw,68px)]">{t('home.heroTitle', locale)}</h1>
        <p class="muted text-base md:hidden">{t('home.heroLeadMobile', locale)}</p>
        <p class="muted hidden max-w-[34ch] text-[19px] md:block">{t('home.heroLeadDesktop', locale)}</p>
      </div>

      <div class="relative mt-1.5 md:order-last md:mt-8 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mt-0 lg:self-center">
        <div class="tile tint-menthe h-[210px] rounded-[24px] shadow-[5px_5px_0_var(--color-hard)] md:h-[440px] md:rounded-[36px] md:shadow-[8px_8px_0_var(--color-hard)]">
          <img src="/hero/a-propos.jpg" alt={t('home.heroImgAlt', locale)} width="1600" height="900" loading="eager" fetchpriority="high" />
        </div>
        {best?.scan_score != null && (
          <a
            href={`/produit/${best.barcode}`}
            class="absolute -end-1.5 -bottom-[22px] md:end-auto md:-start-6 md:-bottom-7"
            title={best.name_fr}
          >
            <ScoreSticker score={best.scan_score} size="lg" locale={locale} className={String(best.scan_score).length > 2 ? "md:size-[132px] md:[&_b]:text-[38px] md:[&_i]:text-[14px] md:rtl:[&_i]:text-[19px]" : "md:size-[132px] md:[&_b]:text-[48px] md:[&_i]:text-[14px] md:rtl:[&_i]:text-[19px]"} />
            <span class="sr-only">{best.name_fr}</span>
          </a>
        )}
        <div class="tint-menthe absolute -end-[18px] -top-[26px] hidden size-[120px] overflow-hidden rounded-full border-[3px] border-encre shadow-[4px_4px_0_var(--color-hard)] md:block">
          <img src="/mascotte/naanaa-salut.webp" alt={t('home.naanaaAlt', locale)} width="120" height="120" class="size-full object-cover object-[50%_30%]" />
        </div>
      </div>

      <div class="mt-3.5 md:mt-0 lg:self-start">
        <!-- Mobile : scanner + recherche pilule -->
        <div class="grid gap-4 md:hidden">
          <div class="flex gap-2.5">
            <a class="btn primary flex-1" href="/scan">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={SCAN_ICON} />
              {t('home.scanBtn', locale)}
            </a>
          </div>
          <form action="/recherche" method="get" role="search">
            <label class="card flex h-[50px] items-center gap-2.5 rounded-full px-4 shadow-[3px_3px_0_var(--color-hard)] focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-ring">
              <svg class="size-[22px] flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={SEARCH_ICON} />
              <input name="q" type="search" placeholder={t('home.searchPlaceholderMobile', locale)} aria-label={t('home.searchAria', locale)} class="w-0 min-w-0 flex-1 border-0 bg-transparent text-[14.5px] font-medium text-foreground outline-none" />
            </label>
          </form>
        </div>

        <!-- Ordinateur : grande recherche + suggestions -->
        <div class="hidden gap-[22px] md:grid">
          <form action="/recherche" method="get" role="search">
            <label class="card flex h-16 max-w-[560px] items-center gap-3 rounded-full ps-5 pe-2 focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-ring">
              <svg class="size-[22px] flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={SEARCH_ICON} />
              <input name="q" type="search" placeholder={t('home.searchPlaceholderDesktop', locale)} aria-label={t('home.searchAria', locale)} class="w-0 min-w-0 flex-1 border-0 bg-transparent text-[17px] font-medium text-foreground outline-none" />
              <button type="submit" class="btn primary sm flat">{t('nav.searchShort', locale)}</button>
            </label>
          </form>
          <div class="chips">
            {SUGGESTIONS.map((s) => <a class="chip" href={s.href}>{s.label}</a>)}
          </div>
        </div>
      </div>
    </section>

    <!-- Choisis ton univers : 2×2 sur mobile, 4 en ligne sur grand écran -->
    <section class="section">
      <div class="sec-head md:sr-only"><h2 class="disp d-m">{t('home.universesTitle', locale)}</h2></div>
      <div class="grid grid-cols-2 gap-3 md:gap-[18px] lg:grid-cols-4">
        {UNIVERSES.map((u) => (
          <a href={u.href} class:list={['card grid gap-[22px] p-3.5 text-encre md:gap-10 md:p-[22px]', u.bg]}>
            <span class="u-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={u.icon} /></span>
            <span><b class="disp d-s block md:text-[20px]">{u.title}</b><span class="text-[12.5px] md:text-[15px]">{u.desc}</span></span>
          </a>
        ))}
      </div>
    </section>

    <!-- L'astuce de Naânaa (mobile ; sur ordinateur, Naânaa est dans le héros) -->
    <section class="section md:hidden">
      <div class="naanaa">
        <div class="m"><img src="/mascotte/naanaa-astuce.webp" alt={t('home.naanaaAlt', locale)} width="72" height="72" loading="lazy" /></div>
        <p class="bubble"><b>{t('home.tipTitle', locale)}</b><br />{t('home.tip', locale)}</p>
      </div>
    </section>

    <!-- Les mieux notés : liste sur mobile, grille de 4 sur ordinateur -->
    {topProducts.length > 0 && (
      <section class="section md:gap-5">
        <div class="sec-head"><h2 class="disp d-m md:text-[26px]">{t('home.topRated', locale)}</h2><a href="/recherche?sort=-scan_score">{t('history.seeAll', locale)}</a></div>
        <div class="grid gap-3 md:hidden">
          {topProducts.slice(0, 3).map((product) => <ProductCard product={product} locale={locale} />)}
        </div>
        <div class="hidden gap-[18px] md:grid md:grid-cols-2 lg:grid-cols-4">
          {topProducts.map((product) => <ProductCard product={product} variant="grid" locale={locale} />)}
        </div>
      </section>
    )}

    <!-- À lire (mobile : un article) / Le journal (ordinateur : trois articles) -->
    {articles.length > 0 && (
      <section class="section md:gap-5">
        <div class="sec-head">
          <h2 class="disp d-m md:text-[26px]"><span class="md:hidden">{t('home.toRead', locale)}</span><span class="hidden md:inline">{t('nav.journalBlog', locale)}</span></h2>
          <a href="/blog"><span class="md:hidden">{t('nav.journalBlog', locale)}</span><span class="hidden md:inline">{t('home.allArticles', locale)}</span></a>
        </div>
        <div class="grid gap-[18px] md:grid-cols-3">
          {articles.map((a, i) => (
            <a href={`/blog/${a.slug}`} class:list={['card grid content-start overflow-hidden', i > 0 && 'max-md:hidden']}>
              <img src={coverOf(a)} alt="" loading="lazy" class="h-[170px] w-full border-b-2 border-line object-cover md:h-[200px]" />
              <div class="grid gap-1.5 p-3.5 md:p-4">
                <span class:list={['chip fill w-max md:hidden', CAT_FILL[a.category]]}>{t(`blog.category.${a.category}`, locale)}</span>
                <p class="disp d-s">{(locale === 'ary' && a.title_ar) || a.title_fr}</p>
                {a.reading_time_min ? <p class="muted text-[13px] md:hidden">{readingTime(a.reading_time_min, locale)}</p> : null}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

  </main>
</Layout>

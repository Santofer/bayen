---
export const prerender = false
import Layout from '@/layouts/Layout.astro'
import Leaderboard from '@/components/Leaderboard.tsx'
import PageHero from '@/components/PageHero.astro'
import { getLocale, t } from '@/lib/i18n'

const locale = getLocale(Astro.cookies?.get('bayen_locale')?.value ?? null)
const DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL ?? 'https://api.bayen.ma'

// Top contributeurs RÉELS via l'endpoint public dédié.
// (L'ancienne version lisait /users — 403 en public — et affichait des données
// de démo codées en dur : un classement fictif présenté comme vrai.)
interface Contributor {
  id: string
  name: string
  points: number
  contributions: number
  rank: string
}

let contributors: Contributor[] = []

try {
  const res = await fetch(`${DIRECTUS_URL}/bayen-api/leaderboard`, {
    signal: AbortSignal.timeout(5000),
  })
  if (res.ok) {
    const data = await res.json()
    contributors = data.entries ?? []
  }
} catch {
  // pas de données — la page affiche l'état vide
}

// Mapping pour le composant Leaderboard (île React)
const tierLabels: Record<string, string> = {
  nouveau: t('rank.nouveau', locale),
  contributeur: t('rank.contributeur', locale),
  expert: t('rank.expert', locale),
  'vérifié': t('rank.verified', locale),
}

// Barème affiché (doit suivre bayen-api/src/points.ts)
const earn = [
  { action: t('rank.addProduct', locale), points: 50 },
  { action: t('rank.addPhotos', locale), points: 20 },
  { action: t('rank.correctData', locale), points: 15 },
  { action: t('rank.scanProduct', locale), points: 1 },
  { action: t('rank.confirmedX3', locale), points: 10 },
  { action: t('points.actionPrice', locale), points: 5 },
  { action: t('points.actionMeal', locale), points: 10 },
]

// Niveaux : même palette que Leaderboard.tsx
const levels = [
  { key: 'rank.nouveau' as const, min: 0, color: 'var(--color-framboise)' },
  { key: 'rank.contributeur' as const, min: 100, color: 'var(--color-menthe)' },
  { key: 'rank.expert' as const, min: 500, color: 'var(--color-citron)' },
  { key: 'rank.verified' as const, min: 2000, color: 'var(--color-myrtille)' },
]

const leaderboardEntries = contributors.map((u) => ({
  userId: u.id,
  userName: u.name || t('rank.anonymous', locale),
  points: u.points,
  rankTier: u.rank,
  contributions: u.contributions,
}))
---

<Layout
  title={`${t('rank.title', locale)} — Bayen`}
  description="Le classement des contributeurs Bayen au Maroc. Top scans, top contributions, top points."
  path="/classement"
  mobileTopbar={false}
>
  <PageHero tone="citron" mascot="bravo" kicker={t('nav.community', locale)} title={t('rank.title', locale)} subtitle={t('rank.subtitle', locale)}>
    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
    <a href="/contribuer" class="btn dark-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      {t('nav.contribute', locale)}
    </a>
  </PageHero>

  <main class="screen pt-5 md:pt-10">
    <section class="section">
      {contributors.length === 0 ? (
        <div class="naanaa">
          <img src="/mascotte/naanaa-scan.webp" alt="" width="72" height="72" loading="lazy" />
          <p class="bubble">{t('rank.empty', locale)}<br /><a href="/contribuer" class="font-bold underline underline-offset-2">{t('rank.beFirst', locale)}</a></p>
        </div>
      ) : (
        <Leaderboard
          client:load
          entries={leaderboardEntries}
          tierLabels={tierLabels}
          contributionsLabel={t('rank.contributions', locale)}
          pointsSuffix={t('rank.pts', locale)}
          locale={locale}
        />
      )}
    </section>

    <!-- Système de points : barème en lignes de carte, niveaux en cartes colorées -->
    <div class="grid gap-[26px] md:grid-cols-2 md:gap-[18px]">
      <section class="section content-start">
        <div class="sec-head"><h2 class="disp d-m">{t('rank.howToEarn', locale)}</h2></div>
        <ul class="card overflow-hidden">
          {earn.map(({ action, points }) => (
            <li class="flex items-center justify-between gap-3 border-b-[1.5px] border-line px-4 py-3 last:border-b-0">
              <span class="text-[14px]">{action}</span>
              <span class="chip fill num flex-none bg-menthe">+{points} {t('rank.pts', locale)}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="section content-start">
        <div class="sec-head"><h2 class="disp d-m">{t('rank.levels', locale)}</h2></div>
        <div class="grid grid-cols-2 gap-3">
          {levels.map(({ key, min, color }) => (
            <div class="card grid gap-6 p-4 text-encre" style={`background: ${color}`}>
              <span class="num text-[13px] font-semibold">{min}+ {t('rank.pts', locale)}</span>
              <b class="disp d-s">{t(key, locale)}</b>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>
</Layout>

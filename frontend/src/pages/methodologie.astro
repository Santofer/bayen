---
// Page "Méthodologie du score Bayen" — transparence complète de l'algorithme
// pour appuyer le E-E-A-T sur les sujets YMYL (nutrition = santé).
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import PageHero from '@/components/PageHero.astro'
import { getLocale } from '@/lib/i18n'
import { SCORE_FILL, SCORE_WORD, type ScoreLevel } from '@/lib/score-colors'

const localeCookie = Astro.cookies?.get('bayen_locale')?.value ?? null
const locale = getLocale(localeCookie)

const SITE_URL = 'https://bayen.ma'

// Barèmes affichés = ceux de lib/scoring.ts (miroir de bayen-api/src/scoring.ts)
const NUTRI = [
  { l: 'A', pts: 50, cls: 'bg-nutriscore-a' },
  { l: 'B', pts: 40, cls: 'bg-nutriscore-b' },
  { l: 'C', pts: 30, cls: 'bg-nutriscore-c' },
  { l: 'D', pts: 15, cls: 'bg-nutriscore-d' },
  { l: 'E', pts: 0, cls: 'bg-nutriscore-e' },
]
const NOVA = [
  { g: 1, pts: 30, d: 'aliments bruts ou peu transformés (légumes, fruits, viande fraîche, lait, œufs)' },
  { g: 2, pts: 20, d: 'ingrédients culinaires extraits (sucre, sel, huile, beurre)' },
  { g: 3, pts: 10, d: 'aliments transformés (pain, fromage, conserves de légumes)' },
  { g: 4, pts: 0, d: 'ultra-transformés (sodas, plats préparés, nuggets, biscuits fourrés, charcuterie industrielle)' },
]
const ADDITIVES = [
  { label: 'Sûr', ex: 'E330 (acide citrique)', ded: '0 pt', fill: 'var(--color-score-excellent)' },
  { label: 'À limiter', ex: 'E322 (lécithines)', ded: '−2 pts', fill: 'var(--color-citron)' },
  { label: 'À éviter', ex: 'E951 (aspartame)', ded: '−5 pts', fill: 'var(--color-score-mediocre)' },
  { label: 'Interdit Maroc/UE', ex: 'E171 (TiO₂)', ded: '−10 pts', fill: 'var(--color-score-mauvais)' },
]
// Étiquette finale : seuils de scoreToLabel (75 / 50 / 25)
const LABELS: Array<{ level: ScoreLevel; range: string; value: number }> = [
  { level: 'excellent', range: '75 — 100', value: 75 },
  { level: 'bon', range: '50 — 74', value: 50 },
  { level: 'mediocre', range: '25 — 49', value: 25 },
  { level: 'mauvais', range: '0 — 24', value: 0 },
]

// JSON-LD : TechArticle (article technique) + BreadcrumbList + FAQPage pour les 4 questions
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Méthodologie du score Bayen : comment on calcule la note 0-100',
    description: "Détail complet de l'algorithme de scoring Bayen : pondération Nutri-Score (50%), NOVA (30%), additifs (20%). Algorithme déterministe, ouvert et reproductible.",
    inLanguage: locale === 'ary' ? 'ar-MA' : 'fr-MA',
    author: {
      '@type': 'Organization',
      name: 'Bayen',
      url: SITE_URL,
    },
    datePublished: '2026-05-11',
    dateModified: '2026-05-11',
    publisher: { '@id': `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/methodologie`,
    proficiencyLevel: 'Beginner',
    keywords: 'Nutri-Score, NOVA, additifs, score nutritionnel, méthodologie, transparence',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: 'Méthodologie', item: `${SITE_URL}/methodologie` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Comment le score Bayen est-il calculé ?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Le score Bayen, noté de 0 à 100, est la somme pondérée de trois composantes : Nutri-Score officiel (50 points), groupe NOVA de transformation (30 points), et pénalités liées aux additifs à risque (20 points). C\'est un algorithme déterministe public, sans intelligence artificielle dans le calcul.',
        },
      },
      {
        '@type': 'Question',
        name: 'Pourquoi un produit peut avoir un Nutri-Score A mais un mauvais score Bayen ?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Le Nutri-Score ne regarde que la composition nutritionnelle (sucres, sel, graisses, fibres, protéines). Un produit peut être Nutri-Score A mais ultra-transformé (NOVA 4) avec beaucoup d\'additifs controversés — dans ce cas le score Bayen pénalise ces deux dimensions ignorées par le Nutri-Score seul.',
        },
      },
      {
        '@type': 'Question',
        name: 'D\'où viennent les données nutritionnelles ?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '75% des produits viennent d\'Open Food Facts (base mondiale collaborative) auto-importés au scan. 25% sont contribués par la communauté marocaine via photo + OCR. Les utilisateurs peuvent confirmer ou signaler les erreurs : 3 confirmations passent un produit en statut "Vérifié".',
        },
      },
      {
        '@type': 'Question',
        name: 'L\'IA décide-t-elle de la note d\'un produit ?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Non. L\'IA (modèle Qwen3.5-9B auto-hébergé sur les serveurs de Bayen au Maroc) lit les étiquettes et les listes d\'ingrédients, identifie un produit encore sans fiche et décrit une photo de plat. Le score final est toujours calculé par un algorithme déterministe, ouvert et reproductible — pas de boîte noire.',
        },
      },
    ],
  },
]
---

<Layout
  title="Méthodologie du score Bayen — Comment on calcule la note nutritionnelle"
  description="Détail complet et transparent de l'algorithme : Nutri-Score (50 pts) + NOVA (30 pts) + Additifs (20 pts). Algorithme public, open source, reproductible."
  path="/methodologie"
  jsonLd={jsonLd}
  mobileTopbar={false}
>
  <PageHero tone="myrtille" mascot="loupe" kicker="Transparence totale" title="Méthodologie du score Bayen" subtitle="Comment on calcule la note 0–100 affichée pour chaque produit. Pas de boîte noire, pas d'IA dans le calcul : un algorithme déterministe, public, vérifiable.">
    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1ZM2 16l3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1ZM7 21h10M12 3v18M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>
  </PageHero>

  <main class="screen pt-5 md:pt-10">
    <!-- La formule en une ligne : trois cartes colorées -->
    <section class="section">
      <div class="sec-head">
        <h2 class="disp d-m md:text-[26px]">La formule en une ligne</h2>
        <a href="https://github.com/Santofer/bayen/blob/main/frontend/src/lib/scoring.ts" target="_blank" rel="noopener noreferrer">scoring.ts</a>
      </div>
      <div class="grid grid-cols-3 gap-2.5 md:gap-[18px]">
        <div class="card grid content-start gap-1 bg-citron p-3 text-encre md:p-[22px]"><b class="disp d-l num md:text-[40px]">50</b><span class="text-[12.5px] font-semibold md:text-[15px]">Nutri-Score</span></div>
        <div class="card grid content-start gap-1 bg-framboise p-3 text-encre md:p-[22px]"><b class="disp d-l num md:text-[40px]">30</b><span class="text-[12.5px] font-semibold md:text-[15px]">NOVA</span></div>
        <div class="card grid content-start gap-1 bg-figue p-3 text-encre md:p-[22px]"><b class="disp d-l num md:text-[40px]">20</b><span class="text-[12.5px] font-semibold md:text-[15px]">Additifs</span></div>
      </div>
      <p class="muted text-[13px]">Score = Nutri-Score (50 %) + NOVA (30 %) + Additifs (20 %), sur 100 points.</p>
    </section>

    <!-- Les trois composantes -->
    <section class="section md:grid-cols-3 md:items-start md:gap-[18px]">
      <article class="card grid gap-3 p-4 md:p-5">
        <div class="sec-head"><h2 class="disp d-m">1. Nutri-Score</h2><span class="eyebrow">50 pts</span></div>
        <p class="text-[14px] leading-relaxed">
          On utilise l'algorithme officiel européen mis au point par <strong>Santé Publique France</strong> (méthode FSA-NPS modifiée). Pour 100g du produit :
        </p>
        <ul class="muted grid gap-1.5 ps-4 text-[13.5px] leading-relaxed list-disc">
          <li><strong class="text-foreground">Points négatifs</strong> (à minimiser) : énergie, sucres, acides gras saturés, sel</li>
          <li><strong class="text-foreground">Points positifs</strong> (à maximiser) : fibres, protéines, fruits/légumes/légumineuses</li>
          <li><strong class="text-foreground">Lettres :</strong> A (vert foncé, le meilleur) → E (rouge)</li>
        </ul>
        <div class="grid gap-2.5">
          {NUTRI.map((n) => (
            <div class="nut">
              <span class="lab">Nutri-Score {n.l}</span>
              <span class="val"><b>{n.pts}</b> / 50</span>
              <span class="bar"><i class={n.cls} style={`width: ${(n.pts / 50) * 100}%`} /></span>
            </div>
          ))}
        </div>
        <p class="muted text-xs italic">
          Pour les boissons, on applique des seuils plus stricts (catégorie 5 "boissons sucrées" et 6 "eaux & jus") car les calories liquides sont plus rapidement absorbées par l'organisme.
        </p>
      </article>

      <article class="card grid gap-3 p-4 md:p-5">
        <div class="sec-head"><h2 class="disp d-m">2. Groupe NOVA</h2><span class="eyebrow">30 pts</span></div>
        <p class="text-[14px] leading-relaxed">
          La classification <strong>NOVA</strong> (Pr. Carlos Monteiro, Université de São Paulo, 2009) range les aliments selon leur degré de transformation industrielle :
        </p>
        <div class="grid gap-3">
          {NOVA.map((n) => (
            <div class="nut">
              <span class="lab">NOVA {n.g}</span>
              <span class="val"><b>{n.pts}</b> / 30</span>
              <span class="bar"><i class="bg-protein" style={`width: ${(n.pts / 30) * 100}%`} /></span>
              <span class="muted col-span-full text-[12.5px] leading-snug">{n.d}</span>
            </div>
          ))}
        </div>
        <p class="muted text-[13px] italic">
          Une consommation élevée de NOVA 4 est associée à <strong class="text-foreground">+62% de mortalité toutes causes</strong> (étude NutriNet-Santé 2019, 45 000 participants) et +31% de diabète type 2 — d'où la pondération forte dans le score Bayen.
        </p>
      </article>

      <article class="card grid gap-3 p-4 md:p-5">
        <div class="sec-head"><h2 class="disp d-m">3. Additifs</h2><span class="eyebrow">20 pts</span></div>
        <p class="text-[14px] leading-relaxed">
          On part de 20 points et on déduit pour chaque additif détecté dans la liste d'ingrédients, selon son niveau de risque (basé sur les évaluations <strong>EFSA</strong>, <strong>CIRC/OMS</strong> et la réglementation marocaine) :
        </p>
        <div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-2.5">
          {ADDITIVES.map((a) => (
            <>
              <div class="min-w-0"><b>{a.label}</b><p class="muted text-[12.5px]">{a.ex}</p></div>
              <span class="chip fill num" style={`background: ${a.fill}`}>{a.ded}</span>
            </>
          ))}
        </div>
        <p class="muted text-xs italic">
          Le minimum reste 0 : un produit avec beaucoup d'additifs ne descend pas dans le négatif sur cette composante.
        </p>
        <a href="/additifs" class="text-[13px] font-bold underline underline-offset-[3px]">Tous les additifs →</a>
      </article>
    </section>

    <!-- Étiquette finale : les pastilles de score -->
    <section class="section">
      <div class="sec-head"><h2 class="disp d-m md:text-[26px]">Étiquette finale</h2><span class="eyebrow">score / 100</span></div>
      <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-[18px]">
        {LABELS.map((l) => (
          <div class="card grid justify-items-center gap-3 p-4 text-center">
            <span class="score-sticker" style={`--c: ${SCORE_FILL[l.level]}`} role="img" aria-label={`${SCORE_WORD[l.level]}, de ${l.range}`}>
              <span aria-hidden="true"><b>{l.value}</b><i>{SCORE_WORD[l.level]}</i></span>
            </span>
            <span class="num font-display text-[15px] font-extrabold">{l.range}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- L'IA : lire et décrire, jamais noter (univers IA = figue) -->
    <section class="section md:grid-cols-[minmax(0,1fr)_minmax(0,2.2fr)] md:items-start md:gap-x-12">
      <h2 class="disp d-m md:text-[26px]">Et l'IA dans tout ça ?</h2>
      <div class="card tint-figue grid max-w-[68ch] gap-3 p-4 md:p-5">
        <p class="text-[14.5px] leading-relaxed">
          Bayen utilise un modèle d'IA auto-hébergé (Qwen3.5-9B multimodal, sur nos serveurs au Maroc) pour <strong>lire et décrire, jamais pour noter</strong> :
        </p>
        <ul class="grid gap-1.5 ps-4 text-[14px] leading-relaxed list-disc">
          <li>Lire le tableau nutritionnel d'une photo d'étiquette (français et arabe)</li>
          <li>Recopier la liste d'ingrédients INCI d'un cosmétique</li>
          <li>Identifier un produit encore sans fiche et proposer des valeurs typiques, toujours affichées comme « estimation IA »</li>
          <li>Décrire une photo de plat et estimer une fourchette de calories (« Analyser mon repas »)</li>
        </ul>
        <p class="text-[14.5px] leading-relaxed">
          <strong>Le score final n'est JAMAIS calculé par l'IA.</strong> Une fois les valeurs nutritionnelles extraites, l'algorithme déterministe ci-dessus prend la main. C'est ce qui garantit la reproductibilité : le même produit donne le même score, à chaque scan, sans variation.
        </p>
      </div>
    </section>

    <footer class="section muted justify-items-center gap-1 text-center text-xs">
      <p>Code source : <a href="https://github.com/Santofer/bayen" target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-ink underline underline-offset-2">github.com/Santofer/bayen</a></p>
      <p>Dernière mise à jour : 11 mai 2026</p>
    </footer>
  </main>
</Layout>

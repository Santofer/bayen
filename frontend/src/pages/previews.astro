---
/**
 * Page de prévisualisation des composants Bayen pour le blog.
 * Style shadcn/ui : fond blanc, ombre subtile, focus sur un seul composant par carte.
 *
 * Pour capturer :
 *   1. Ouvrir /previews dans Chrome
 *   2. Clic-droit sur un `.preview-block` → Inspecter
 *   3. Dans le DOM, clic-droit sur l'élément → "Capture node screenshot"
 *   → génère un PNG avec fond transparent (si on masque body bg en devtools)
 */
export const prerender = false
---

<!doctype html>
<html lang="fr" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Readex+Pro:wght@400;500;600;700&family=Unbounded:wght@600;700;800&display=swap" rel="stylesheet" />
    <title>Bayen — Component Previews</title>
    <style>
      /* Jetons Marché Pop (copie de globals.css : cette page est autonome) */
      :root {
        --creme: #FFF8EC; --encre: #1B1B1B; --card: #FFFFFF; --muted: #5E5A52; --muted-bg: #F3EADB;
        --menthe: #19C08B; --citron: #FFD43B; --tomate: #FF5A3C; --brand-ink: #0B7A55;
        --score-bon: #A6E35F; --score-mediocre: #FFA24D;
        --mediocre-ink: #B05200; --mauvais-ink: #C2331A;
        --tint-menthe: #BFF0DC; --tint-citron: #FFEC9E; --tint-tomate: #FFC9BC;
      }
      * { box-sizing: border-box; }
      body {
        background: var(--creme);
        margin: 0;
        padding: 60px 20px;
        font-family: 'Readex Pro', system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
        color: var(--encre);
      }
      .preview-grid {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 80px;
        max-width: 1200px;
        margin: 0 auto;
      }
      .preview-block {
        position: relative;
      }
      .preview-label {
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 20px;
        text-align: center;
      }
      .card {
        background: var(--card);
        border: 2px solid var(--encre);
        border-radius: 16px;
        box-shadow: 3px 3px 0 var(--encre);
      }
      /* Typographie héritée shadcn-like */
      .t-title { font-weight: 700; color: var(--encre); }
      .t-muted { color: var(--muted); }
      .t-mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }

      /* Couleurs Bayen */
      .bg-cream { background: var(--tint-menthe); }
      .text-brand-ink { color: var(--brand-ink); }
      .text-lime { color: var(--brand-ink); }
    </style>
  </head>
  <body>
    <div class="preview-grid">

      <!-- ═══ 1. PRODUCT CARD ═══ -->
      <div class="preview-block">
        <div class="preview-label">Product Card</div>
        <div class="card" style="width: 420px; padding: 16px; display: flex; gap: 14px; align-items: center;">
          <div style="position: relative; flex-shrink: 0; width: 80px; height: 80px; border-radius: 12px; overflow: hidden; background: var(--tint-menthe);">
            <img src="https://images.openfoodfacts.org/images/products/611/103/500/1673/front_fr.3.400.jpg" alt="" style="width: 80px; height: 80px; object-fit: cover; display: block;" onerror="this.style.display='none'" />
            <div style="position: absolute; top: -6px; right: -6px; width: 36px; height: 36px; border-radius: 999px; background: var(--menthe); color: var(--encre); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 13px; box-shadow: 2px 2px 0 var(--encre); border: 2px solid var(--encre); transform: rotate(-8deg);">100</div>
          </div>
          <div style="flex: 1; min-width: 0;">
            <div style="font-size: 15px; font-weight: 700; color: var(--encre); line-height: 1.2;">Aïn Atlas</div>
            <div style="font-size: 12px; color: var(--muted); margin-top: 2px;">Eau minérale naturelle · 50cl</div>
            <div style="display: flex; align-items: center; gap: 6px; margin-top: 8px;">
              <span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 999px; background: var(--tint-menthe); color: var(--brand-ink); font-size: 11px; font-weight: 700; border: 1px solid var(--menthe);">
                <span style="width: 6px; height: 6px; border-radius: 999px; background: var(--menthe);"></span>
                Excellent
              </span>
              <span style="padding: 2px 7px; border-radius: 6px; background: #038141; color: #fff; font-size: 10px; font-weight: 800; letter-spacing: 0.05em;">A</span>
              <span style="padding: 2px 7px; border-radius: 6px; background: var(--tint-menthe); color: var(--brand-ink); font-size: 10px; font-weight: 800;">NOVA 1</span>
            </div>
          </div>
        </div>
      </div>

      <!-- ═══ 2. SCORE GAUGE ═══ -->
      <div class="preview-block">
        <div class="preview-label">Score Gauge</div>
        <div class="card" style="width: 380px; padding: 32px; display: flex; flex-direction: column; align-items: center; gap: 20px;">
          <!-- Cercle score -->
          <div style="position: relative; width: 180px; height: 180px;">
            <svg width="180" height="180" viewBox="0 0 120 120" style="transform: rotate(-90deg);">
              <circle cx="60" cy="60" r="52" fill="none" stroke="var(--muted-bg)" stroke-width="10" />
              <circle cx="60" cy="60" r="52" fill="none" stroke="url(#scoreGrad)" stroke-width="10" stroke-linecap="round"
                stroke-dasharray="326.73" stroke-dashoffset="98.02" />
              <defs>
                <linearGradient id="scoreGrad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="var(--score-bon)" />
                  <stop offset="100%" stop-color="var(--menthe)" />
                </linearGradient>
              </defs>
            </svg>
            <div style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;">
              <span style="font-size: 54px; font-weight: 900; color: var(--brand-ink); line-height: 1;">70</span>
              <span style="font-size: 12px; color: var(--muted); margin-top: 2px;">/ 100</span>
            </div>
          </div>
          <div style="text-align: center;">
            <div style="font-size: 14px; font-weight: 800; color: var(--brand-ink); letter-spacing: 0.2em; text-transform: uppercase;">Bon</div>
            <div style="font-size: 12px; color: var(--muted); margin-top: 4px;">Prince Goût Chocolat · LU</div>
          </div>
          <!-- Mini breakdown -->
          <div style="width: 100%; display: flex; gap: 8px; padding-top: 16px; border-top: 1px solid var(--muted-bg);">
            <div style="flex: 1; text-align: center;">
              <div style="font-size: 10px; color: var(--muted); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">Nutri</div>
              <div style="font-size: 18px; font-weight: 800; color: var(--brand-ink); margin-top: 2px;">40<span style="font-size: 11px; color: var(--muted); font-weight: 600;">/50</span></div>
            </div>
            <div style="width: 1px; background: var(--muted-bg);"></div>
            <div style="flex: 1; text-align: center;">
              <div style="font-size: 10px; color: var(--muted); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">NOVA</div>
              <div style="font-size: 18px; font-weight: 800; color: var(--tomate); margin-top: 2px;">10<span style="font-size: 11px; color: var(--muted); font-weight: 600;">/30</span></div>
            </div>
            <div style="width: 1px; background: var(--muted-bg);"></div>
            <div style="flex: 1; text-align: center;">
              <div style="font-size: 10px; color: var(--muted); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">Additifs</div>
              <div style="font-size: 18px; font-weight: 800; color: var(--brand-ink); margin-top: 2px;">20<span style="font-size: 11px; color: var(--muted); font-weight: 600;">/20</span></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ═══ 3. ADDITIVES PILLS ═══ -->
      <div class="preview-block">
        <div class="preview-label">Additives</div>
        <div class="card" style="width: 440px; padding: 20px;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
            <div style="font-size: 14px; font-weight: 700; color: var(--encre);">Additifs détectés</div>
            <div style="font-size: 11px; color: var(--muted); font-weight: 600;">6 total</div>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 6px;">
            <span style="display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; border-radius: 999px; background: var(--tint-tomate); border: 1px solid var(--tomate); color: var(--mauvais-ink); font-size: 12px; font-weight: 700;">
              <span style="width: 6px; height: 6px; border-radius: 999px; background: var(--mauvais-ink);"></span>
              E110 · À éviter
            </span>
            <span style="display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; border-radius: 999px; background: var(--mauvais-ink); border: 1px solid var(--mauvais-ink); color: var(--card); font-size: 12px; font-weight: 700;">
              <span style="width: 6px; height: 6px; border-radius: 999px; background: var(--tomate);"></span>
              E621 · Interdit MA
            </span>
            <span style="display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; border-radius: 999px; background: var(--tint-citron); border: 1px solid var(--score-mediocre); color: var(--mediocre-ink); font-size: 12px; font-weight: 700;">
              <span style="width: 6px; height: 6px; border-radius: 999px; background: var(--score-mediocre);"></span>
              E160C · Limité
            </span>
            <span style="display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; border-radius: 999px; background: var(--tint-citron); border: 1px solid var(--score-mediocre); color: var(--mediocre-ink); font-size: 12px; font-weight: 700;">
              <span style="width: 6px; height: 6px; border-radius: 999px; background: var(--score-mediocre);"></span>
              E551 · Limité
            </span>
            <span style="display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; border-radius: 999px; background: var(--tint-menthe); border: 1px solid var(--menthe); color: var(--brand-ink); font-size: 12px; font-weight: 700;">
              <span style="width: 6px; height: 6px; border-radius: 999px; background: var(--menthe);"></span>
              E330 · Sûr
            </span>
            <span style="display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; border-radius: 999px; background: var(--tint-menthe); border: 1px solid var(--menthe); color: var(--brand-ink); font-size: 12px; font-weight: 700;">
              <span style="width: 6px; height: 6px; border-radius: 999px; background: var(--menthe);"></span>
              E440 · Sûr
            </span>
          </div>
          <div style="margin-top: 14px; padding: 10px 12px; background: var(--tint-citron); border: 1px solid var(--score-mediocre); border-radius: 10px; display: flex; align-items: center; gap: 10px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--mediocre-ink)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;">
              <circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            <div style="font-size: 12px; color: var(--mediocre-ink);">Impact sur le score <span style="font-weight: 800;">−9 points</span></div>
          </div>
        </div>
      </div>

      <!-- ═══ 4. HEALTH INSIGHT ═══ -->
      <div class="preview-block">
        <div class="preview-label">Health Insight</div>
        <div class="card" style="width: 460px; padding: 20px;">
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 16px;">
            <div style="width: 28px; height: 28px; border-radius: 8px; background: linear-gradient(135deg, var(--score-bon), var(--menthe)); display: flex; align-items: center; justify-content: center;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--card)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/>
              </svg>
            </div>
            <div>
              <div style="font-size: 14px; font-weight: 800; color: var(--encre);">Analyse santé</div>
              <div style="font-size: 11px; color: var(--muted);">3 points détectés</div>
            </div>
          </div>
          <div style="display: flex; flex-direction: column; gap: 8px;">
            <div style="display: flex; align-items: flex-start; gap: 12px; padding: 12px; border-radius: 12px; background: var(--tint-tomate); border: 1px solid var(--tomate);">
              <div style="width: 32px; height: 32px; border-radius: 999px; background: var(--tomate); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--mauvais-ink)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              </div>
              <div style="min-width: 0;">
                <div style="font-size: 13px; font-weight: 700; color: var(--mauvais-ink);">Sucres élevés</div>
                <div style="font-size: 11.5px; color: var(--mauvais-ink); margin-top: 2px; line-height: 1.45;">&gt; 22,5 g / 100 g · l'OMS recommande max 25 g / jour.</div>
              </div>
            </div>
            <div style="display: flex; align-items: flex-start; gap: 12px; padding: 12px; border-radius: 12px; background: var(--tint-citron); border: 1px solid var(--score-mediocre);">
              <div style="width: 32px; height: 32px; border-radius: 999px; background: var(--score-mediocre); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--mediocre-ink)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              </div>
              <div style="min-width: 0;">
                <div style="font-size: 13px; font-weight: 700; color: var(--mediocre-ink);">NOVA 4 — Ultra-transformé</div>
                <div style="font-size: 11.5px; color: var(--mediocre-ink); margin-top: 2px; line-height: 1.45;">Contient des additifs et ingrédients industriels.</div>
              </div>
            </div>
            <div style="display: flex; align-items: flex-start; gap: 12px; padding: 12px; border-radius: 12px; background: var(--tint-menthe); border: 1px solid var(--menthe);">
              <div style="width: 32px; height: 32px; border-radius: 999px; background: var(--menthe); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--brand-ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <div style="min-width: 0;">
                <div style="font-size: 13px; font-weight: 700; color: var(--brand-ink);">Riche en fibres</div>
                <div style="font-size: 11.5px; color: var(--brand-ink); margin-top: 2px; line-height: 1.45;">≥ 6 g / 100 g · favorise la digestion et la satiété.</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ═══ 5. LEADERBOARD ═══ -->
      <div class="preview-block">
        <div class="preview-label">Leaderboard</div>
        <div class="card" style="width: 460px; padding: 20px;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
            <div style="display: flex; align-items: center; gap: 10px;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--menthe)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
              <div style="font-size: 14px; font-weight: 800; color: var(--encre);">Classement</div>
            </div>
            <div style="font-size: 11px; color: var(--muted); font-weight: 600;">Top contributeurs</div>
          </div>

          <!-- #1 -->
          <div style="display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 12px; background: linear-gradient(90deg, var(--tint-citron) 0%, var(--card) 60%); border: 1px solid var(--citron); margin-bottom: 6px;">
            <div style="width: 24px; display: flex; align-items: center; justify-content: center; font-size: 16px;">🥇</div>
            <div style="width: 36px; height: 36px; border-radius: 999px; background: linear-gradient(135deg, var(--score-mediocre), var(--mediocre-ink)); display: flex; align-items: center; justify-content: center; color: var(--encre); font-weight: 800; font-size: 14px;">A</div>
            <div style="flex: 1; min-width: 0;">
              <div style="display: flex; align-items: center; gap: 6px;">
                <div style="font-size: 13px; font-weight: 700; color: var(--encre);">Amine B.</div>
                <span style="padding: 1px 7px; border-radius: 999px; background: var(--score-mediocre); color: var(--encre); font-size: 9px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase;">Expert</span>
              </div>
              <div style="font-size: 11px; color: var(--muted); margin-top: 1px;">34 contributions</div>
            </div>
            <div style="text-align: right;">
              <div style="font-size: 18px; font-weight: 900; color: var(--brand-ink); line-height: 1;">340</div>
              <div style="font-size: 9px; color: var(--muted); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">pts</div>
            </div>
          </div>

          <!-- #2 -->
          <div style="display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 12px; background: var(--creme); border: 1px solid var(--muted-bg); margin-bottom: 6px;">
            <div style="width: 24px; display: flex; align-items: center; justify-content: center; font-size: 16px;">🥈</div>
            <div style="width: 36px; height: 36px; border-radius: 999px; background: linear-gradient(135deg, var(--score-bon), var(--brand-ink)); display: flex; align-items: center; justify-content: center; color: var(--encre); font-weight: 800; font-size: 14px;">Y</div>
            <div style="flex: 1; min-width: 0;">
              <div style="display: flex; align-items: center; gap: 6px;">
                <div style="font-size: 13px; font-weight: 700; color: var(--encre);">Youssef M.</div>
                <span style="padding: 1px 7px; border-radius: 999px; background: var(--score-bon); color: var(--encre); font-size: 9px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase;">Contributeur</span>
              </div>
              <div style="font-size: 11px; color: var(--muted); margin-top: 1px;">18 contributions</div>
            </div>
            <div style="text-align: right;">
              <div style="font-size: 18px; font-weight: 900; color: var(--brand-ink); line-height: 1;">210</div>
              <div style="font-size: 9px; color: var(--muted); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">pts</div>
            </div>
          </div>

          <!-- #3 -->
          <div style="display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 12px; background: var(--creme); border: 1px solid var(--muted-bg);">
            <div style="width: 24px; display: flex; align-items: center; justify-content: center; font-size: 16px;">🥉</div>
            <div style="width: 36px; height: 36px; border-radius: 999px; background: linear-gradient(135deg, var(--score-bon), var(--brand-ink)); display: flex; align-items: center; justify-content: center; color: var(--encre); font-weight: 800; font-size: 14px;">F</div>
            <div style="flex: 1; min-width: 0;">
              <div style="display: flex; align-items: center; gap: 6px;">
                <div style="font-size: 13px; font-weight: 700; color: var(--encre);">Fatima Z.</div>
                <span style="padding: 1px 7px; border-radius: 999px; background: var(--score-bon); color: var(--encre); font-size: 9px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase;">Contributeur</span>
              </div>
              <div style="font-size: 11px; color: var(--muted); margin-top: 1px;">15 contributions</div>
            </div>
            <div style="text-align: right;">
              <div style="font-size: 18px; font-weight: 900; color: var(--brand-ink); line-height: 1;">185</div>
              <div style="font-size: 9px; color: var(--muted); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">pts</div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <script is:inline>
      console.log('%c📸 Capture des previews Bayen', 'font-size:14px;font-weight:bold;color:var(--menthe)');
      console.log('1. Clic-droit sur un .preview-block → Inspecter');
      console.log('2. Dans le DOM, clic-droit sur l\'élément → "Capture node screenshot"');
      console.log('3. Pour un fond transparent : masquer body { background: white } dans Styles');
    </script>
  </body>
</html>

---
export const prerender = false
import Layout from '@/layouts/Layout.astro'
import PageHero from '@/components/PageHero.astro'
import BulkOffImporter from '@/components/BulkOffImporter.tsx'
import { getLocale, t } from '@/lib/i18n'

const locale = getLocale(Astro.cookies?.get('bayen_locale')?.value ?? null)
---

<Layout title="Import OFF — Admin — Bayen" path="/admin/import-off" noindex={true} mobileTopbar={false}>
  <PageHero
    tone="primary"
    kicker={t('userMenu.admin', locale)}
    title={t('import.bulkTitle', locale)}
    subtitle={t('import.bulkSubtitle', locale)}
  />

  <main class="screen pt-5 md:pt-10">
    <section class="section">
      <BulkOffImporter client:load />
    </section>
  </main>
</Layout>

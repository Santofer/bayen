---
// Page marque (SSR) — liste des produits d'une marque
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import PageHero from '@/components/PageHero.astro'
import ProductCard from '@/components/ProductCard.tsx'
import { getLocale, t } from '@/lib/i18n'
import type { Product } from '@/lib/types'

const localeCookie = Astro.cookies?.get('bayen_locale')?.value ?? null
const locale = getLocale(localeCookie)
const { name } = Astro.params
const brandName = decodeURIComponent(name ?? '')
const DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL ?? 'https://api.bayen.ma'

let products: Record<string, unknown>[] = []
try {
  const res = await fetch(
    `${DIRECTUS_URL}/items/products?filter[brand][_icontains]=${encodeURIComponent(brandName)}&filter[status][_eq]=published&sort=-scan_count&limit=50&fields=*`
  )
  if (res.ok) {
    const data = await res.json()
    products = data.data ?? []
  }
} catch {}

const pageTitle = `${brandName} — Produits et scores Bayen`
const pageDescription = `Tous les produits de la marque ${brandName} disponibles au Maroc, leur score nutritionnel et leurs additifs.`
---

<Layout
  title={pageTitle}
  description={pageDescription}
  path={`/marque/${encodeURIComponent(name ?? '')}`}
  mobileTopbar={false}
>
  <PageHero tone="primary" back="/recherche" kicker={t('contribute.brand', locale)} title={brandName} subtitle={`${products.length} ${t(products.length !== 1 ? 'history.itemsPlural' : 'history.itemSingular', locale)}`} />

  <main class="screen">
    <section class="section gap-3">
      {products.length > 0 ? (
        <Fragment>
          {/* Liste comme la recherche : cartes en ligne (mobile), grille (ordinateur) */}
          <div class="grid gap-3 md:hidden">
            {products.map((product) => <ProductCard product={product as unknown as Product} locale={locale} />)}
          </div>
          <div class="hidden gap-4 md:grid md:grid-cols-3 lg:grid-cols-4">
            {products.map((product) => <ProductCard product={product as unknown as Product} variant="grid" locale={locale} />)}
          </div>
        </Fragment>
      ) : (
        <Fragment>
          <div class="naanaa md:max-w-xl">
            <img src="/mascotte/naanaa-loupe.webp" alt="" width="72" height="106" loading="lazy" />
            <p class="bubble">{t('brand.empty', locale)}</p>
          </div>
          <a href="/scan" class="btn primary justify-self-start">{t('nav.scan', locale)}</a>
        </Fragment>
      )}

      <div class="naanaa mt-1.5 grid-cols-[56px_minmax(0,1fr)] md:max-w-xl">
        <div class="m size-14"><img src="/mascotte/naanaa-scan.webp" alt="" width="56" height="56" loading="lazy" /></div>
        <p class="bubble">{t('search.naanaaMissing', locale)} <a href="/scan" class="underline underline-offset-2"><b>{t('search.naanaaScan', locale)}</b></a>{t('search.naanaaAdd', locale)}</p>
      </div>
    </section>
  </main>
</Layout>

---
// Analyse de photo de repas (maquette « Repas ») via le serveur vision (Qwen3.5-9B).
// Le composant React gère tout le flux : upload → /api/meal-score → estimation.
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import MealPhotoAnalyzer from '@/components/MealPhotoAnalyzer'
import { getLocale, t } from '@/lib/i18n'

const localeCookie = Astro.cookies?.get('bayen_locale')?.value ?? null
const locale = getLocale(localeCookie)
---

<Layout
  title={`${t('meal.pageTitle', locale)} — Bayen`}
  description={t('meal.pageSubtitle', locale)}
  path="/analyser-repas"
  mobileTopbar={false}
>
  <!-- Barre du haut de la maquette : retour + puce « Analyse de repas » -->
  <header class="topbar pb-0 md:hidden">
    <a class="icon-btn" href="/" aria-label={t('nav.back', locale)}>
      <svg class="rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
    </a>
    <span class="chip fill bg-ai">Analyse de repas</span>
  </header>

  <main class="screen max-md:pt-5">
    <MealPhotoAnalyzer client:load />
  </main>
</Layout>

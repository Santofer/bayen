---
// Analyse de photo de repas (maquette « Repas ») via le serveur vision (Qwen3.5-9B).
// Le composant React gère tout le flux : upload → /api/meal-score → estimation.
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import MealPhotoAnalyzer from '@/components/MealPhotoAnalyzer'
import AsidePhoto from '@/components/AsidePhoto.astro'
import { getLocale, t } from '@/lib/i18n'

const localeCookie = Astro.cookies?.get('bayen_locale')?.value ?? null
const locale = getLocale(localeCookie)
---

<Layout
  title={`${t('meal.pageTitle', locale)} — Bayen`}
  description={t('meal.pageSubtitle', locale)}
  path="/analyser-repas"
  mobileTopbar={false}
>
  <!-- Barre du haut de la maquette : retour + puce « Analyse de repas » -->
  <header class="topbar pb-0 md:hidden">
    <a class="icon-btn" href="/" aria-label={t('nav.back', locale)}>
      <svg class="rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
    </a>
    <div class="flex items-center gap-2">
      <span class="chip fill bg-ai">{t('meal.chip', locale)}</span>
      <button type="button" class="icon-btn " data-open-menu aria-label={t('nav.menu', locale)}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg></button>
    </div>
  </header>

  <main class="screen max-md:pt-5">
    <!-- Ordinateur : l'outil à gauche, un repas analysé à droite pour équilibrer la page -->
    <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,.8fr)] md:items-start">
      <div class="min-w-0"><MealPhotoAnalyzer client:load /></div>
      <AsidePhoto src="/visuels/repas-ecran.webp" alt={t('visual.meal', locale)} />
    </div>
  </main>
</Layout>

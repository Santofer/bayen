---
// Page liste des catégories (SSR)
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import PageHero from '@/components/PageHero.astro'
import { getLocale, t } from '@/lib/i18n'

const localeCookie = Astro.cookies?.get('bayen_locale')?.value ?? null
const locale = getLocale(localeCookie)
const DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL ?? 'https://api.bayen.ma'

interface Category {
  id: number
  slug: string
  name_fr: string
  name_ar?: string | null
  icon?: string | null
  product_count: number
}

let categories: Category[] = []
try {
  // Récupérer catégories + comptage en parallèle
  const [catRes, countRes] = await Promise.all([
    fetch(
      `${DIRECTUS_URL}/items/categories?sort=name_fr&limit=-1&fields=id,slug,name_fr,name_ar,icon`,
      { signal: AbortSignal.timeout(4000) }
    ),
    fetch(
      `${DIRECTUS_URL}/items/products?filter[status][_eq]=published&groupBy[]=category_id&aggregate[count]=id&limit=-1`,
      { signal: AbortSignal.timeout(4000) }
    ),
  ])

  const rawCats: Omit<Category, 'product_count'>[] = catRes.ok
    ? (await catRes.json()).data ?? []
    : []

  // Map catégorie → count
  const countMap = new Map<number, number>()
  if (countRes.ok) {
    const countData = await countRes.json()
    for (const row of countData.data ?? []) {
      const cid = typeof row.category_id === 'object' ? row.category_id?.id : row.category_id
      const cnt = parseInt(row.count?.id ?? '0', 10)
      if (cid != null && !isNaN(cnt)) countMap.set(Number(cid), cnt)
    }
  }

  categories = rawCats.map((c) => ({
    ...c,
    product_count: countMap.get(c.id) ?? 0,
  }))

  // Trier : catégories avec produits en premier, puis par nom
  categories.sort((a, b) => {
    if ((a.product_count > 0) !== (b.product_count > 0)) {
      return a.product_count > 0 ? -1 : 1
    }
    return a.name_fr.localeCompare(b.name_fr, 'fr')
  })
} catch {
  // Page s'affiche même si l'API est down
}

// Slugs disposant d'un visuel dédié (générés par IA, palette Bayen).
// Les autres retombent sur _fallback.jpg. Voir /public/categories/.
const CATEGORY_IMAGES = new Set<string>([
  'biscuits',
  'cereales-petit-dejeuner',
  'produits-laitiers',
  'charcuterie-viandes',
  'boissons-sucrees',
  'eaux-jus',
  'conserves',
  'epices-condiments',
  'huiles-graisses',
  'snacks-chips',
  'pain-viennoiseries',
  'plats-prepares',
])
const categoryImage = (slug: string) =>
  `/categories/${CATEGORY_IMAGES.has(slug) ? slug : '_fallback'}.jpg?v=2`

const pageTitle = locale === 'ary' ? 'الفئات — باين' : 'Catégories — Bayen'
const pageHeading = locale === 'ary' ? 'الفئات' : 'Catégories'
const pageSubtitle = locale === 'ary'
  ? `${categories.length} فئة`
  : `${categories.length} catégorie${categories.length !== 1 ? 's' : ''}`
const emptyMsg = locale === 'ary'
  ? 'حتا فئة ما متوفرة دابا.'
  : 'Aucune catégorie disponible pour le moment.'
// Aplats Marché Pop en rotation sous chaque visuel (texte encre)
const TILE_COLORS = ['menthe', 'citron', 'framboise', 'myrtille', 'figue', 'tomate'] as const
const productsSuffix = (count: number) => {
  if (locale === 'ary') return `${count} منتج`
  return `${count} produit${count !== 1 ? 's' : ''}`
}
---

<Layout title={pageTitle} path="/categories" mobileTopbar={false}>
  <PageHero tone="primary" kicker={t('search.categories', locale)} title={pageHeading} subtitle={`${pageSubtitle} · ${t('nav.d.categories', locale)}`}>
    <svg slot="icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
  </PageHero>

  <main class="screen">
    <section class="section">
      {/* Cartes d'aplat (motif « Choisis ton univers ») : visuel, titre, compteur */}
      {categories.length > 0 ? (
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:gap-4 lg:grid-cols-4">
          {categories.map((cat, i) => {
            const name = locale === 'ary' && cat.name_ar ? cat.name_ar : cat.name_fr
            return (
              <a
                href={`/categories/${cat.slug}`}
                class:list={['card grid content-start gap-3.5 p-3.5 text-encre', cat.product_count === 0 && 'opacity-70']}
                style={`background: var(--color-${TILE_COLORS[i % TILE_COLORS.length]})`}
              >
                <span class="tile aspect-[4/3]">
                  <img src={categoryImage(cat.slug)} alt="" loading="lazy" />
                </span>
                <span>
                  <b class="disp d-s block">{name}</b>
                  <span class="text-[12.5px]">{productsSuffix(cat.product_count)}</span>
                </span>
              </a>
            )
          })}
        </div>
      ) : (
        <div class="naanaa md:max-w-xl">
          <img src="/mascotte/naanaa-oups.webp" alt="" width="72" height="106" />
          <p class="bubble">{emptyMsg}</p>
        </div>
      )}
    </section>
  </main>
</Layout>

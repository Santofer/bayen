---
import '@/styles/globals.css'

import SeoHead from '@/components/SeoHead.astro'
import UserMenu from '@/components/UserMenu'
import LocaleToggle from '@/components/LocaleToggle'
import ThemeToggle from '@/components/ThemeToggle'
import Logo from '@/components/Logo.astro'
import CartNavButton from '@/components/CartNavButton'
import InstallPrompt from '@/components/InstallPrompt'
import SiteMenu from '@/components/SiteMenu.astro'
import { getLocale, t } from '@/lib/i18n'

// Lire la locale depuis le cookie SSR
const localeCookie = Astro.cookies?.get('bayen_locale')?.value ?? null
const locale = getLocale(localeCookie)
const dir = locale === 'ary' ? 'rtl' : 'ltr'
const lang = locale === 'ary' ? 'ar' : 'fr'

interface Props {
  title: string
  description?: string
  /** Cacher la navigation (ex: mode scanner plein écran) */
  hideNav?: boolean
  /** URL path pour canonical (ex: /produit/123) */
  path?: string
  /** URL image OG */
  ogImage?: string
  /** Type OG */
  ogType?: 'website' | 'article' | 'product'
  /** JSON-LD Schema.org */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  /** Ne pas indexer */
  noindex?: boolean
  /** Univers de la page : rethème tous les tokens (beauté framboise, protéines myrtille) */
  universe?: 'beauty' | 'protein'
  /** Barre du haut mobile par défaut (logo + bouton). false = la page dessine la sienne */
  mobileTopbar?: boolean
}

const { title, description = 'Bayen — Scannez. Comprenez. Choisissez mieux.', hideNav = false, path, ogImage, ogType, jsonLd, noindex, universe, mobileTopbar = true } = Astro.props
const currentPath = Astro.url.pathname

// En-tête ordinateur (maquette « Desktop ») : les univers, puis Connexion et Scanner
const NAV = [
  { href: '/recherche', label: t('nav.food', locale) },
  { href: '/beaute', label: t('nav.beauty', locale) },
  { href: '/proteines', label: t('nav.protein', locale) },
  { href: '/analyser-repas', label: t('nav.meal', locale) },
  { href: '/blog', label: t('nav.journalBlog', locale) },
]

// Pied de page : toutes les pages qui ne sont pas dans l'en-tête restent accessibles ici
const FOOTER_LINKS = [
  { href: '/methodologie', label: t('footer.methodology', locale) },
  { href: '/contribuer', label: t('nav.contribute', locale) },
  { href: '/classement', label: t('nav.ranking', locale) },
  { href: '/partenaires', label: t('nav.partners', locale) },
  { href: '/a-propos', label: t('footer.about', locale) },
  { href: '/categories', label: t('search.categories', locale) },
  { href: '/additifs', label: t('nav.additives', locale) },
  { href: '/ingredients', label: t('nav.ingredients', locale) },
  { href: '/ingredients-cosmetiques', label: t('nav.inci', locale) },
  { href: '/comparer', label: t('nav.compare', locale) },
  { href: '/panier', label: t('nav.cart', locale) },
  { href: '/importer', label: t('home.import', locale) },
]
const SCAN_ICON = '<path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3"/><path d="M8 9v6M11 9v6M14 9v6M17 9v6"/>'
---

<!doctype html>
<html lang={lang} dir={dir} id="html-root">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFF8EC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1D1430" media="(prefers-color-scheme: dark)" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.ico?v=3" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=3" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.bayen.ma" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@600;700;800&family=Readex+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <SeoHead title={title} description={description} path={path} ogImage={ogImage} ogType={ogType} jsonLd={jsonLd} noindex={noindex} />
    <!-- Appliquer locale + thème sauvegardés avant le premier paint -->
    <script is:inline>
      (function() {
        try {
          var l = localStorage.getItem('bayen_locale');
          if (l === 'ary') {
            document.documentElement.setAttribute('lang', 'ar');
            document.documentElement.setAttribute('dir', 'rtl');
          }
          var t = localStorage.getItem('bayen_theme');
          if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
          }
        } catch(e) {}
      })();
    </script>
    <!-- Umami analytics — tracking anonymisé, auto-hébergé sur umami.n0.ma -->
    <script is:inline defer src="https://umami.n0.ma/script.js" data-website-id="0d7f39e8-44c0-4ec7-bcbc-01ad7917a368"></script>
  </head>
  <body class:list={["min-h-screen bg-background font-sans antialiased overflow-x-hidden", universe === 'beauty' && 'univ-beauty', universe === 'protein' && 'univ-protein']}>
    {!hideNav && (
      <header class="site-header hidden md:block">
        <div class="in">
          <a class="logo" href="/" aria-label={t('layout.homeAria', locale)}><Logo label="" /></a>
          <nav aria-label={t('nav.main', locale)}>
            {NAV.map((n) => (
              <a href={n.href} aria-current={currentPath.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
            ))}
            <button type="button" class="nav-more" data-open-menu aria-haspopup="dialog">
              {t('nav.more', locale)}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </button>
          </nav>
          <CartNavButton label={t('nav.cart', locale)} client:load />
          <UserMenu client:load />
          <a class="btn sm primary" href="/scan">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={SCAN_ICON} />
            {t('nav.scan', locale)}
          </a>
        </div>
      </header>
    )}

    {!hideNav && mobileTopbar && (
      <!-- Barre du haut mobile (maquette « Accueil ») : logo + un bouton rond -->
      <header class="topbar md:hidden">
        <a class="logo" href="/" aria-label={t('layout.homeAria', locale)}><Logo label="" /></a>
        <div class="flex gap-2">
          <slot name="topbar-end"><CartNavButton label={t('nav.cart', locale)} client:load /></slot>
          <button type="button" class="icon-btn " data-open-menu aria-label={t('nav.menu', locale)}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg></button>
        </div>
      </header>
    )}

    <slot />

    {!hideNav && <SiteMenu />}
    {!hideNav && (
      <!-- Le sigle reste à l'écran au défilement et ouvre le menu (voir .sigle-fab) -->
      <button type="button" class="sigle-fab" data-open-menu aria-haspopup="dialog" aria-label={t('nav.menu', locale)}>
        <Logo variant="sigle" label="" />
      </button>
    )}

    {!hideNav && (
      <footer class="site-footer mt-12 pb-28 md:pb-0">
        <div class="mx-auto flex max-w-[1240px] flex-wrap justify-between gap-6 px-[18px] py-10 md:px-8">
          <div class="grid max-w-[360px] content-start gap-2">
            <a class="logo" href="/" aria-label={t('layout.homeAria', locale)}><Logo label="" /></a>
            <p class="text-sm opacity-85">{t('footer.tagline', locale)}</p>
            <div class="mt-2 flex items-center gap-3">
              <ThemeToggle client:load />
              <LocaleToggle client:load />
            </div>
          </div>
          <nav aria-label={t('layout.footerNav', locale)} class="grid grid-cols-2 gap-x-8 gap-y-2 text-sm sm:grid-cols-3">
            {FOOTER_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
          </nav>
        </div>
        <div class="mx-auto flex max-w-[1240px] flex-col gap-1 border-t border-current/15 px-[18px] py-5 text-xs opacity-70 sm:flex-row sm:justify-between md:px-8">
          <p>
            {t('footer.initiative', locale)}
            <a href="https://www.n0.ma" target="_blank" rel="noopener noreferrer" class="font-medium">N0</a>
            &
            <a href="https://netspace.ma" target="_blank" rel="noopener noreferrer" class="font-medium">Netspace</a>
            · <a href="mailto:contact@n0.ma">{t('layout.contact', locale)}</a>
          </p>
          <p>
            {t('footer.dataFrom', locale)}
            <a href="https://world.openfoodfacts.org/" target="_blank" rel="noopener noreferrer" class="font-medium">Open Food Facts</a>
            (ODbL)
          </p>
        </div>
      </footer>
    )}

    {!hideNav && (
      <!-- Barre d'onglets mobile : îlot flottant, scan au centre -->
      <nav class="tabbar md:hidden" aria-label={t('nav.main', locale)}>
        <a href="/" class:list={[{ on: currentPath === '/' }]} aria-current={currentPath === '/' ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z" /></svg>
          {t('nav.home', locale)}
        </a>
        <a href="/recherche" class:list={[{ on: currentPath.startsWith('/recherche') }]} aria-current={currentPath.startsWith('/recherche') ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg>
          {t('nav.searchShort', locale)}
        </a>
        <a href="/scan" class="tab-scan" aria-label={t('nav.scan', locale)}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3" /><path d="M8 9v6M11 9v6M14 9v6M17 9v6" /></svg>
        </a>
        <a href="/analyser-repas" class:list={[{ on: currentPath.startsWith('/analyser-repas') }]} aria-current={currentPath.startsWith('/analyser-repas') ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="4.5" /></svg>
          {t('nav.mealShort', locale)}
        </a>
        <a href="/compte" class:list={[{ on: currentPath.startsWith('/compte') }]} aria-current={currentPath.startsWith('/compte') ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c1-4.5 4.5-6.5 8-6.5s7 2 8 6.5" /></svg>
          {t('nav.account', locale)}
        </a>
      </nav>
    )}


    <!-- PWA : install prompt + service worker (jamais en dev — il servirait
         du stale pendant les compilations lentes et masquerait les changements) -->
    <InstallPrompt client:idle />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        if (location.hostname === 'localhost' || location.hostname === '127.0.0.1') {
          navigator.serviceWorker.getRegistrations().then(function (regs) {
            regs.forEach(function (r) { r.unregister() })
          })
        } else {
          navigator.serviceWorker.register('/sw.js').catch(() => {})
        }
      }
    </script>

    <!-- Error reporter global (fire-and-forget vers /bayen-api/log-error) -->
    <script>
      import { installGlobalErrorReporter } from '@/lib/report-error'
      installGlobalErrorReporter()
    </script>

    <style is:global>
      @keyframes scan {
        0%, 100% { top: 10%; }
        50% { top: 90%; }
      }
      .animate-scan {
        animation: scan 2s ease-in-out infinite;
      }
      /* Safe area pour la barre de navigation mobile */
      .safe-area-pb {
        padding-bottom: env(safe-area-inset-bottom, 0px);
      }
    </style>

    <script is:inline>
      // ── Moteur d'interactions Bayen (léger, 60 fps, passif) ──────
      (function () {
        var html = document.documentElement;
        var scrollTimer = null;

        // ── Session anonyme persistante (mesure d'usage, zéro donnée perso) ──
        // Le SSR de la fiche produit lit ces cookies pour attribuer le scan à
        // une session stable au lieu d'en créer une nouvelle à chaque vue.
        try {
          var sid = localStorage.getItem('bayen_session_id');
          if (!sid) {
            sid = (crypto && crypto.randomUUID) ? crypto.randomUUID()
              : 'sid-' + Date.now() + '-' + Math.random().toString(36).slice(2);
            localStorage.setItem('bayen_session_id', sid);
          }
          var dev = window.matchMedia('(max-width: 768px)').matches ? 'mobile' : 'desktop';
          document.cookie = 'bayen_sid=' + sid + ';path=/;max-age=31536000;SameSite=Lax';
          document.cookie = 'bayen_device=' + dev + ';path=/;max-age=31536000;SameSite=Lax';
        } catch (e) {}

        function onScroll() {
          // Scrollbar visible uniquement pendant le défilement
          if (!html.classList.contains('is-scrolling')) html.classList.add('is-scrolling');
          if (scrollTimer) clearTimeout(scrollTimer);
          scrollTimer = setTimeout(function () {
            html.classList.remove('is-scrolling');
          }, 900);
          // Bouton au sigle : visible une fois la barre du haut sortie de l'écran
          html.classList.toggle('scrolled', window.scrollY > 160);
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();

        // Révélation douce au scroll — progressive enhancement strict :
        // on ne masque QUE ce qui est sous le fold, et un filet de sécurité
        // re-révèle tout élément visible à chaque scroll (jamais de contenu perdu).
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        function vh() { return window.innerHeight || document.documentElement.clientHeight || 900; }
        if (!reduce && 'IntersectionObserver' in window) {
          var pending = [];
          document.querySelectorAll('.reveal').forEach(function (el) {
            var r = el.getBoundingClientRect();
            if (r.top > vh() * 0.92) {
              el.classList.add('reveal-init');
              pending.push(el);
            }
          });
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) reveal(e.target);
            });
          }, { threshold: 0.01 });
          function reveal(el) {
            el.classList.add('reveal-in');
            el.classList.remove('reveal-init');
            io.unobserve(el);
            var idx = pending.indexOf(el);
            if (idx > -1) pending.splice(idx, 1);
          }
          pending.forEach(function (el) { io.observe(el); });
          // Filet de sécurité : tout .reveal-init déjà dans le viewport est
          // révélé même si l'observer le rate (scroll + check périodique
          // auto-arrêté — couvre restauration bfcache, ancres, etc.).
          function sweep() {
            for (var i = pending.length - 1; i >= 0; i--) {
              var r = pending[i].getBoundingClientRect();
              if (r.top < vh() && r.bottom > 0) reveal(pending[i]);
            }
          }
          window.addEventListener('scroll', sweep, { passive: true });
          var sweeper = setInterval(function () {
            sweep();
            if (pending.length === 0) clearInterval(sweeper);
          }, 800);
        }
      })();
    </script>
  </body>
</html>

---
/**
 * Menu complet du site : feuille du bas sur mobile, fenêtre centrée sur ordinateur.
 * <dialog> natif (piège du focus, Échap, fond) ; tout élément `[data-open-menu]`
 * l'ouvre (barre du haut, bandeaux, lien « Plus » de l'en-tête).
 */
import ThemeToggle from '@/components/ThemeToggle'
import LocaleToggle from '@/components/LocaleToggle'
import { getLocale, t } from '@/lib/i18n'

const locale = getLocale(Astro.cookies?.get('bayen_locale')?.value ?? null)
const currentPath = Astro.url.pathname

const I = {
  leaf: '<path d="M5 19c0-8.5 5.5-14 14-14 0 9-5.5 14-14 14z"/><path d="M5 19l8-8"/>',
  drop: '<path d="M12 3c4 5 6.5 8 6.5 11.5a6.5 6.5 0 0 1-13 0C5.5 11 8 8 12 3z"/>',
  dumbbell: '<path d="M6 7v10M3 9v6M18 7v10M21 9v6M6 12h12"/>',
  grid: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>',
  flask: '<path d="M10 2v7.5a2 2 0 0 1-.2.9L4.7 20.5a1 1 0 0 0 .9 1.5h12.8a1 1 0 0 0 .9-1.5l-5.1-10.1a2 2 0 0 1-.2-.9V2"/><path d="M8.5 2h7"/>',
  sprout: '<path d="M7 20h10M12 20v-8M12 12c0-4-3-6-7-6 0 4 3 6 7 6zM12 12c0-4 3-6 7-6 0 4-3 6-7 6z"/>',
  spark: '<path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/>',
  scale: '<path d="M7 4v16M17 4v16M3 8h8M13 16h8"/>',
  scan: '<path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3"/><path d="M8 9v6M11 9v6M14 9v6M17 9v6"/>',
  camera: '<path d="M4 8h3l2-3h6l2 3h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"/><circle cx="12" cy="14" r="4"/>',
  basket: '<path d="m5 11 4-7M19 11l-4-7M2 11h20M3.5 11l1.6 7.4a2 2 0 0 0 2 1.6h9.8a2 2 0 0 0 2-1.6l1.7-7.4"/>',
  calendar: '<path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/>',
  history: '<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5M12 7v5l4 2"/>',
  shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21c1-4.5 4.5-6.5 8-6.5s7 2 8 6.5"/>',
  book: '<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>',
  plus: '<path d="M5 12h14M12 5v14"/>',
  trophy: '<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M18 2H6v7a6 6 0 0 0 12 0V2Z"/>',
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
  info: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>',
  ruler: '<path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M18 17V9M13 17V5M8 17v-3"/>',
}

// Aplats des pictos : univers et palette, jamais l'échelle de score pour un univers
const C = { menthe: 'var(--color-menthe)', citron: 'var(--color-citron)', framboise: 'var(--color-framboise)', myrtille: 'var(--color-myrtille)', figue: 'var(--color-figue)', tomate: 'var(--color-tomate)' }

const GROUPS = [
  {
    label: t('nav.explore', locale),
    items: [
      { href: '/recherche', label: t('nav.food', locale), icon: I.leaf, bg: C.menthe },
      { href: '/beaute', label: t('nav.beauty', locale), icon: I.drop, bg: C.framboise },
      { href: '/proteines', label: t('nav.protein', locale), icon: I.dumbbell, bg: C.myrtille },
      { href: '/categories', label: t('search.categories', locale), icon: I.grid, bg: C.citron },
      { href: '/additifs', label: t('nav.additives', locale), icon: I.flask, bg: C.tomate },
      { href: '/ingredients', label: t('nav.ingredients', locale), icon: I.sprout, bg: C.menthe },
      { href: '/ingredients-cosmetiques', label: t('nav.inci', locale), icon: I.spark, bg: C.framboise },
      { href: '/comparer', label: t('nav.compare', locale), icon: I.scale, bg: C.myrtille },
    ],
  },
  {
    label: t('nav.tools', locale),
    items: [
      { href: '/scan', label: t('nav.scan', locale), icon: I.scan, bg: C.menthe },
      { href: '/analyser-repas', label: t('nav.meal', locale), icon: I.camera, bg: C.figue },
      { href: '/panier', label: t('nav.cart', locale), icon: I.basket, bg: C.citron },
      { href: '/compte/journal', label: t('nav.journal', locale), icon: I.calendar, bg: C.figue },
      { href: '/mes-scans', label: t('nav.history', locale), icon: I.history, bg: C.myrtille },
      { href: '/profil', label: t('nav.profile', locale), icon: I.shield, bg: C.framboise },
      { href: '/compte', label: t('nav.account', locale), icon: I.user, bg: C.menthe },
    ],
  },
  {
    label: t('nav.community', locale),
    items: [
      { href: '/blog', label: t('nav.journalBlog', locale), icon: I.book, bg: C.citron },
      { href: '/contribuer', label: t('nav.contribute', locale), icon: I.plus, bg: C.menthe },
      { href: '/classement', label: t('nav.ranking', locale), icon: I.trophy, bg: C.citron },
      { href: '/partenaires', label: t('nav.partners', locale), icon: I.users, bg: C.myrtille },
      { href: '/a-propos', label: t('footer.about', locale), icon: I.info, bg: C.framboise },
      { href: '/methodologie', label: t('footer.methodology', locale), icon: I.ruler, bg: C.figue },
    ],
  },
]
---
<dialog id="site-menu" class="site-menu" aria-label={t('nav.menu', locale)}>
  <div class="sheet">
    <div class="flex items-center justify-between gap-3">
      <a class="logo" href="/" aria-label={t('layout.homeAria', locale)}>bayen<i></i></a>
      <form method="dialog">
        <button class="icon-btn" aria-label={t('nav.close', locale)}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
      </form>
    </div>
    {GROUPS.map((g) => (
      <section class="grid gap-2.5">
        <p class="eyebrow">{g.label}</p>
        <div class="grid grid-cols-2 gap-2 md:grid-cols-3">
          {g.items.map((it) => (
            <a href={it.href} class="menu-item" aria-current={currentPath === it.href ? 'page' : undefined}>
              <span class="ico" style={`--ico-bg: ${it.bg}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={it.icon} />
              </span>
              <span class="min-w-0">{it.label}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
    <div class="flex items-center justify-between gap-3 border-t-2 border-line/15 pt-3">
      <span class="eyebrow">{t('nav.display', locale)}</span>
      <div class="flex items-center gap-2">
        <ThemeToggle client:idle />
        <LocaleToggle client:idle />
      </div>
    </div>
  </div>
</dialog>

<script is:inline>
  (function () {
    var d = document.getElementById('site-menu');
    if (!d || !d.showModal) return;
    document.addEventListener('click', function (e) {
      var opener = e.target.closest && e.target.closest('[data-open-menu]');
      if (opener) { e.preventDefault(); d.showModal(); return; }
      // Clic sur le fond (hors de la feuille) : fermer
      if (e.target === d) d.close();
    });
  })();
</script>

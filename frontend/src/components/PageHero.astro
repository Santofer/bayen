---
/**
 * Hero de page « Marché Pop » : aplat de couleur, titre encre, visuel encadré
 * à droite (dessous sur mobile) et Naânaa en option.
 */
type Tone = 'primary' | 'citron' | 'tomate' | 'myrtille' | 'figue' | 'framboise' | 'beauty' | 'protein' | 'ai'
type Pose = 'salut' | 'astuce' | 'bravo' | 'loupe' | 'oups' | 'nuit' | 'scan' | 'courses'
interface Props {
  image: string
  title: string
  subtitle?: string
  kicker?: string
  tone?: Tone
  /** Pose de la mascotte Naânaa posée sur le hero (aucune par défaut) */
  mascot?: Pose
  size?: 'md' | 'lg'
  class?: string
}
const { image, title, subtitle, kicker, tone = 'primary', mascot, size = 'md', class: cls } = Astro.props
const BG: Record<Tone, string> = {
  primary: 'var(--color-menthe)',
  citron: 'var(--color-citron)',
  tomate: 'var(--color-tomate)',
  myrtille: 'var(--color-myrtille)',
  figue: 'var(--color-figue)',
  framboise: 'var(--color-framboise)',
  beauty: 'var(--color-framboise)',
  protein: 'var(--color-myrtille)',
  ai: 'var(--color-figue)',
}
---
<section class:list={['page-hero', size === 'lg' && 'lg', cls]} style={`--hero-bg: ${BG[tone]}`}>
  <img src={image} alt="" width="1280" height="720" fetchpriority="high" />
  <div class="inner">
    {kicker && <span class="kicker"><slot name="icon" />{kicker}</span>}
    <h1>{title}</h1>
    {subtitle && <p>{subtitle}</p>}
    <slot />
  </div>
  {mascot && <img class="mascot naanaa-bob" src={`/mascotte/naanaa-${mascot}.webp`} alt="" width="92" height="135" loading="lazy" />}
</section>

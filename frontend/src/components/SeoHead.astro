---
/**
 * Composant SEO — meta, OpenGraph, canonical, hreflang, JSON-LD
 * Inclus dans le Layout pour toutes les pages.
 *
 * Auto-injecte :
 *   - JSON-LD Organization + WebSite + SearchAction sur la homepage
 *   - hreflang FR + AR + x-default sur toutes les pages publiques
 *   - image OG par rubrique (public/og/*.jpg, générées par design/social/og/og.py), sinon og/default.jpg
 */

interface Props {
  title: string
  description: string
  /** URL canonique (sans domaine, ex: /produit/123) */
  path?: string
  /** URL image OG (pour les previews WhatsApp/social) */
  ogImage?: string
  /** Type OG (website par défaut, article pour blog, product pour fiches) */
  ogType?: 'website' | 'article' | 'product'
  /** Données JSON-LD Schema.org additionnelles (en plus des defaults) */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  /** Ne pas indexer cette page */
  noindex?: boolean
}

const {
  title,
  description,
  path = '/',
  ogImage,
  ogType = 'website',
  jsonLd,
  noindex = false,
} = Astro.props

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://bayen.ma'
const canonicalUrl = `${siteUrl}${path}`
// Image OG par rubrique (premier segment du chemin) ; les pages qui en ont une propre la passent en prop
const OG_PAGES: Record<string, string> = {
  beaute: 'beaute', 'ingredients-cosmetiques': 'beaute', proteines: 'proteines', 'analyser-repas': 'repas',
  comparer: 'comparer', classement: 'classement', methodologie: 'methodologie', partenaires: 'partenaires',
  additifs: 'additifs', ingredients: 'additifs', blog: 'journal', contribuer: 'contribuer', 'a-propos': 'a-propos',
  categories: 'rayons', marque: 'rayons',
}
const ogImageUrl = ogImage ?? `${siteUrl}/og/${OG_PAGES[path.split('/')[1] ?? ''] ?? 'default'}.jpg`

// ─── JSON-LD Organization + WebSite injectés automatiquement sur '/' ────
const isHomepage = path === '/' || path === ''

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'Bayen',
  alternateName: 'باين',
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/logo-bayen.svg`,
    width: 600,
    height: 285,
  },
  description: 'Application web gratuite qui note les produits alimentaires et cosmétiques vendus au Maroc : score sur 100, additifs, ingrédients et alternatives, en français et en darija.',
  foundingDate: '2026-04',
  founder: {
    '@type': 'Person',
    name: 'Amine Benboubker',
    url: 'https://www.n0.ma',
  },
  sameAs: [
    'https://github.com/Santofer/bayen',
    'https://www.n0.ma',
    'https://netspace.ma',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: 'contact@n0.ma',
    availableLanguage: ['French', 'Arabic'],
  },
  areaServed: { '@type': 'Country', name: 'Morocco' },
}

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: 'Bayen — Scannez. Comprenez. Choisissez mieux.',
  description: 'Notation participative des produits alimentaires et cosmétiques au Maroc.',
  publisher: { '@id': `${siteUrl}/#organization` },
  inLanguage: ['fr-MA', 'ar-MA'],
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/recherche?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
}

// Concaténer les schemas : defaults + ceux passés en props
const allSchemas: Record<string, unknown>[] = []
if (isHomepage) {
  allSchemas.push(organizationLd, websiteLd)
}
if (jsonLd) {
  if (Array.isArray(jsonLd)) allSchemas.push(...jsonLd)
  else allSchemas.push(jsonLd)
}
---

<!-- Canonical -->
<link rel="canonical" href={canonicalUrl} />

<!-- Hreflang : FR + AR (le site est bilingue via cookie bayen_locale,
     les URLs sont identiques mais Google doit savoir que le contenu
     existe en 2 langues). x-default pointe vers la version FR. -->
<link rel="alternate" hreflang="fr-MA" href={canonicalUrl} />
<link rel="alternate" hreflang="ar-MA" href={canonicalUrl} />
<link rel="alternate" hreflang="x-default" href={canonicalUrl} />

<!-- OpenGraph — WhatsApp, Facebook, Twitter -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="Bayen · باين" />
<meta property="og:locale" content="fr_MA" />
<meta property="og:locale:alternate" content="ar_MA" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Robots -->
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- JSON-LD Schema.org -->
{allSchemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}

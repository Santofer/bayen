---
/**
 * Composant SEO — meta, OpenGraph, canonical, hreflang, JSON-LD
 * Inclus dans le Layout pour toutes les pages.
 *
 * Auto-injecte :
 *   - JSON-LD Organization + WebSite + SearchAction sur TOUTES les pages, dans un seul @graph avec les nœuds
 *     de la page : les références @id (#organization, #website, a-propos#person) se résolvent partout
 *   - hreflang fr-MA + x-default (la darija n'a pas encore d'URL propre : pas de hreflang ar-MA)
 *   - image OG par rubrique (public/og/*.jpg, générées par design/social/og/og.py), sinon og/default.jpg
 */

interface Props {
  title: string
  description: string
  /** URL canonique (sans domaine, ex: /produit/123) */
  path?: string
  /** URL image OG (pour les previews WhatsApp/social) */
  ogImage?: string
  /** Type OG (website par défaut, article pour blog, product pour fiches) */
  ogType?: 'website' | 'article' | 'product'
  /** Données JSON-LD Schema.org additionnelles (en plus des defaults) */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  /** Ne pas indexer cette page */
  noindex?: boolean
}

const {
  title,
  description,
  path = '/',
  ogImage,
  ogType = 'website',
  jsonLd,
  noindex = false,
} = Astro.props

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://bayen.ma'
const canonicalUrl = `${siteUrl}${path}`
// Image OG par rubrique (premier segment du chemin) ; les pages qui en ont une propre la passent en prop
const OG_PAGES: Record<string, string> = {
  beaute: 'beaute', 'ingredients-cosmetiques': 'beaute', proteines: 'proteines', 'analyser-repas': 'repas',
  comparer: 'comparer', classement: 'classement', methodologie: 'methodologie', partenaires: 'partenaires',
  additifs: 'additifs', ingredients: 'additifs', blog: 'journal', contribuer: 'contribuer', 'a-propos': 'a-propos',
  categories: 'rayons', marque: 'rayons',
}
const ogImageUrl = ogImage ?? `${siteUrl}/og/${OG_PAGES[path.split('/')[1] ?? ''] ?? 'default'}.jpg`

// ─── JSON-LD Organization + WebSite, émis sur toutes les pages ────
const organizationLd = {
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'Bayen',
  alternateName: 'باين',
  url: `${siteUrl}/`,
  // Logo carré en PNG (dimensions réelles), plutôt que le wordmark SVG
  logo: {
    '@type': 'ImageObject',
    '@id': `${siteUrl}/#logo`,
    url: `${siteUrl}/icons/icon-512.png`,
    width: 512,
    height: 512,
  },
  image: { '@id': `${siteUrl}/#logo` },
  description: 'Application web gratuite qui note les produits alimentaires et cosmétiques vendus au Maroc : score sur 100, additifs, ingrédients et alternatives, en français et en darija.',
  foundingDate: '2026-04',
  publishingPrinciples: `${siteUrl}/methodologie`,
  founder: {
    '@type': 'Person',
    '@id': `${siteUrl}/a-propos#person`,
    name: 'Amine Benboubker',
    url: 'https://aminebenboubker.com',
  },
  parentOrganization: { '@type': 'Organization', name: 'N0', url: 'https://n0.ma' },
  // Profils propres à Bayen (page Facebook : URL à ajouter quand elle sera confirmée)
  sameAs: [
    'https://www.instagram.com/bayenma',
    'https://www.linkedin.com/company/bayen-ma',
    'https://github.com/Santofer/bayen',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: 'contact@n0.ma',
    availableLanguage: ['French', 'Arabic'],
  },
  areaServed: { '@type': 'Country', name: 'Morocco' },
}

const websiteLd = {
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: `${siteUrl}/`,
  name: 'Bayen',
  alternateName: 'باين',
  description: 'Notation participative des produits alimentaires et cosmétiques au Maroc.',
  publisher: { '@id': `${siteUrl}/#organization` },
  inLanguage: 'fr-MA',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/recherche?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
}

// Un seul @graph : nœuds globaux + nœuds de la page (leur @context est retiré, porté par le graphe ;
// une page qui passe déjà un { '@graph': [...] } voit ses nœuds dépliés)
const pageNodes = (jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])
  .flatMap((node) => (Array.isArray(node['@graph']) ? (node['@graph'] as Record<string, unknown>[]) : [node]))
  .map((node) => Object.fromEntries(Object.entries(node).filter(([k]) => k !== '@context')))
const graphLd = { '@context': 'https://schema.org', '@graph': [organizationLd, websiteLd, ...pageNodes] }
---

<!-- Canonical -->
<link rel="canonical" href={canonicalUrl} />

<!-- Hreflang : la darija est servie par cookie (bayen_locale) sur la même URL, sans URL propre ;
     pas de hreflang ar-MA tant qu'elle n'en a pas (Google demande une URL par langue). -->
<link rel="alternate" hreflang="fr-MA" href={canonicalUrl} />
<link rel="alternate" hreflang="x-default" href={canonicalUrl} />

<!-- OpenGraph — WhatsApp, Facebook, Twitter -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="Bayen · باين" />
<meta property="og:locale" content="fr_MA" />
<meta property="og:locale:alternate" content="ar_MA" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Robots -->
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- JSON-LD Schema.org -->
<script type="application/ld+json" set:html={JSON.stringify(graphLd)} />
